// Elya. Copyright (c) 2026 Elvin Elakkattu (https://github.com/Elvineej).
// SPDX-License-Identifier: PolyForm-Strict-1.0.0 (see LICENSE.md)
// The checker in Elya, self-hosting part 4f (plan
// docs/superpowers/plans/2026-11-15-elya-checker-in-elya.md, step 4).
// Oracle: src/types.rs through `elya check --dump` (src/check_dump.rs).
// Stages F1 (first order), F2a (declared types, constructors, `match`, the
// pure builtins) and F2b (higher order, with the effect rows' tails).
import parse / {IO}
import affine / {IO}

// ---- Types, schemes, the state ------------------------------------------

// TB's codes: 0 Int, 1 Float, 2 Bool, 3 String, 4 Unit. TNone marks an
// unbound variable's slot in the substitution. A function type's effect row
// is its labels, sorted by name, each with the span that introduced it, and
// its tail (`EffectRow`); RNone marks an unbound row variable's slot. No
// label has arguments yet (parametric effects are F4b).
type Tail { RClosed, ROpen(Int), RError, RNone }
type Lab { Lab(String, List(Ty), Int, Int) }
type Row { Row(List(Lab), Tail) }
type Ty { TVar(Int), TB(Int), TFn(List(Ty), Row, Ty), TCon(String, List(Ty)), TErr, TNone }
// Quantified type variables, quantified row variables, the type.
type Scheme { Scheme(List(Int), List(Int), Ty) }
type Entry { Entry(String, Scheme) }
// A diagnostic: code, message, span.
type Diag { Diag(String, String, String, Int, Int) }
// A node's type as recorded, at its span (the last record at a span wins).
type Rec { Rec(Int, Int, Ty) }
// A group member: its index, parameter types, ambient row, result type,
// annotation variables.
// A member: its index, parameter types, ambient row, result, annotation
// variables, named rows, and its declared row's written label arguments.
type Mem { Mem(Int, List(Ty), Int, Ty, List(Named), List(Arity), List(Lab)) }
// A top-level function: name, declaration span, parameters, return
// annotation, body, declared row.
type FnInfo { FnInfo(String, Int, Int, List(Sp(Param)), Maybe(Sp(TypeAnn)), Sp(Block), Maybe(RowAnn)) }

// What inference reads beside the substitution: the annotation variables
// of the function being inferred, the declared types' arities, the
// constructors' arities (the last of a name first), the empty types.
type Named { Named(String, Ty) }
type Arity { Arity(String, Int) }
// And the function's named rows (`ann_rows`, each name's row variable) and
// each declared type's parameters' kinds (a row parameter: True).
type KP { KP(String, Bool) }
type Kind { Kind(String, List(KP)) }
type Ctx { Ctx(List(Named), List(Arity), List(Arity), List(String), List(Arity), Kinds) }
// A pending inclusion: the source row variable's effects reach the
// destination's (`pending_incl`, and `pending_member_incl` for a group
// member's row deferred inside a lambda).
// Its span is the call's.
type Incl { Incl(Int, Int, Int, Int) }
// A lambda's row whose closing waits for the group (`deferred_rows`).
type Deferred { Deferred(Int, List(Ty)) }
// The rows' bookkeeping: inclusions, member inclusions, the parameter types
// in scope (`param_tys`), the lambdas' regions, deferred rows, the group's
// parameters and ambient rows. A region is a lambda's or a handle's row,
// and whether a member's row may be deferred inside it (`regions`).
type Region { Region(Int, Bool) }
type Gx { Gx(List(Incl), List(Incl), List(Ty), List(Region), List(Deferred), List(Ty), List(Int)) }
// The row substitution, each row variable's level, the phantom marks.
linear type Rows { Rows(Array(Row), Array(Int), Array(Bool)) }
// The substitution, each variable's level, the current level, the
// diagnostics and the records (both newest first), the context, the rows.
// Equality (`require_data`): the marked type variables with the comparison
// each reaches, the spans already reported, each declared type's
// parameters and constructors' fields.
type EqMark { EqMark(Int, Int, Int) }
type Span2 { Span2(Int, Int) }
type Adt { Adt(String, List(Int), List(List(Ty))) }
type Eqs { Eqs(List(EqMark), List(Span2), List(Adt)) }
// What handlers read (F4a): the enclosing clauses' `resume`s, innermost
// first; the handles' clauses rows still being filled; the lambda depth;
// the effects' operations (the last of a name first); the declared
// effects; the inclusions a conflict ended (`incl_dead`).
type Resume { Resume(Ty, Ty, Int, Int, String, Int, Int) }
// An operation: its name, its effect, its effect's parameters (each type
// variable with its row variable, -1 for a type parameter), its parameters
// and its result.
type OpInfo { OpInfo(String, String, List(RPair), List(Ty), Ty) }
// `with any`: the clauses' rigid answer types made so far, the rows handled
// generically (`generic_rows`), and the sites whose handled rows wait for
// the group (`pending_generic`).
type GSite { GSite(List(Lab), Tail, Bool, Int, Int) }
type Gn { Gn(Int, List(Int), List(GSite)) }
// The affine part (stage F5, spec 2026-11-06-elya-affine-across-functions):
// the affine pass's facts; the duplicable type variables, each with why
// (`dup_vars`); the holds riding on row variables (`row_holds`); each local
// binding by its binder (`binders`); the spans already blamed
// (`dup_reported`); the diagnostics reported apart, after the others (D7);
// the `linear` types.
type DK { KMany, KHeld(Int, Int, String), KAnyOp(String), KLate, KGiven, KElement, KValue }
// Why a type must be duplicable: the binding's name ("" for none), the use
// that requires it, the kind, and the instantiation it came through (-1:
// none).
type Mark { Mark(String, Int, Int, DK, Int, Int) }
type DV { DV(Int, Mark) }
type Hold { Hold(Maybe(Ty), List(Int), Mark) }
type RH { RH(Int, List(Hold)) }
type BD { BD(Int, Int, String, Ty, List(Int)) }
type Af { Af(Facts, List(DV), List(RH), List(BD), List(Int), List(Diag), List(String)) }
type Hx { Hx(List(Resume), List(Int), Int, List(OpInfo), List(String), List(Incl), List(String), Gn, Af) }
linear type St { St(Array(Ty), Array(Int), Int, List(Diag), List(Rec), Ctx, Rows, Gx, Eqs, Hx) }
linear type R(a) { R(a, St) }

fn rev(xs: List(a)) -> List(a) { rev_onto(xs, Nil) }
fn rev_onto(xs: List(a), acc: List(a)) -> List(a) {
  match xs { Nil -> acc  Cons(x, rest) -> rev_onto(rest, Cons(x, acc)) }
}
fn append(xs: List(a), ys: List(a)) -> List(a) { rev_onto(rev(xs), ys) }
fn len(xs: List(a)) -> Int { len_from(xs, 0) }
fn len_from(xs: List(a), n: Int) -> Int {
  match xs { Nil -> n  Cons(_, rest) -> len_from(rest, n + 1) }
}
fn nth_int(xs: List(Int), i: Int) -> Int {
  match xs { Nil -> 0 - 1  Cons(x, rest) -> if i == 0 { x } else { nth_int(rest, i - 1) } }
}
fn has_int(xs: List(Int), v: Int) -> Bool {
  match xs { Nil -> False  Cons(x, rest) -> if x == v { True } else { has_int(rest, v) } }
}
fn nth_fn(xs: List(FnInfo), i: Int) -> FnInfo {
  match xs {
    Cons(x, rest) -> if i == 0 { x } else { nth_fn(rest, i - 1) }
    Nil -> FnInfo("", 0, 0, Nil, No, Sp(Block(Nil, No), 0, 0), No)
  }
}

fn fresh(s: St) -> R(Ty) {
  match s {
    St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> {
      let n = array.length(sub)
      R(TVar(n), St(array.push(sub, TNone), array.push(lv, cur), cur, ds, rs, cx, rw, gx, eq, hx))
    }
  }
}
fn fresh_list(s: St, n: Int, acc: List(Ty)) -> R(List(Ty)) {
  if n == 0 { R(rev(acc), s) } else {
    match fresh(s) { R(t, s2) -> fresh_list(s2, n - 1, Cons(t, acc)) }
  }
}
fn bound(s: St, v: Int) -> R(Ty) {
  match s {
    St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> {
      let t = array.get(sub, v)
      R(t, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx))
    }
  }
}
fn set_var(s: St, v: Int, t: Ty) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(array.set(sub, v, t), lv, cur, ds, rs, cx, rw, gx, eq, hx) }
}
fn level_of(s: St, v: Int) -> R(Int) {
  match s {
    St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> {
      let l = array.get(lv, v)
      R(l, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx))
    }
  }
}
fn set_level(s: St, v: Int, l: Int) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(sub, array.set(lv, v, l), cur, ds, rs, cx, rw, gx, eq, hx) }
}
fn cur_level(s: St) -> R(Int) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(cur, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn add_level(s: St, d: Int) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(sub, lv, cur + d, ds, rs, cx, rw, gx, eq, hx) }
}
fn get_gn(s: St) -> R(Gn) {
  match get_hx(s) { R(Hx(_, _, _, _, _, _, _, gn, af), s2) -> R(gn, s2) }
}
fn set_gn(s: St, gn: Gn) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, _, af), s2) -> set_hx(s2, Hx(rs, cr, d, ops, effs, dead, mu, gn, af)) }
}
fn push_site(s: St, g: GSite) -> St {
  match get_gn(s) { R(Gn(k, gr, pg), s2) -> set_gn(s2, Gn(k, gr, append(pg, Cons(g, Nil)))) }
}
fn diag_count(s: St) -> R(Int) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(len(ds), St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn diag(s: St, code: String, msg: String, start: Int, end: Int) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(sub, lv, cur, Cons(Diag("error", code, msg, start, end), ds), rs, cx, rw, gx, eq, hx) }
}
fn warn(s: St, code: String, msg: String, start: Int, end: Int) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(sub, lv, cur, Cons(Diag("warning", code, msg, start, end), ds), rs, cx, rw, gx, eq, hx) }
}
fn get_cx(s: St) -> R(Ctx) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(cx, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn set_cx(s: St, cx: Ctx) -> St {
  match s { St(sub, lv, cur, ds, rs, _, rw, gx, eq, hx) -> St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) }
}
fn get_gx(s: St) -> R(Gx) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(gx, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn set_gx(s: St, gx: Gx) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, _, eq, hx) -> St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) }
}
fn get_hx(s: St) -> R(Hx) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(hx, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn set_hx(s: St, hx: Hx) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, _) -> St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) }
}
fn record(s: St, start: Int, end: Int, t: Ty) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> St(sub, lv, cur, ds, Cons(Rec(start, end, t), rs), cx, rw, gx, eq, hx) }
}

fn get_eq(s: St) -> R(Eqs) {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(eq, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
}
fn set_eq(s: St, eq: Eqs) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, rw, gx, _, hx) -> St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) }
}

// ---- Equality (`require_data`) ------------------------------------------------

fn mark_of(ms: List(EqMark), v: Int) -> Maybe(Span2) {
  match ms { Nil -> No  Cons(EqMark(u, a, b), rest) -> if u == v { Yes(Span2(a, b)) } else { mark_of(rest, v) } }
}
// A variable keeps the first comparison that reached it.
fn mark(s: St, v: Int, o: Span2) -> St {
  match get_eq(s) {
    R(Eqs(ms, rep, adts), s2) -> match mark_of(ms, v) {
      Yes(_) -> s2
      No -> match o { Span2(a, b) -> set_eq(s2, Eqs(Cons(EqMark(v, a, b), ms), rep, adts)) }
    }
  }
}
fn adt_of(xs: List(Adt), name: String) -> Maybe(Adt) {
  match xs { Nil -> No  Cons(Adt(n, ps, cs), rest) -> if n == name { Yes(Adt(n, ps, cs)) } else { adt_of(rest, name) } }
}
fn has_name(xs: List(String), n: String) -> Bool { has_str(xs, n) }
type Why { Why(Bool, List(String)) }
// `decl_not_data`: a declared type is data when every field of every
// constructor is, its own parameters counting as data; a type met again on
// the way counts as data.
fn decl_not_data(adts: List(Adt), name: String, seen: List(String)) -> Why {
  if has_name(seen, name) { Why(False, seen) } else {
    let seen2 = Cons(name, seen)
    if name == "Buffer" || name == "Array" { Why(True, seen2) } else {
      match adt_of(adts, name) {
        No -> Why(True, seen2)
        Yes(Adt(_, ps, cs)) -> ctors_not_data(adts, cs, ps, seen2)
      }
    }
  }
}
fn ctors_not_data(adts: List(Adt), cs: List(List(Ty)), ps: List(Int), seen: List(String)) -> Why {
  match cs {
    Nil -> Why(False, seen)
    Cons(fs, rest) -> match shapes_not_data(adts, fs, ps, seen) {
      Why(True, seen2) -> Why(True, seen2)
      Why(False, seen2) -> ctors_not_data(adts, rest, ps, seen2)
    }
  }
}
fn shapes_not_data(adts: List(Adt), ts: List(Ty), ps: List(Int), seen: List(String)) -> Why {
  match ts {
    Nil -> Why(False, seen)
    Cons(t, rest) -> match shape_not_data(adts, t, ps, seen) {
      Why(True, seen2) -> Why(True, seen2)
      Why(False, seen2) -> shapes_not_data(adts, rest, ps, seen2)
    }
  }
}
fn shape_not_data(adts: List(Adt), t: Ty, ps: List(Int), seen: List(String)) -> Why {
  match t {
    TFn(_, _, _) -> Why(True, seen)
    TVar(v) -> Why(!has_int(ps, v), seen)
    TCon(n, args) -> match shapes_not_data(adts, args, ps, seen) {
      Why(True, seen2) -> Why(True, seen2)
      Why(False, seen2) -> decl_not_data(adts, n, seen2)
    }
    _ -> Why(False, seen)
  }
}
// ---- Duplicability (stage F5; spec 2026-11-06-elya-affine-across-functions) --

fn linear_names(decls: List(Sp(Decl)), acc: List(String)) -> List(String) {
  match decls {
    Nil -> acc
    Cons(Sp(DType(name, _, True, _), _, _), rest) -> linear_names(rest, Cons(name, acc))
    Cons(_, rest) -> linear_names(rest, acc)
  }
}
fn get_af(s: St) -> R(Af) {
  match get_hx(s) { R(Hx(_, _, _, _, _, _, _, _, af), s2) -> R(af, s2) }
}
fn set_af(s: St, af: Af) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, _), s2) -> set_hx(s2, Hx(rs, cr, d, ops, effs, dead, mu, gn, af)) }
}
// The affine pass keys a span as one Int.
fn skey(a: Int, b: Int) -> Int { a * 1048576 + b }
fn kstart(k: Int) -> Int { k / 1048576 }
fn kend(k: Int) -> Int { k - (k / 1048576) * 1048576 }
fn is_linear_name(s: St, n: String) -> R(Bool) {
  match get_af(s) { R(Af(_, _, _, _, _, _, lin), s2) -> R(has_name(lin, n), s2) }
}
type DD { DD(Maybe(String), List(String)) }
// The `linear` type a declared type's fields hold, its parameters taken as
// duplicable (`decl_not_dup`).
fn decl_not_dup(adts: List(Adt), lin: List(String), name: String, seen: List(String)) -> DD {
  if has_name(seen, name) { DD(No, seen) } else {
    match adt_of(adts, name) {
      No -> DD(No, Cons(name, seen))
      Yes(Adt(_, _, cs)) -> shapes_not_dup(adts, lin, flatten_tys(cs), Cons(name, seen))
    }
  }
}
fn flatten_tys(cs: List(List(Ty))) -> List(Ty) {
  match cs { Nil -> Nil  Cons(fs, rest) -> append(fs, flatten_tys(rest)) }
}
fn shapes_not_dup(adts: List(Adt), lin: List(String), ts: List(Ty), seen: List(String)) -> DD {
  match ts {
    Nil -> DD(No, seen)
    Cons(t, rest) -> match shape_not_dup(adts, lin, t, seen) {
      DD(Yes(n), seen2) -> DD(Yes(n), seen2)
      DD(No, seen2) -> shapes_not_dup(adts, lin, rest, seen2)
    }
  }
}
fn shape_not_dup(adts: List(Adt), lin: List(String), t: Ty, seen: List(String)) -> DD {
  match t {
    TCon(n, args) -> if n == "$Op" { DD(No, seen) } else { if has_name(lin, n) { DD(Yes(n), seen) } else {
      match shapes_not_dup(adts, lin, args, seen) {
        DD(Yes(x), seen2) -> DD(Yes(x), seen2)
        DD(No, seen2) -> decl_not_dup(adts, lin, n, seen2)
      }
    } }
    _ -> DD(No, seen)
  }
}
fn not_dup_decl(s: St, n: String) -> R(Maybe(String)) {
  match get_eq(s) {
    R(Eqs(_, _, adts), s2) -> match get_af(s2) {
      R(Af(_, _, _, _, _, _, lin), s3) -> match decl_not_dup(adts, lin, n, Nil) { DD(r, _) -> R(r, s3) }
    }
  }
}
// Whether `t` is duplicable already, nothing in it to mark (`dup_known`).
fn dup_known(s: St, t: Ty) -> R(Bool) {
  match resolve(s, t) {
    R(rt, s2) -> match rt {
      TVar(_) -> R(False, s2)
      TCon(n, args) -> if n == "$Op" { R(True, s2) } else {
        match is_linear_name(s2, n) {
          R(True, s3) -> R(False, s3)
          R(False, s3) -> match not_dup_decl(s3, n) {
            R(Yes(_), s4) -> R(False, s4)
            R(No, s4) -> dup_known_all(s4, args)
          }
        }
      }
      _ -> R(True, s2)
    }
  }
}
fn dup_known_all(s: St, ts: List(Ty)) -> R(Bool) {
  match ts { Nil -> R(True, s)  Cons(t, rest) -> match dup_known(s, t) { R(True, s2) -> dup_known_all(s2, rest)  R(False, s2) -> R(False, s2) } }
}
// D1 (`require_dup`): `t` must be duplicable: no `linear` type in it, nor
// in its declared types' fields; its variables (but `skip`) marked.
fn require_dup(s: St, t: Ty, m: Mark, skip: List(Int)) -> St {
  match resolve(s, t) {
    R(rt, s2) -> match rt {
      TVar(v) -> if has_int(skip, v) { s2 } else {
        match get_af(s2) {
          R(Af(fa, dv, rh, bd, rep, ad, lin), s3) -> if has_dv(dv, v) { s3 } else { set_af(s3, Af(fa, Cons(DV(v, m), dv), rh, bd, rep, ad, lin)) }
        }
      }
      TCon(n, args) -> if n == "$Op" { s2 } else {
        match is_linear_name(s2, n) {
          R(True, s3) -> dup_violation(s3, m, n)
          R(False, s3) -> match not_dup_decl(s3, n) {
            R(Yes(inner), s4) -> dup_violation(s4, m, inner)
            R(No, s4) -> require_dup_all(s4, args, m, skip)
          }
        }
      }
      _ -> s2
    }
  }
}
fn require_dup_all(s: St, ts: List(Ty), m: Mark, skip: List(Int)) -> St {
  match ts { Nil -> s  Cons(t, rest) -> require_dup_all(require_dup(s, t, m, skip), rest, m, skip) }
}
fn has_dv(dv: List(DV), v: Int) -> Bool {
  match dv { Nil -> False  Cons(DV(u, _), rest) -> u == v || has_dv(rest, v) }
}
fn dv_get(dv: List(DV), v: Int) -> Maybe(Mark) {
  match dv { Nil -> No  Cons(DV(u, m), rest) -> if u == v { Yes(m) } else { dv_get(rest, v) } }
}
fn through(m: Mark, a: Int, b: Int) -> Mark {
  match m { Mark(n, x, y, k, _, _) -> Mark(n, x, y, k, a, b) }
}
// D6 (`dup_violation`): a value holding the `linear` type would be
// duplicated; each use (or instantiation) blamed once.
fn dup_violation(s: St, m: Mark, what: String) -> St {
  match m {
    Mark(name, a, b, k, va, vb) -> {
      let via = va >= 0
      let kk = if via { skey(va, vb) } else { skey(a, b) }
      match get_af(s) {
        R(Af(fa, dv, rh, bd, rep, ad, lin), s2) -> if has_int(rep, kk) { s2 } else {
          let who = if name == "" { "an affine value" } else { "affine value `" <> name <> "`" }
          let d = match k {
            KAnyOp(_) -> Diag("error", "E0437", "an operation taking an affine value cannot be handled by `with any`", a, b)
            KMany -> if via { Diag("error", "E0437", "this would use an affine value more than once", va, vb) } else { Diag("error", "E0428", who <> " used more than once", a, b) }
            KHeld(_, _, _) -> if via { Diag("error", "E0437", "this would keep an affine value across a multi-shot perform", va, vb) } else { Diag("error", "E0429", who <> " may be captured by a multi-shot handler", a, b) }
            KLate -> if via { Diag("error", "E0437", "this would read an affine value after it was given away", va, vb) } else { Diag("error", "E0438", "`" <> name <> "` is read here after it was given away", a, b) }
            KGiven -> if via { Diag("error", "E0437", "this would give away a borrowed value", va, vb) } else { Diag("error", "E0439", "a borrowed value is given away here", a, b) }
            KElement -> Diag("error", "E0437", "an array's elements must not be affine", a, b)
            KValue -> Diag("error", "E0439", "`" <> name <> "` borrows its argument: it must be called by its name", a, b)
          }
          set_af(s2, Af(fa, dv, rh, bd, Cons(kk, rep), Cons(d, ad), lin))
        }
      }
    }
  }
}
// A local binding noted (`note_binder`): its type, read by the points that
// hold it; used many times, read after it was given away, or a `borrow`
// parameter given away, its type must be duplicable (a generalized `let`'s
// quantified variables aside, D8).
fn note_binder(s: St, a: Int, b: Int, name: String, sc: Scheme) -> St {
  match sc {
    Scheme(vars, _, t) -> match get_af(s) {
      R(Af(fa, dv, rh, bd, rep, ad, lin), s2) -> {
        let s3 = set_af(s2, Af(fa, dv, rh, Cons(BD(a, b, name, t, vars), bd), rep, ad, lin))
        let k = skey(a, b)
        match fa {
          Facts(many, _, _, late, given, _) -> {
            let s4 = match me_get(many, k) { Yes(at) -> require_dup(s3, t, Mark(name, kstart(at), kend(at), KMany, 0 - 1, 0 - 1), vars)  No -> s3 }
            let s5 = match le_get(late, k) { Yes(at) -> require_dup(s4, t, Mark(name, kstart(at), kend(at), KLate, 0 - 1, 0 - 1), vars)  No -> s4 }
            match kv_get(given, k) { Yes(at) -> require_dup(s5, t, Mark(name, kstart(at), kend(at), KGiven, 0 - 1, 0 - 1), vars)  No -> s5 }
          }
        }
      }
    }
  }
}
fn me_get(xs: List(ME), k: Int) -> Maybe(Int) {
  match xs { Nil -> No  Cons(ME(x, Many(at, _)), rest) -> if x == k { Yes(at) } else { me_get(rest, k) } }
}
fn le_get(xs: List(LE), k: Int) -> Maybe(Int) {
  match xs { Nil -> No  Cons(LE(x, r, _), rest) -> if x == k { Yes(r) } else { le_get(rest, k) } }
}
fn kv_get(xs: List(KV), k: Int) -> Maybe(Int) {
  match xs { Nil -> No  Cons(KV(x, v), rest) -> if x == k { Yes(v) } else { kv_get(rest, k) } }
}
// A function with a `borrow` parameter used as a value (D5): what it
// borrows must be duplicable.
fn borrow_value(s: St, a: Int, b: Int, t: Ty) -> St {
  match get_af(s) {
    R(Af(Facts(_, _, _, _, _, bvs), _, _, _, _, _, _), s2) -> match bv_get(bvs, skey(a, b)) {
      No -> s2
      Yes(BV(_, f, modes)) -> match resolve(s2, t) {
        R(TFn(ps, _, _), s3) -> borrowed_dup(s3, ps, modes, Mark(f, a, b, KValue, 0 - 1, 0 - 1))
        R(_, s3) -> s3
      }
    }
  }
}
fn bv_get(xs: List(BV), k: Int) -> Maybe(BV) {
  match xs { Nil -> No  Cons(BV(x, n, m), rest) -> if x == k { Yes(BV(x, n, m)) } else { bv_get(rest, k) } }
}
fn borrowed_dup(s: St, ps: List(Ty), modes: List(Bool), m: Mark) -> St {
  match ps {
    Nil -> s
    Cons(p, pr) -> match modes { Nil -> s  Cons(md, mr) -> borrowed_dup(if md { require_dup(s, p, m, Nil) } else { s }, pr, mr, m) }
  }
}
// The `multi` effect a row has, the first by name.
fn multi_label(s: St, ls: List(Lab)) -> R(String) {
  match ls {
    Nil -> R("", s)
    Cons(Lab(n, _, _, _), rest) -> match is_multi(s, n) { R(True, s2) -> R(n, s2)  R(False, s2) -> multi_label(s2, rest) }
  }
}
// D3 (`hold_point`): what a point holds must be duplicable when its row has a
// `multi` effect, or when its tail variable takes one.
fn hold_point(s: St, a: Int, b: Int, row: Row) -> St {
  match get_af(s) {
    R(Af(Facts(_, held, _, _, _, _), _, _, _, _, _, _), s2) -> match lp_get(held, skey(a, b)) {
      No -> s2
      Yes(es) -> match resolve_row(s2, row) {
        R(Row(ls, t), s3) -> match multi_label(s3, ls) {
          R(mlabel, s4) -> {
            let tail = match t { ROpen(w) -> w  _ -> 0 - 1 }
            if mlabel == "" && tail < 0 { s4 } else { held_entries(s4, es, a, b, mlabel, tail) }
          }
        }
      }
    }
  }
}
fn lp_get(xs: List(LP), k: Int) -> Maybe(List(KV)) {
  match xs { Nil -> No  Cons(LP(x, es), rest) -> if x == k { Yes(es) } else { lp_get(rest, k) } }
}
fn held_entries(s: St, es: List(KV), a: Int, b: Int, mlabel: String, tail: Int) -> St {
  match es {
    Nil -> s
    Cons(KV(bk, u), rest) -> match held_binding(s, bk) {
      R(No, s2) -> held_entries(s2, rest, a, b, mlabel, tail)
      R(Yes(BD(_, _, name, ty, skip)), s2) -> match dup_known(s2, ty) {
        R(True, s3) -> held_entries(s3, rest, a, b, mlabel, tail)
        R(False, s3) -> {
          let m = Mark(name, kstart(u), kend(u), KHeld(a, b, mlabel), 0 - 1, 0 - 1)
          let s4 = if mlabel != "" { require_dup(s3, ty, m, skip) } else { add_hold(s3, tail, Hold(Yes(ty), skip, m)) }
          held_entries(s4, rest, a, b, mlabel, tail)
        }
      }
    }
  }
}
// A binding, or a value already computed for a call a later argument's
// point re-runs: an expression's type.
fn held_binding(s: St, k: Int) -> R(Maybe(BD)) {
  match get_af(s) {
    R(Af(_, _, _, bd, _, _, _), s2) -> match bd_get(bd, k) {
      Yes(x) -> R(Yes(x), s2)
      No -> match s2 { St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx) -> R(match rec_get(rs, kstart(k), kend(k)) { Yes(t) -> Yes(BD(0, 0, "", t, Nil))  No -> No }, St(sub, lv, cur, ds, rs, cx, rw, gx, eq, hx)) }
    }
  }
}
fn bd_get(xs: List(BD), k: Int) -> Maybe(BD) {
  match xs { Nil -> No  Cons(BD(a, b, n, t, sk), rest) -> if skey(a, b) == k { Yes(BD(a, b, n, t, sk)) } else { bd_get(rest, k) } }
}
fn rec_get(rs: List(Rec), a: Int, b: Int) -> Maybe(Ty) {
  match rs { Nil -> No  Cons(Rec(x, y, t), rest) -> if x == a && y == b { Yes(t) } else { rec_get(rest, a, b) } }
}
fn add_hold(s: St, w: Int, h: Hold) -> St { add_holds(s, w, Cons(h, Nil)) }
fn add_holds(s: St, w: Int, hs: List(Hold)) -> St {
  match get_af(s) {
    R(Af(fa, dv, rh, bd, rep, ad, lin), s2) -> set_af(s2, Af(fa, dv, rh_add(rh, w, hs), bd, rep, ad, lin))
  }
}
fn rh_add(rh: List(RH), w: Int, hs: List(Hold)) -> List(RH) {
  match rh { Nil -> Cons(RH(w, hs), Nil)  Cons(RH(v, xs), rest) -> if v == w { Cons(RH(v, append(xs, hs)), rest) } else { Cons(RH(v, xs), rh_add(rest, w, hs)) } }
}
fn rh_get(rh: List(RH), w: Int) -> Maybe(List(Hold)) {
  match rh { Nil -> No  Cons(RH(v, xs), rest) -> if v == w { Yes(xs) } else { rh_get(rest, w) } }
}
fn rh_remove(rh: List(RH), w: Int) -> List(RH) {
  match rh { Nil -> Nil  Cons(RH(v, xs), rest) -> if v == w { rest } else { Cons(RH(v, xs), rh_remove(rest, w)) } }
}
// A `handle` and the `resume`s in its clauses: points whose rows are what
// escapes it (`hold_handle`).
fn hold_handle(s: St, a: Int, b: Int, rows: List(Row)) -> St {
  match get_af(s) {
    R(Af(Facts(_, _, res, _, _, _), _, _, _, _, _, _), s2) -> {
      let rs = match lp_get(res, skey(a, b)) { Yes(xs) -> xs  No -> Nil }
      hold_rows(s2, a, b, rows, rs)
    }
  }
}
fn hold_rows(s: St, a: Int, b: Int, rows: List(Row), rs: List(KV)) -> St {
  match rows {
    Nil -> s
    Cons(r, rest) -> hold_rows(hold_resumes(hold_point(s, a, b, r), rs, r), a, b, rest, rs)
  }
}
fn hold_resumes(s: St, rs: List(KV), r: Row) -> St {
  match rs { Nil -> s  Cons(KV(k, _), rest) -> hold_resumes(hold_point(s, kstart(k), kend(k), r), rest, r) }
}
// A row variable holding `hs` was bound to `row` (`apply_holds`).
fn apply_holds(s: St, hs: List(Hold), row: Row) -> St {
  match resolve_row(s, row) {
    R(Row(ls, t), s2) -> match multi_label(s2, ls) {
      R(mlabel, s3) -> match apply_each(s3, hs, Row(ls, t), mlabel, Nil) {
        R(rest, s4) -> match t {
          ROpen(w) -> match rest { Nil -> s4  _ -> add_holds(s4, w, rest) }
          _ -> s4
        }
      }
    }
  }
}
fn apply_each(s: St, hs: List(Hold), row: Row, mlabel: String, acc: List(Hold)) -> R(List(Hold)) {
  match hs {
    Nil -> R(rev(acc), s)
    Cons(Hold(No, sk, m), rest) -> apply_each(require_dup_ops(s, row, m), rest, row, mlabel, Cons(Hold(No, sk, m), acc))
    Cons(Hold(Yes(t), sk, m), rest) -> if mlabel == "" { apply_each(s, rest, row, mlabel, Cons(Hold(Yes(t), sk, m), acc)) } else {
      let m2 = match m { Mark(n, x, y, KHeld(pa, pb, _), va, vb) -> Mark(n, x, y, KHeld(pa, pb, mlabel), va, vb)  _ -> m }
      apply_each(require_dup(s, t, m2, sk), rest, row, mlabel, acc)
    }
  }
}
// D5 (`require_dup_ops`): every operation of each label but `IO`'s takes
// duplicable arguments (`op.perform` performs it again).
fn require_dup_ops(s: St, row: Row, m: Mark) -> St {
  match row {
    Row(ls, _) -> dup_ops_labs(s, ls, m)
  }
}
fn dup_ops_labs(s: St, ls: List(Lab), m: Mark) -> St {
  match ls {
    Nil -> s
    Cons(Lab(n, args, _, _), rest) -> if n == "IO" { dup_ops_labs(s, rest, m) } else {
      match get_hx(s) {
        R(Hx(_, _, _, ops, _, _, _, _, _), s2) -> dup_ops_labs(dup_ops(s2, sort_ops(ops_of(ops, n)), n, args, m), rest, m)
      }
    }
  }
}
fn dup_ops(s: St, ops: List(OpInfo), eff: String, args: List(Ty), m: Mark) -> St {
  match ops {
    Nil -> s
    Cons(OpInfo(name, _, all, ps, _), rest) -> {
      let em = zip_params(all, args)
      let m2 = match m { Mark(n, a, b, _, va, vb) -> Mark(n, a, b, KAnyOp(eff <> "." <> name), va, vb) }
      dup_ops(require_dup_all(s, subst_list(ps, em, Nil, Nil), m2, Nil), rest, eff, args, m)
    }
  }
}
// D5 at a `with any` handle: the row it handles, now and as its tail fills.
fn hold_any_ops(s: St, a: Int, b: Int, handled: Row) -> St {
  match resolve_row(s, handled) {
    R(Row(ls, t), s2) -> {
      let m = Mark("", a, b, KAnyOp(""), 0 - 1, 0 - 1)
      let s3 = require_dup_ops(s2, Row(ls, t), m)
      match t { ROpen(w) -> add_hold(s3, w, Hold(No, Nil, m))  _ -> s3 }
    }
  }
}
// `eq_not_data`: a variable is marked, not refused; every argument of a
// declared type is looked at (each marks its variables).
fn eq_not_data(s: St, t: Ty, o: Span2) -> R(Bool) {
  match resolve(s, t) { R(rt, s2) -> eq_resolved(s2, rt, o) }
}
fn eq_resolved(s: St, t: Ty, o: Span2) -> R(Bool) {
  match t {
    TVar(v) -> R(False, mark(s, v, o))
    TFn(_, _, _) -> R(True, s)
    // An operation caught by `with any` is data; its answer type is an
    // index, not a field.
    TCon("$Op", _) -> R(False, s)
    TCon(n, args) -> if n == "Buffer" || n == "Array" { R(True, s) } else {
      match eq_args(s, args, o, False) {
        R(any, s2) -> if any { R(True, s2) } else {
          match get_eq(s2) { R(Eqs(ms, rep, adts), s3) -> match decl_not_data(adts, n, Nil) { Why(b, _) -> R(b, s3) } }
        }
      }
    }
    _ -> R(False, s)
  }
}
fn eq_args(s: St, ts: List(Ty), o: Span2, any: Bool) -> R(Bool) {
  match ts {
    Nil -> R(any, s)
    Cons(t, rest) -> match eq_resolved(s, t, o) { R(b, s2) -> eq_args(s2, rest, o, any || b) }
  }
}
fn reported(xs: List(Span2), a: Int, b: Int) -> Bool {
  match xs { Nil -> False  Cons(Span2(x, y), rest) -> if x == a && y == b { True } else { reported(rest, a, b) } }
}
// Once per span.
fn require_data(s: St, t: Ty, start: Int, end: Int, o: Span2) -> St {
  match eq_not_data(s, t, o) {
    R(bad, s2) -> if !bad { s2 } else {
      match get_eq(s2) {
        R(Eqs(ms, rep, adts), s3) -> if reported(rep, start, end) { s3 } else {
          diag(set_eq(s3, Eqs(ms, Cons(Span2(start, end), rep), adts)), "E0436", "only data can be compared with `==` or `!=`", start, end)
        }
      }
    }
  }
}

// ---- Row variables -----------------------------------------------------------

fn ropen(v: Int) -> Row { Row(Nil, ROpen(v)) }
fn pure_row() -> Row { Row(Nil, RClosed) }
fn fresh_row_marked(s: St, phantom: Bool) -> R(Int) {
  match s {
    St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> {
      let n = array.length(rsub)
      R(n, St(sub, lv, cur, ds, rs, cx, Rows(array.push(rsub, Row(Nil, RNone)), array.push(rlv, cur), array.push(ph, phantom)), gx, eq, hx))
    }
  }
}
fn fresh_row(s: St) -> R(Int) { fresh_row_marked(s, False) }
// A phantom row: an upcast tail that means nothing yet (`fresh_phantom_row`).
fn fresh_phantom(s: St) -> R(Int) { fresh_row_marked(s, True) }
fn row_bound(s: St, v: Int) -> R(Row) {
  match s {
    St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> {
      let t = array.get(rsub, v)
      R(t, St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx))
    }
  }
}
fn set_row(s: St, v: Int, t: Row) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> St(sub, lv, cur, ds, rs, cx, Rows(array.set(rsub, v, t), rlv, ph), gx, eq, hx) }
}
fn row_level(s: St, v: Int) -> R(Int) {
  match s {
    St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> {
      let l = array.get(rlv, v)
      R(l, St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx))
    }
  }
}
fn set_row_level(s: St, v: Int, l: Int) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> St(sub, lv, cur, ds, rs, cx, Rows(rsub, array.set(rlv, v, l), ph), gx, eq, hx) }
}
fn is_phantom(s: St, v: Int) -> R(Bool) {
  match s {
    St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> {
      let p = array.get(ph, v)
      R(p, St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx))
    }
  }
}
fn set_phantom(s: St, v: Int, p: Bool) -> St {
  match s { St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, array.set(ph, v, p)), gx, eq, hx) }
}
fn row_count(s: St) -> R(Int) {
  match s {
    St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx) -> {
      let n = array.length(rsub)
      R(n, St(sub, lv, cur, ds, rs, cx, Rows(rsub, rlv, ph), gx, eq, hx))
    }
  }
}

// Labels are kept sorted by name (a `BTreeMap`): `keep_lab` leaves a label
// already there (the first along a chain is kept), `put_lab` replaces it
// (a written row's last).
fn lab_name(l: Lab) -> String { match l { Lab(n, _, _, _) -> n } }
fn has_lab(xs: List(Lab), n: String) -> Bool {
  match xs { Nil -> False  Cons(Lab(m, _, _, _), rest) -> m == n || has_lab(rest, n) }
}
fn keep_lab(xs: List(Lab), l: Lab) -> List(Lab) {
  match xs {
    Nil -> Cons(l, Nil)
    Cons(x, rest) -> if lab_name(x) == lab_name(l) { xs } else {
      if str_lt(lab_name(l), lab_name(x), 0) { Cons(l, xs) } else { Cons(x, keep_lab(rest, l)) }
    }
  }
}
fn put_lab(xs: List(Lab), l: Lab) -> List(Lab) {
  match xs {
    Nil -> Cons(l, Nil)
    Cons(x, rest) -> if lab_name(x) == lab_name(l) { Cons(l, rest) } else {
      if str_lt(lab_name(l), lab_name(x), 0) { Cons(l, xs) } else { Cons(x, put_lab(rest, l)) }
    }
  }
}
fn keep_labs(xs: List(Lab), more: List(Lab)) -> List(Lab) {
  match more { Nil -> xs  Cons(l, rest) -> keep_labs(keep_lab(xs, l), rest) }
}
// `xs`'s labels absent from `ys`, in order.
fn labs_minus(xs: List(Lab), ys: List(Lab)) -> List(Lab) {
  match xs {
    Nil -> Nil
    Cons(l, rest) -> if has_lab(ys, lab_name(l)) { labs_minus(rest, ys) } else { Cons(l, labs_minus(rest, ys)) }
  }
}
// A row with its bound tails followed, the first label of each effect
// along the chain kept (`resolve_row`).
fn resolve_row(s: St, r: Row) -> R(Row) {
  match r {
    Row(labs, t) -> match follow_row(s, labs, t) {
      R(Row(ls, t2), s2) -> match resolve_labs(s2, ls, Nil) { R(ls2, s3) -> R(Row(ls2, t2), s3) }
    }
  }
}
// Each label's arguments resolved (they are types).
fn resolve_labs(s: St, ls: List(Lab), acc: List(Lab)) -> R(List(Lab)) {
  match ls {
    Nil -> R(rev(acc), s)
    Cons(Lab(n, Nil, a, b), rest) -> resolve_labs(s, rest, Cons(Lab(n, Nil, a, b), acc))
    Cons(Lab(n, args, a, b), rest) -> match resolve_list(s, args, Nil) { R(args2, s2) -> resolve_labs(s2, rest, Cons(Lab(n, args2, a, b), acc)) }
  }
}
fn follow_row(s: St, labs: List(Lab), t: Tail) -> R(Row) {
  match t {
    ROpen(v) -> match row_bound(s, v) {
      R(Row(bl, bt), s2) -> match bt { RNone -> R(Row(labs, t), s2)  _ -> follow_row(s2, keep_labs(labs, bl), bt) }
    }
    _ -> R(Row(labs, t), s)
  }
}
// A tail as it stands now (`tail_now`).
fn rhead(s: St, t: Tail) -> R(Tail) {
  match resolve_row(s, Row(Nil, t)) { R(Row(_, t2), s2) -> R(t2, s2) }
}
fn tail_eq(a: Tail, b: Tail) -> Bool {
  match a {
    RClosed -> match b { RClosed -> True  _ -> False }
    ROpen(x) -> match b { ROpen(y) -> x == y  _ -> False }
    RError -> match b { RError -> True  _ -> False }
    RNone -> match b { RNone -> True  _ -> False }
  }
}
fn lower_row(s: St, w: Int, lvl: Int) -> St {
  match row_level(s, w) { R(l, s2) -> if l > lvl { set_row_level(s2, w, lvl) } else { s2 } }
}
// `bind_row`: a bound variable unifies instead; a row ending in `v` is
// cyclic (E0424, the row poisoned); a meaningful variable bound to
// `{.. | w}` hands its meaning to `w`; levels drop as `bind`'s do.
fn bind_row(s: St, v: Int, r: Row, start: Int, end: Int) -> St {
  match row_bound(s, v) {
    R(Row(_, bt), s1) -> match bt {
      RNone -> match resolve_row(s1, r) {
        R(Row(rl, rt), s2) -> if tail_eq(rt, ROpen(v)) || mentions_labs(v, rl) {
          drop_holds(set_row(diag(s2, "E0424", "cyclic effect row", start, end), v, Row(Nil, RError)), v)
        } else {
          match is_phantom(s2, v) {
            R(pv, s3) -> {
              let s4 = match rt { ROpen(w) -> if pv { s3 } else { set_phantom(s3, w, False) }  _ -> s3 }
              match row_level(s4, v) {
                R(lvl, s5) -> {
                  let s6 = match rt { ROpen(w) -> lower_row(s5, w, lvl)  _ -> s5 }
                  // What rode on `v` rides on what it is bound to (D3).
                  match take_holds(s6, v) {
                    R(No, s7) -> set_row(lower_labs(s7, rl, lvl), v, Row(rl, rt))
                    R(Yes(hs), s7) -> apply_holds(set_row(lower_labs(s7, rl, lvl), v, Row(rl, rt)), hs, Row(rl, rt))
                  }
                }
              }
            }
          }
        }
      }
      _ -> surface(unify_row(s1, ropen(v), r, start, end))
    }
  }
}
// What a row reconciliation could not absorb: the first row's labels the
// second (closed) cannot take, then the second's (`RowConflict`); empty
// when the rows were reconciled. `Ab` is one side's residual tail and
// what it could not take.
type Ab { Ab(Tail, List(Lab)) }
// `unify_row`: labels on one side only are absorbed by the other's tail,
// then the residual tails are unified. Diagnostic-free but for E0424.
fn unify_row(s: St, g1: Row, g2: Row, start: Int, end: Int) -> R(List(Lab)) {
  shared_args(settle(settle(s, g1, start, end), g2, start, end), g1, g2, Nil, start, end)
}
// A label on both sides must agree on its arguments; unifying them can bind
// either row's tail, so both rows are read again until no label is newly
// shared. Then each side's labels the other lacks are absorbed by the
// other's tail, and the residual tails unified.
fn shared_args(s: St, g1: Row, g2: Row, done: List(String), start: Int, end: Int) -> R(List(Lab)) {
  match resolve_row(s, g1) {
    R(Row(l1, t1), s1) -> match resolve_row(s1, g2) {
      R(Row(l2, t2), s2) -> if tail_eq(t1, RError) || tail_eq(t2, RError) { R(Nil, s2) } else {
        match shared_labs(l1, l2, done) {
          Nil -> unify_rest(s2, l1, t1, l2, t2, start, end)
          pairs -> shared_args(unify_pairs_args(s2, pairs, start, end), g1, g2, append(done, pair_names(pairs)), start, end)
        }
      }
    }
  }
}
type LabPair { LabPair(String, List(Ty), List(Ty)) }
fn shared_labs(l1: List(Lab), l2: List(Lab), done: List(String)) -> List(LabPair) {
  match l1 {
    Nil -> Nil
    Cons(Lab(n, a1, _, _), rest) -> if has_str(done, n) { shared_labs(rest, l2, done) } else {
      match lab_get(l2, n) {
        Yes(Lab(_, a2, _, _)) -> Cons(LabPair(n, a1, a2), shared_labs(rest, l2, done))
        No -> shared_labs(rest, l2, done)
      }
    }
  }
}
fn pair_names(ps: List(LabPair)) -> List(String) {
  match ps { Nil -> Nil  Cons(LabPair(n, _, _), rest) -> Cons(n, pair_names(rest)) }
}
fn unify_pairs_args(s: St, ps: List(LabPair), start: Int, end: Int) -> St {
  match ps {
    Nil -> s
    Cons(LabPair(n, a1, a2), rest) -> unify_pairs_args(unify_effect_args(s, n, a1, a2, start, end), rest, start, end)
  }
}
fn unify_rest(s2: St, l1: List(Lab), t1: Tail, l2: List(Lab), t2: Tail, start: Int, end: Int) -> R(List(Lab)) {
  match absorb(s2, labs_minus(l1, l2), t2, start, end) {
    R(Ab(n2, c1), s3) -> match rhead(s3, t1) {
      R(t1n, s4) -> match absorb(s4, labs_minus(l2, l1), t1n, start, end) {
        R(Ab(n1, c2), s5) -> match append(c1, c2) {
          Nil -> match rhead(s5, n2) { R(n2b, s6) -> R(Nil, unify_tails(s6, n1, n2b, start, end)) }
          c -> R(c, s5)
        }
      }
    }
  }
}
// `unify_effect_args`: two arguments that cannot be one type (different
// heads, or two ground types that differ) are E0423; others are unified.
fn unify_effect_args(s: St, eff: String, a1: List(Ty), a2: List(Ty), start: Int, end: Int) -> St {
  match a1 {
    Nil -> s
    Cons(x, xr) -> match a2 {
      Nil -> s
      Cons(y, yr) -> match resolve(s, x) {
        R(rx, s2) -> match resolve(s2, y) {
          R(ry, s3) -> {
            let both = concrete(rx) && concrete(ry)
            let conflict = !head_eq(rx, ry) || (ground(rx) && ground(ry))
            if both && !ty_eq(rx, ry) && conflict {
              diag(s3, "E0423", "effect row mismatch", start, end)
            } else { unify_effect_args(unify(s3, x, y, start, end), eff, xr, yr, start, end) }
          }
        }
      }
    }
  }
}
fn concrete(t: Ty) -> Bool { match t { TVar(_) -> False  TErr -> False  _ -> True } }
// A resolved type's head: its constructor and arity.
fn head_eq(a: Ty, b: Ty) -> Bool {
  match a {
    TVar(_) -> match b { TVar(_) -> True  _ -> False }
    TB(x) -> match b { TB(y) -> x == y  _ -> False }
    TFn(p, _, _) -> match b { TFn(q, _, _) -> len(p) == len(q)  _ -> False }
    TCon(n, xs) -> match b { TCon(m, ys) -> n == m && len(xs) == len(ys)  _ -> False }
    TErr -> match b { TErr -> True  _ -> False }
    TNone -> match b { TNone -> True  _ -> False }
  }
}
fn ground(t: Ty) -> Bool {
  match t {
    TVar(_) -> False  TErr -> False  TB(_) -> True
    TFn(ps, Row(ls, tl), r) -> tail_eq(tl, RClosed) && ground_labs(ls) && ground_list(ps) && ground(r)
    TCon(_, xs) -> ground_list(xs)
    TNone -> False
  }
}
fn ground_list(xs: List(Ty)) -> Bool { match xs { Nil -> True  Cons(x, rest) -> ground(x) && ground_list(rest) } }
fn ground_labs(ls: List(Lab)) -> Bool { match ls { Nil -> True  Cons(Lab(_, a, _, _), rest) -> ground_list(a) && ground_labs(rest) } }
// Structural equality of resolved types, a label's span included (Rust's
// derived `PartialEq`).
fn ty_eq(a: Ty, b: Ty) -> Bool {
  match a {
    TVar(x) -> match b { TVar(y) -> x == y  _ -> False }
    TB(x) -> match b { TB(y) -> x == y  _ -> False }
    TFn(p, w, r) -> match b { TFn(q, v, u) -> ty_list_eq(p, q) && row_eq(w, v) && ty_eq(r, u)  _ -> False }
    TCon(n, xs) -> match b { TCon(m, ys) -> n == m && ty_list_eq(xs, ys)  _ -> False }
    TErr -> match b { TErr -> True  _ -> False }
    TNone -> match b { TNone -> True  _ -> False }
  }
}
fn ty_list_eq(xs: List(Ty), ys: List(Ty)) -> Bool {
  match xs {
    Nil -> match ys { Nil -> True  _ -> False }
    Cons(x, xr) -> match ys { Nil -> False  Cons(y, yr) -> ty_eq(x, y) && ty_list_eq(xr, yr) }
  }
}
fn row_eq(a: Row, b: Row) -> Bool {
  match a { Row(la, ta) -> match b { Row(lb, tb) -> tail_eq(ta, tb) && labs_eq(la, lb) } }
}
fn labs_eq(xs: List(Lab), ys: List(Lab)) -> Bool {
  match xs {
    Nil -> match ys { Nil -> True  _ -> False }
    Cons(Lab(n, a, s1, e1), xr) -> match ys {
      Nil -> False
      Cons(Lab(m, b, s2, e2), yr) -> n == m && s1 == s2 && e1 == e2 && ty_list_eq(a, b) && labs_eq(xr, yr)
    }
  }
}
// `settle_duplicates`: one effect met twice along a row's chain (`resolve_row`
// keeps the first) has its arguments unified here, where rows meet.
fn settle(s: St, r: Row, start: Int, end: Int) -> St {
  match r {
    Row(ls, t) -> match settle_walk(s, t, seen_of(ls), Nil, Nil) {
      R(Walk(pairs, chain, tail), s2) -> {
        let s3 = unify_pairs_args(s2, rev(pairs), start, end)
        // Each variable of the chain bound straight to what it resolves to
        // (path compression): its duplicates are settled, so keeping the
        // first of each drops nothing, and no later read meets them again.
        if len(chain) > 1 { compress(s3, chain, Nil, tail) } else { s3 }
      }
    }
  }
}
// The chain's variables, the last first: each bound to its own labels and
// those after it, over the chain's end.
fn compress(s: St, chain: List(Int), suffix: List(Lab), tail: Tail) -> St {
  match chain {
    Nil -> s
    Cons(v, rest) -> match row_bound(s, v) {
      R(Row(bl, _), s2) -> {
        let merged = keep_labs(bl, suffix)
        compress(set_row(s2, v, Row(merged, tail)), rest, merged, tail)
      }
    }
  }
}
type Walk { Walk(List(LabPair), List(Int), Tail) }
fn seen_of(ls: List(Lab)) -> List(LabPair) {
  match ls { Nil -> Nil  Cons(Lab(n, a, _, _), rest) -> Cons(LabPair(n, a, Nil), seen_of(rest)) }
}
fn seen_get(xs: List(LabPair), n: String) -> Maybe(List(Ty)) {
  match xs { Nil -> No  Cons(LabPair(m, a, _), rest) -> if m == n { Yes(a) } else { seen_get(rest, n) } }
}
fn settle_walk(s: St, t: Tail, seen: List(LabPair), pairs: List(LabPair), chain: List(Int)) -> R(Walk) {
  match t {
    ROpen(v) -> match row_bound(s, v) {
      R(Row(bl, bt), s2) -> match bt {
        RNone -> R(Walk(pairs, chain, t), s2)
        _ -> match settle_labs(s2, bl, seen, pairs) {
          R(SeenPairs(seen2, pairs2), s3) -> settle_walk(s3, bt, seen2, pairs2, Cons(v, chain))
        }
      }
    }
    _ -> R(Walk(pairs, chain, t), s)
  }
}
type SeenPairs { SeenPairs(List(LabPair), List(LabPair)) }
fn settle_labs(s: St, bl: List(Lab), seen: List(LabPair), pairs: List(LabPair)) -> R(SeenPairs) {
  match bl {
    Nil -> R(SeenPairs(seen, pairs), s)
    Cons(Lab(k, args, _, _), rest) -> match seen_get(seen, k) {
      Yes(first) -> match differ(s, first, args) {
        R(d, s2) -> settle_labs(s2, rest, seen, if d { Cons(LabPair(k, first, args), pairs) } else { pairs })
      }
      No -> settle_labs(s, rest, Cons(LabPair(k, args, Nil), seen), pairs)
    }
  }
}
// Same arity and some argument resolving differently.
fn differ(s: St, a: List(Ty), b: List(Ty)) -> R(Bool) {
  if len(a) != len(b) { R(False, s) } else { differ_any(s, a, b) }
}
fn differ_any(s: St, a: List(Ty), b: List(Ty)) -> R(Bool) {
  match a {
    Nil -> R(False, s)
    Cons(x, xr) -> match b {
      Nil -> R(False, s)
      Cons(y, yr) -> match resolve(s, x) {
        R(rx, s2) -> match resolve(s2, y) { R(ry, s3) -> if ty_eq(rx, ry) { differ_any(s3, xr, yr) } else { R(True, s3) } }
      }
    }
  }
}
// Whether row variable `v` is in `t`: a tail, or inside a label's arguments
// (`mentions_row`).
fn mentions_row(s: St, v: Int, t: Ty) -> R(Bool) {
  match resolve(s, t) { R(rt, s2) -> R(mentions(v, rt), s2) }
}
fn mentions(v: Int, t: Ty) -> Bool {
  match t {
    TFn(ps, Row(ls, tl), r) -> tail_eq(tl, ROpen(v)) || mentions_labs(v, ls) || mentions_list(v, ps) || mentions(v, r)
    TCon(_, xs) -> mentions_list(v, xs)
    _ -> False
  }
}
fn mentions_list(v: Int, xs: List(Ty)) -> Bool { match xs { Nil -> False  Cons(x, rest) -> mentions(v, x) || mentions_list(v, rest) } }
fn mentions_labs(v: Int, ls: List(Lab)) -> Bool { match ls { Nil -> False  Cons(Lab(_, a, _, _), rest) -> mentions_list(v, a) || mentions_labs(v, rest) } }
// `absorb`: an open tail grows by `v := {extra} | fresh`, the fresh tail
// phantom if `v` was; a closed one cannot.
fn absorb(s: St, extra: List(Lab), t: Tail, start: Int, end: Int) -> R(Ab) {
  match extra {
    Nil -> R(Ab(t, Nil), s)
    _ -> match t {
      ROpen(v) -> match fresh_row(s) {
        R(f, s1) -> match is_phantom(s1, v) {
          R(p, s2) -> {
            let s3 = if p { set_phantom(s2, f, True) } else { s2 }
            R(Ab(ROpen(f), Nil), bind_row(s3, v, Row(extra, ROpen(f)), start, end))
          }
        }
      }
      RClosed -> R(Ab(t, extra), s)
      _ -> R(Ab(t, Nil), s)
    }
  }
}
// Two residual tails (`unify_tails`): the younger variable bound to the
// older.
fn unify_tails(s: St, a: Tail, b: Tail, start: Int, end: Int) -> St {
  match rhead(s, a) {
    R(x, s1) -> match rhead(s1, b) {
      R(y, s2) -> match x {
        RError -> s2
        ROpen(p) -> match y {
          RError -> s2
          ROpen(q) -> if p == q { s2 } else { if p > q { bind_row(s2, p, ropen(q), start, end) } else { bind_row(s2, q, ropen(p), start, end) } }
          _ -> bind_row(s2, p, pure_row(), start, end)
        }
        _ -> match y {
          ROpen(q) -> bind_row(s2, q, pure_row(), start, end)
          _ -> s2
        }
      }
    }
  }
}
// A conflict on the way into an ambient row (`surface_conflict`): E0423
// at the first differing label.
fn surface(r: R(List(Lab))) -> St {
  match r {
    R(c, s) -> match c {
      Nil -> s
      Cons(Lab(_, _, a, b), _) -> diag(s, "E0423", "effect row mismatch", a, b)
    }
  }
}
// `op ∈ amb` (`add_effect`): the ambient against `{op} | fresh`.
fn add_effect(s: St, amb: Int, name: String, start: Int, end: Int) -> R(List(Lab)) { add_effect_args(s, amb, name, Nil, start, end) }
fn add_effect_args(s: St, amb: Int, name: String, args: List(Ty), start: Int, end: Int) -> R(List(Lab)) {
  match fresh_row(s) {
    R(f, s2) -> unify_row(s2, ropen(amb), Row(Cons(Lab(name, args, start, end), Nil), ROpen(f)), start, end)
  }
}
// The levels inside a resolved row's labels' arguments (`lower_row_walk`).
fn lower_labs(s: St, ls: List(Lab), lvl: Int) -> St {
  match ls {
    Nil -> s
    Cons(Lab(_, Nil, _, _), rest) -> lower_labs(s, rest, lvl)
    Cons(Lab(_, args, _, _), rest) -> {
      let t = TCon("", args)
      lower_labs(lower_rows(lower_vars(s, rev(free_vars(t, Nil)), lvl), rev(free_rows(t, Nil)), lvl), rest, lvl)
    }
  }
}
// `amb ⊇ eff` (`add_row`): each label at its own span, stopping at the
// first conflict, then the tail relayed.
// A label whose arguments mention the row's own tail (`{Async(e) | e}`)
// cannot be inside that tail: such a row is unified whole, with the
// ambient's own such labels.
fn add_row(s: St, amb: Int, eff: Row, start: Int, end: Int) -> R(List(Lab)) {
  match resolve_row(settle(s, eff, start, end), eff) {
    R(Row(ls, t), s1) -> match t {
      ROpen(rho) -> match resolve_row(s1, ropen(amb)) {
        R(Row(al, _), s1b) -> {
          let own = mentions_labs(rho, ls)
          let theirs = theirs_labs(al, ls, rho)
          match theirs {
            Nil -> if own { unify_row(s1b, ropen(amb), Row(ls, t), start, end) } else { add_row_labs(s1b, amb, ls, t, start, end) }
            _ -> unify_row(s1b, ropen(amb), Row(keep_labs(ls, theirs), t), start, end)
          }
        }
      }
      _ -> add_row_labs(s1, amb, ls, t, start, end)
    }
  }
}
fn theirs_labs(al: List(Lab), ls: List(Lab), rho: Int) -> List(Lab) {
  match al {
    Nil -> Nil
    Cons(Lab(k, a, x, y), rest) -> if !has_lab(ls, k) && mentions_list(rho, a) { Cons(Lab(k, a, x, y), theirs_labs(rest, ls, rho)) } else { theirs_labs(rest, ls, rho) }
  }
}
fn add_row_labs(s1: St, amb: Int, ls: List(Lab), t: Tail, start: Int, end: Int) -> R(List(Lab)) {
  match add_labs(s1, amb, ls) {
    R(c, s2) -> match c {
      Nil -> match t { ROpen(rho) -> unify_row(s2, ropen(amb), ropen(rho), start, end)  _ -> R(Nil, s2) }
      _ -> R(c, s2)
    }
  }
}
fn add_labs(s: St, amb: Int, ls: List(Lab)) -> R(List(Lab)) {
  match ls {
    Nil -> R(Nil, s)
    Cons(Lab(n, args, a, b), rest) -> match add_effect_args(s, amb, n, args, a, b) {
      R(c, s2) -> match c { Nil -> add_labs(s2, amb, rest)  _ -> R(c, s2) }
    }
  }
}

// `t` with the variables at its head followed (`head_of`).
fn head(s: St, t: Ty) -> R(Ty) {
  match t {
    TVar(v) -> match bound(s, v) {
      R(b, s2) -> match b { TNone -> R(t, s2)  _ -> head(s2, b) }
    }
    _ -> R(t, s)
  }
}
// `t` resolved whole, rows included (`resolve`).
fn resolve(s: St, t: Ty) -> R(Ty) {
  match head(s, t) {
    R(h, s2) -> match h {
      TFn(ps, rw, r) -> match resolve_list(s2, ps, Nil) {
        R(ps2, s3) -> match resolve(s3, r) {
          R(r2, s4) -> match resolve_row(s4, rw) { R(rw2, s5) -> R(TFn(ps2, rw2, r2), s5) }
        }
      }
      TCon(n, args) -> match resolve_list(s2, args, Nil) { R(args2, s3) -> R(TCon(n, args2), s3) }
      _ -> R(h, s2)
    }
  }
}
fn resolve_list(s: St, xs: List(Ty), acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> match resolve(s, x) { R(y, s2) -> resolve_list(s2, rest, Cons(y, acc)) }
  }
}

// The free variables of a resolved type, in the order they first appear
// (`free_vars`), newest first.
fn free_vars(t: Ty, acc: List(Int)) -> List(Int) {
  match t {
    TVar(v) -> if has_int(acc, v) { acc } else { Cons(v, acc) }
    TFn(ps, Row(ls, _), r) -> free_vars(r, lab_vars(ls, free_list(ps, acc)))
    TCon(_, args) -> free_list(args, acc)
    _ -> acc
  }
}
fn lab_vars(ls: List(Lab), acc: List(Int)) -> List(Int) {
  match ls { Nil -> acc  Cons(Lab(_, args, _, _), rest) -> lab_vars(rest, free_list(args, acc)) }
}
fn free_list(xs: List(Ty), acc: List(Int)) -> List(Int) {
  match xs { Nil -> acc  Cons(x, rest) -> free_list(rest, free_vars(x, acc)) }
}
// The free row variables of a resolved type (`free_row_vars`): a function's
// parameters, its tail, its result. Newest first.
fn free_rows(t: Ty, acc: List(Int)) -> List(Int) {
  match t {
    TFn(ps, rw, r) -> {
      let a1 = free_rows_list(ps, acc)
      let a2 = match rw { Row(_, ROpen(v)) -> if has_int(a1, v) { a1 } else { Cons(v, a1) }  _ -> a1 }
      free_rows(r, lab_rows(row_labs(rw), a2))
    }
    TCon(_, args) -> free_rows_list(args, acc)
    _ -> acc
  }
}
fn row_labs(r: Row) -> List(Lab) { match r { Row(ls, _) -> ls } }
fn lab_rows(ls: List(Lab), acc: List(Int)) -> List(Int) {
  match ls { Nil -> acc  Cons(Lab(_, args, _, _), rest) -> lab_rows(rest, free_rows_list(args, acc)) }
}
fn free_rows_list(xs: List(Ty), acc: List(Int)) -> List(Int) {
  match xs { Nil -> acc  Cons(x, rest) -> free_rows_list(rest, free_rows(x, acc)) }
}
// The free row variables of the types `ts`, resolved.
fn rows_in(s: St, ts: List(Ty), acc: List(Int)) -> R(List(Int)) {
  match ts {
    Nil -> R(acc, s)
    Cons(t, rest) -> match resolve(s, t) { R(rt, s2) -> rows_in(s2, rest, free_rows(rt, acc)) }
  }
}
fn occurs(v: Int, t: Ty) -> Bool {
  match t {
    TVar(u) -> u == v
    TFn(ps, Row(ls, _), r) -> occurs_list(v, ps) || occurs(v, r) || occurs_labs(v, ls)
    TCon(_, args) -> occurs_list(v, args)
    _ -> False
  }
}
fn occurs_labs(v: Int, ls: List(Lab)) -> Bool {
  match ls { Nil -> False  Cons(Lab(_, args, _, _), rest) -> occurs_list(v, args) || occurs_labs(v, rest) }
}
fn occurs_list(v: Int, xs: List(Ty)) -> Bool {
  match xs { Nil -> False  Cons(x, rest) -> occurs(v, x) || occurs_list(v, rest) }
}

// What a variable stood for is where it was (D14): every variable free in
// the resolved `t`, rows included, is lowered to `lvl`.
fn lower_vars(s: St, vs: List(Int), lvl: Int) -> St {
  match vs {
    Nil -> s
    Cons(v, rest) -> match level_of(s, v) {
      R(l, s2) -> lower_vars(if l > lvl { set_level(s2, v, lvl) } else { s2 }, rest, lvl)
    }
  }
}
fn lower_rows(s: St, vs: List(Int), lvl: Int) -> St {
  match vs { Nil -> s  Cons(v, rest) -> lower_rows(lower_row(s, v, lvl), rest, lvl) }
}
fn lower_levels(s: St, t: Ty, lvl: Int) -> St {
  match resolve(s, t) { R(rt, s2) -> lower_rows(lower_vars(s2, rev(free_vars(rt, Nil)), lvl), rev(free_rows(rt, Nil)), lvl) }
}

// ---- Unification ----------------------------------------------------------

fn bind(s: St, v: Int, t: Ty, start: Int, end: Int) -> St {
  match t {
    TVar(u) -> if u == v { s } else { bind_checked(s, v, t, start, end) }
    _ -> bind_checked(s, v, t, start, end)
  }
}
fn bind_checked(s: St, v: Int, t: Ty, start: Int, end: Int) -> St {
  match resolve(s, t) {
    R(rt, s2) -> if occurs(v, rt) {
      set_var(diag(s2, "E0401", "infinite type", start, end), v, TErr)
    } else {
      match level_of(s2, v) {
        R(l, s3) -> {
          let s4 = set_var(lower_levels(s3, t, l), v, t)
          let s6 = match get_eq(s4) {
            R(Eqs(ms, _, _), s5) -> match mark_of(ms, v) { Yes(o) -> require_data(s5, t, start, end, o)  No -> s5 }
          }
          // A duplicable variable's type must be duplicable (D1).
          match get_af(s6) {
            R(Af(_, dv, _, _, _, _, _), s7) -> match dv_get(dv, v) { Yes(m) -> require_dup(s7, t, m, Nil)  No -> s7 }
          }
        }
      }
    }
  }
}

fn unify(s: St, a: Ty, b: Ty, start: Int, end: Int) -> St {
  match head(s, a) {
    R(x, s1) -> match head(s1, b) { R(y, s2) -> unify_heads(s2, x, y, start, end) }
  }
}
fn mismatch(s: St, start: Int, end: Int) -> St { diag(s, "E0400", "type mismatch", start, end) }
fn unify_heads(s: St, x: Ty, y: Ty, start: Int, end: Int) -> St {
  match x {
    TErr -> s
    TVar(a) -> match y {
      TErr -> s
      TVar(b) -> if a == b { s } else { bind(s, a, y, start, end) }
      _ -> bind(s, a, y, start, end)
    }
    _ -> match y {
      TErr -> s
      TVar(b) -> bind(s, b, x, start, end)
      _ -> unify_rigid(s, x, y, start, end)
    }
  }
}
// Functions: the parameters, the result, then the rows (`unify_heads`).
fn unify_rigid(s: St, x: Ty, y: Ty, start: Int, end: Int) -> St {
  match x {
    TB(a) -> match y { TB(b) -> if a == b { s } else { mismatch(s, start, end) }  _ -> mismatch(s, start, end) }
    TFn(p1, w1, r1) -> match y {
      TFn(p2, w2, r2) -> if len(p1) != len(p2) {
        diag(s, "E0402", "wrong number of arguments", start, end)
      } else {
        match unify_row(unify(unify_pairs(s, p1, p2, start, end), r1, r2, start, end), w1, w2, start, end) {
          R(c, s2) -> match c { Nil -> s2  _ -> diag(s2, "E0423", "effect row mismatch", start, end) }
        }
      }
      _ -> mismatch(s, start, end)
    }
    TCon(n1, a1) -> match y {
      TCon(n2, a2) -> if n1 == n2 && len(a1) == len(a2) {
        unify_pairs(s, a1, a2, start, end)
      } else { mismatch(s, start, end) }
      _ -> mismatch(s, start, end)
    }
    _ -> mismatch(s, start, end)
  }
}
fn unify_pairs(s: St, xs: List(Ty), ys: List(Ty), start: Int, end: Int) -> St {
  match xs {
    Nil -> s
    Cons(x, xr) -> match ys {
      Nil -> s
      Cons(y, yr) -> unify_pairs(unify(s, x, y, start, end), xr, yr, start, end)
    }
  }
}

// ---- Schemes ----------------------------------------------------------------

fn lookup(env: List(Entry), name: String) -> Maybe(Scheme) {
  match env {
    Nil -> No
    Cons(e, rest) -> match e { Entry(n, sc) -> if n == name { Yes(sc) } else { lookup(rest, name) } }
  }
}
type Pair { Pair(Int, Ty) }
type RPair { RPair(Int, Int) }
fn subst_get(m: List(Pair), v: Int) -> Maybe(Ty) {
  match m {
    Nil -> No
    Cons(p, rest) -> match p { Pair(u, t) -> if u == v { Yes(t) } else { subst_get(rest, v) } }
  }
}
fn rsubst_get(m: List(RPair), v: Int) -> Int {
  match m { Nil -> 0 - 1  Cons(RPair(u, w), rest) -> if u == v { w } else { rsubst_get(rest, v) } }
}
fn subst(t: Ty, m: List(Pair), rm: List(RPair)) -> Ty {
  match t {
    TVar(v) -> match subst_get(m, v) { Yes(f) -> f  No -> t }
    TFn(ps, rw, r) -> {
      let rw2 = match rw { Row(ls, ROpen(v)) -> { let w = rsubst_get(rm, v)  if w < 0 { rw } else { Row(ls, ROpen(w)) } }  _ -> rw }
      TFn(subst_list(ps, m, rm, Nil), subst_labs(rw2, m, rm), subst(r, m, rm))
    }
    TCon(n, args) -> TCon(n, subst_list(args, m, rm, Nil))
    _ -> t
  }
}
fn subst_labs(r: Row, m: List(Pair), rm: List(RPair)) -> Row {
  match r { Row(ls, t) -> Row(subst_labs_list(ls, m, rm), t) }
}
fn subst_labs_list(ls: List(Lab), m: List(Pair), rm: List(RPair)) -> List(Lab) {
  match ls {
    Nil -> Nil
    Cons(Lab(n, Nil, a, b), rest) -> Cons(Lab(n, Nil, a, b), subst_labs_list(rest, m, rm))
    Cons(Lab(n, args, a, b), rest) -> Cons(Lab(n, subst_list(args, m, rm, Nil), a, b), subst_labs_list(rest, m, rm))
  }
}
fn subst_list(xs: List(Ty), m: List(Pair), rm: List(RPair), acc: List(Ty)) -> List(Ty) {
  match xs { Nil -> rev(acc)  Cons(x, rest) -> subst_list(rest, m, rm, Cons(subst(x, m, rm), acc)) }
}
// A quantified phantom row instantiates phantom (`instantiate`). The span
// is the expression being typed (Rust's `cur_span`: a variable's own, or a
// call's for its callee), where a generically handled row is checked again;
// a constructor's scheme quantifies no such row.
fn instantiate(s: St, sc: Scheme) -> R(Ty) { instantiate_at(s, sc, 0, 0) }
fn instantiate_at(s: St, sc: Scheme, a: Int, b: Int) -> R(Ty) {
  match sc {
    Scheme(vars, rvars, t) -> match vars {
      Nil -> match rvars { Nil -> R(t, s)  _ -> instantiate_with(s, vars, rvars, t, a, b) }
      _ -> instantiate_with(s, vars, rvars, t, a, b)
    }
  }
}
fn instantiate_with(s: St, vars: List(Int), rvars: List(Int), t: Ty, a: Int, b: Int) -> R(Ty) {
  match fresh_map(s, vars, Nil) {
    R(m, s2) -> match fresh_rmap(s2, rvars, Nil) {
      R(rm, s3) -> R(subst(t, m, rm), copy_holds(copy_dups(generic_sites(s3, rvars, rm, t, a, b), m, a, b), rvars, m, rm, a, b))
    }
  }
}
// A duplicable variable a scheme quantifies marks its fresh copy, the
// instantiation named (E0437); a hold on a quantified row is copied.
fn copy_dups(s: St, m: List(Pair), a: Int, b: Int) -> St {
  match m {
    Nil -> s
    Cons(Pair(v, TVar(f)), rest) -> match get_af(s) {
      R(Af(fa, dv, rh, bd, rep, ad, lin), s2) -> match dv_get(dv, v) {
        Yes(mk) -> copy_dups(set_af(s2, Af(fa, Cons(DV(f, through(mk, a, b)), dv_without(dv, f)), rh, bd, rep, ad, lin)), rest, a, b)
        No -> copy_dups(s2, rest, a, b)
      }
    }
    Cons(_, rest) -> copy_dups(s, rest, a, b)
  }
}
fn dv_without(dv: List(DV), v: Int) -> List(DV) {
  match dv { Nil -> Nil  Cons(DV(u, m), rest) -> if u == v { rest } else { Cons(DV(u, m), dv_without(rest, v)) } }
}
fn copy_holds(s: St, rvars: List(Int), m: List(Pair), rm: List(RPair), a: Int, b: Int) -> St {
  match rvars {
    Nil -> s
    Cons(v, rest) -> match get_af(s) {
      R(Af(_, _, rh, _, _, _, _), s2) -> match rh_get(rh, v) {
        No -> copy_holds(s2, rest, m, rm, a, b)
        Yes(hs) -> match copies(s2, hs, m, rm, a, b, Nil) {
          R(cs, s3) -> copy_holds(add_holds(s3, rsubst_get(rm, v), cs), rest, m, rm, a, b)
        }
      }
    }
  }
}
fn copies(s: St, hs: List(Hold), m: List(Pair), rm: List(RPair), a: Int, b: Int, acc: List(Hold)) -> R(List(Hold)) {
  match hs {
    Nil -> R(rev(acc), s)
    Cons(Hold(No, sk, mk), rest) -> copies(s, rest, m, rm, a, b, Cons(Hold(No, sk, through(mk, a, b)), acc))
    Cons(Hold(Yes(t), sk, mk), rest) -> match resolve(s, t) { R(rt, s2) -> copies(s2, rest, m, rm, a, b, Cons(Hold(Yes(subst(rt, m, rm)), sk, through(mk, a, b)), acc)) }
  }
}
// A generically handled row quantified by a scheme is checked again where
// the scheme is instantiated, unless it is the function's own row (a
// forwarding handler's, the caller's ambient after the call).
fn generic_sites(s: St, rvars: List(Int), rm: List(RPair), t: Ty, a: Int, b: Int) -> St {
  match rvars {
    Nil -> s
    Cons(v, rest) -> match get_gn(s) {
      R(Gn(_, gr, _), s2) -> {
        let latent = match t { TFn(_, Row(_, ROpen(w)), _) -> w == v  _ -> False }
        generic_sites(if has_int(gr, v) && !latent { push_site(s2, GSite(Nil, ROpen(rsubst_get(rm, v)), False, a, b)) } else { s2 }, rest, rm, t, a, b)
      }
    }
  }
}
fn fresh_map(s: St, vars: List(Int), acc: List(Pair)) -> R(List(Pair)) {
  match vars {
    Nil -> R(acc, s)
    Cons(v, rest) -> match fresh(s) {
      R(f, s2) -> match get_eq(s2) {
        R(Eqs(ms, _, _), s3) -> {
          let s4 = match mark_of(ms, v) { Yes(o) -> match f { TVar(fv) -> mark(s3, fv, o)  _ -> s3 }  No -> s3 }
          fresh_map(s4, rest, Cons(Pair(v, f), acc))
        }
      }
    }
  }
}
fn fresh_rmap(s: St, vars: List(Int), acc: List(RPair)) -> R(List(RPair)) {
  match vars {
    Nil -> R(acc, s)
    Cons(v, rest) -> match is_phantom(s, v) {
      R(p, s2) -> match fresh_row_marked(s2, p) { R(w, s3) -> fresh_rmap(s3, rest, Cons(RPair(v, w), acc)) }
    }
  }
}
// The variables above the current level and not kept monomorphic
// (`generalize`), for types and for rows.
fn above(s: St, vs: List(Int), lvl: Int, kept: List(Int), acc: List(Int)) -> R(List(Int)) {
  match vs {
    Nil -> R(rev(acc), s)
    Cons(v, rest) -> match level_of(s, v) {
      R(l, s2) -> above(s2, rest, lvl, kept, if l > lvl && !has_int(kept, v) { Cons(v, acc) } else { acc })
    }
  }
}
fn above_rows(s: St, vs: List(Int), lvl: Int, kept: List(Int), acc: List(Int)) -> R(List(Int)) {
  match vs {
    Nil -> R(rev(acc), s)
    Cons(v, rest) -> match row_level(s, v) {
      R(l, s2) -> above_rows(s2, rest, lvl, kept, if l > lvl && !has_int(kept, v) { Cons(v, acc) } else { acc })
    }
  }
}
// The function's annotation variables are part of the environment
// (`kept_monomorphic`): a lowercase name is one type for the whole function,
// so an inner `let` must not quantify it, nor the rows inside it.
fn kept_holds(s: St, rh: List(RH), lvl: Int, acc: List(Int)) -> R(List(Int)) {
  match rh {
    Nil -> R(acc, s)
    Cons(RH(w, hs), rest) -> match row_bound(s, w) {
      R(Row(_, RNone), s2) -> match row_level(s2, w) {
        R(l, s3) -> if l <= lvl { match held_vars(s3, hs, acc) { R(acc2, s4) -> kept_holds(s4, rest, lvl, acc2) } } else { kept_holds(s3, rest, lvl, acc) }
      }
      R(_, s2) -> kept_holds(s2, rest, lvl, acc)
    }
  }
}
fn held_vars(s: St, hs: List(Hold), acc: List(Int)) -> R(List(Int)) {
  match hs {
    Nil -> R(acc, s)
    Cons(Hold(Yes(t), _, _), rest) -> match resolve(s, t) { R(rt, s2) -> held_vars(s2, rest, free_vars(rt, acc)) }
    Cons(_, rest) -> held_vars(s, rest, acc)
  }
}
fn take_holds(s: St, v: Int) -> R(Maybe(List(Hold))) {
  match get_af(s) {
    R(Af(fa, dv, rh, bd, rep, ad, lin), s2) -> match rh_get(rh, v) {
      No -> R(No, s2)
      Yes(hs) -> R(Yes(hs), set_af(s2, Af(fa, dv, rh_remove(rh, v), bd, rep, ad, lin)))
    }
  }
}
fn drop_holds(s: St, v: Int) -> St { match take_holds(s, v) { R(_, s2) -> s2 } }
fn kept_vars(s: St) -> R(List(Int)) {
  match get_cx(s) {
    R(Ctx(avs, _, _, _, _, _), s2) -> match kept_from(s2, avs, Nil) {
      R(acc, s3) -> match get_hx(s3) {
        R(Hx(rs, _, _, _, _, _, _, _, Af(_, _, rh, _, _, _, _)), s4) -> match kept_resume_vars(s4, rs, acc) {
          // A type held on a row this `let` leaves to its scope is the
          // scope's (D3, the review's U-B).
          R(acc2, s5) -> match cur_level(s5) { R(lvl, s6) -> kept_holds(s6, rh, lvl, acc2) }
        }
      }
    }
  }
}
// The enclosing clauses' `resume` types are one type for their clause, and
// its rows one row each (`kept_monomorphic`).
fn kept_resume_vars(s: St, rs: List(Resume), acc: List(Int)) -> R(List(Int)) {
  match rs {
    Nil -> R(acc, s)
    Cons(Resume(arg, result, rb, rr, _, _, rc), rest) -> match resolve(s, arg) {
      R(a, s2) -> match resolve(s2, result) {
        // A row's labels' arguments are types too.
        R(r, s3) -> match resolve_list(s3, Cons(phantom(ropen(rb)), Cons(phantom(ropen(rr)), Cons(phantom(ropen(rc)), Nil))), Nil) {
          R(rows, s4) -> kept_resume_vars(s4, rest, free_list(rows, free_vars(r, free_vars(a, acc))))
        }
      }
    }
  }
}
fn kept_resume_rows(s: St, rs: List(Resume), acc: List(Int)) -> R(List(Int)) {
  match rs {
    Nil -> R(acc, s)
    Cons(Resume(arg, result, b, r, _, _, c), rest) -> match resolve(s, arg) {
      R(a, s2) -> match resolve(s2, result) {
        R(rr, s3) -> match resolve_list(s3, Cons(phantom(ropen(b)), Cons(phantom(ropen(r)), Cons(phantom(ropen(c)), Nil))), Nil) {
          R(rows, s4) -> kept_resume_rows(s4, rest, free_rows_list(rows, free_rows(rr, free_rows(a, acc))))
        }
      }
    }
  }
}
fn kept_tails(s: St, rows: List(Int), acc: List(Int)) -> R(List(Int)) {
  match rows {
    Nil -> R(acc, s)
    Cons(r, rest) -> match rhead(s, ROpen(r)) { R(t, s2) -> kept_tails(s2, rest, match t { ROpen(v) -> Cons(v, acc)  _ -> acc }) }
  }
}
fn kept_from(s: St, avs: List(Named), acc: List(Int)) -> R(List(Int)) {
  match avs {
    Nil -> R(acc, s)
    Cons(Named(_, t), rest) -> match resolve(s, t) { R(rt, s2) -> kept_from(s2, rest, free_vars(rt, acc)) }
  }
}
// A lambda's row deferred to the group (`deferred_rows`) is kept too: its
// group member's effects arrive when the group is done (the third review's
// defect: quantified, each use copied it instead of sharing it).
fn kept_rows(s: St) -> R(List(Int)) {
  match get_cx(s) {
    R(Ctx(avs, _, _, _, ar, _), s2) -> match kept_rows_from(s2, avs, Nil) {
      R(acc0, s2b) -> match kept_tails(s2b, arity_vals(ar), acc0) {
      R(acc, s3) -> match get_gx(s3) {
        R(Gx(_, _, _, _, ds, _, _), s4) -> match kept_deferred(s4, ds, acc) {
          R(acc2, s5) -> match get_hx(s5) {
            R(Hx(rs, crs, _, _, _, _, _, Gn(_, _, pg), _), s6) -> match kept_resume_rows(s6, rs, acc2) {
              R(acc3, s7) -> match kept_tails(s7, crs, acc3) { R(acc4, s8) -> kept_sites(s8, pg, acc4) }
            }
          }
        }
      }
      }
    }
  }
}
// A row a `with any` handler handles, not yet checked for data, stays
// monomorphic in a local `let`.
fn kept_sites(s: St, sites: List(GSite), acc: List(Int)) -> R(List(Int)) {
  match sites {
    Nil -> R(acc, s)
    Cons(GSite(_, t, fw, _, _), rest) -> if fw { kept_sites(s, rest, acc) } else {
      match rhead(s, t) { R(h, s2) -> kept_sites(s2, rest, match h { ROpen(v) -> Cons(v, acc)  _ -> acc }) }
    }
  }
}
fn arity_vals(xs: List(Arity)) -> List(Int) {
  match xs { Nil -> Nil  Cons(Arity(_, v), rest) -> Cons(v, arity_vals(rest)) }
}
fn kept_deferred(s: St, ds: List(Deferred), acc: List(Int)) -> R(List(Int)) {
  match ds {
    Nil -> R(acc, s)
    Cons(Deferred(l, _), rest) -> match rhead(s, ROpen(l)) {
      R(t, s2) -> kept_deferred(s2, rest, match t { ROpen(v) -> Cons(v, acc)  _ -> acc })
    }
  }
}
fn kept_rows_from(s: St, avs: List(Named), acc: List(Int)) -> R(List(Int)) {
  match avs {
    Nil -> R(acc, s)
    Cons(Named(_, t), rest) -> match resolve(s, t) { R(rt, s2) -> kept_rows_from(s2, rest, free_rows(rt, acc)) }
  }
}
// What is not quantified and sits above the level comes down to it.
fn lower_unquantified(s: St, vs: List(Int), quantified: List(Int), lvl: Int) -> St {
  match vs {
    Nil -> s
    Cons(v, rest) -> if has_int(quantified, v) { lower_unquantified(s, rest, quantified, lvl) } else {
      match level_of(s, v) {
        R(l, s2) -> lower_unquantified(if l > lvl { set_level(s2, v, lvl) } else { s2 }, rest, quantified, lvl)
      }
    }
  }
}
fn lower_unquantified_rows(s: St, vs: List(Int), quantified: List(Int), lvl: Int) -> St {
  match vs {
    Nil -> s
    Cons(v, rest) -> lower_unquantified_rows(if has_int(quantified, v) { s } else { lower_row(s, v, lvl) }, rest, quantified, lvl)
  }
}
fn generalize(s: St, t: Ty) -> R(Scheme) {
  match resolve(s, t) {
    R(rt, s2) -> match cur_level(s2) {
      R(lvl, s3) -> match kept_vars(s3) {
        R(kept, s4) -> match kept_rows(s4) {
          R(krows, s5) -> {
            let in_ty = rev(free_vars(rt, Nil))
            let rows_in_ty = rev(free_rows(rt, Nil))
            match above(s5, in_ty, lvl, kept, Nil) {
              R(vs, s6) -> match above_rows(s6, rows_in_ty, lvl, krows, Nil) {
                R(rvs, s7) -> R(Scheme(vs, rvs, rt), lower_unquantified_rows(lower_unquantified(s7, in_ty, vs, lvl), rows_in_ty, rvs, lvl))
              }
            }
          }
        }
      }
    }
  }
}

// ---- Annotations --------------------------------------------------------------

fn arity_of(xs: List(Arity), name: String) -> Int {
  match xs { Nil -> 0 - 1  Cons(Arity(n, k), rest) -> if n == name { k } else { arity_of(rest, name) } }
}
fn named_get(xs: List(Named), name: String) -> Maybe(Ty) {
  match xs { Nil -> No  Cons(Named(n, t), rest) -> if n == name { Yes(t) } else { named_get(rest, name) } }
}
fn has_str(xs: List(String), v: String) -> Bool {
  match xs { Nil -> False  Cons(x, rest) -> if x == v { True } else { has_str(rest, v) } }
}
fn is_lower(name: String) -> Bool {
  if string.length(name) == 0 { False } else {
    let c = string.byte_at(name, 0)
    c >= 97 && c <= 122
  }
}
// `Buffer` is written as a base type, a builtin linear one.
fn base_ty(b: Int) -> Ty { if b == 5 { TCon("Buffer", Nil) } else { TB(b) } }
fn base_code(name: String) -> Int {
  if name == "Int" { 0 } else { if name == "Float" { 1 } else { if name == "Bool" { 2 } else {
    if name == "String" { 3 } else { if name == "Unit" { 4 } else { if name == "Buffer" { 5 } else { 0 - 1 } } } } } }
}
fn ann_vars(s: St) -> R(List(Named)) {
  match get_cx(s) { R(Ctx(vs, _, _, _, _, _), s2) -> R(vs, s2) }
}
fn set_ann_vars(s: St, vs: List(Named)) -> St {
  match get_cx(s) { R(Ctx(_, k, c, e, ar, kd), s2) -> set_cx(s2, Ctx(vs, k, c, e, ar, kd)) }
}
fn known_arity(s: St, name: String) -> R(Int) {
  match get_cx(s) { R(Ctx(v, k, c, e, ar, kd), s2) -> R(arity_of(k, name), s2) }
}
fn ctor_arity(s: St, name: String) -> R(Int) {
  match get_cx(s) { R(Ctx(v, k, c, e, ar, kd), s2) -> R(arity_of(c, name), s2) }
}
fn ann_rows(s: St) -> R(List(Arity)) {
  match get_cx(s) { R(Ctx(_, _, _, _, ar, _), s2) -> R(ar, s2) }
}
fn set_ann_rows(s: St, ar: List(Arity)) -> St {
  match get_cx(s) { R(Ctx(v, k, c, e, _, kd), s2) -> set_cx(s2, Ctx(v, k, c, e, ar, kd)) }
}
fn arity_get(xs: List(Arity), name: String) -> Maybe(Int) {
  match xs { Nil -> No  Cons(Arity(n, k), rest) -> if n == name { Yes(k) } else { arity_get(rest, name) } }
}
fn capitalized(name: String) -> String {
  let c = string.byte_at(name, 0)
  if c >= 97 && c <= 122 { string.slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c - 97, c - 96) <> string.slice(name, 1, string.length(name)) } else { name }
}
// `ann_row`: the function's row variable of the name, the same one at every
// mention, meaningful (not phantom). Where a name first appears: an
// effect's name in lowercase is E0432; a name that is also a type, E0400.
fn ann_row(s: St, name: String, start: Int, end: Int) -> R(Int) {
  match ann_rows(s) {
    R(ar, s2) -> match arity_get(ar, name) {
      Yes(v) -> R(v, s2)
      No -> {
        let cap = capitalized(name)
        match is_effect(s2, cap) {
          R(eff, s3) -> match ann_vars(s3) {
            R(avs, s4) -> {
              let s5 = if eff || cap == "IO" {
                diag(s4, "E0432", "row variable `" <> name <> "` is spelled like an effect", start, end)
              } else { match named_get(avs, name) {
                Yes(_) -> diag(s4, "E0400", "`" <> name <> "` names a type and a row", start, end)
                No -> s4
              } }
              match fresh_row(s5) { R(v, s6) -> R(v, set_ann_rows(s6, Cons(Arity(name, v), ar))) }
            }
          }
        }
      }
    }
  }
}
// A function's annotation (`elaborate_ann`): a lowercase name is that
// function's variable of the name; a function type's unwritten row is an
// upcast tail where the value is produced (covariant) and a real variable
// where it is consumed.
fn elaborate(s: St, a: Sp(TypeAnn), cov: Bool) -> R(Ty) {
  match a {
    Sp(_, start, end) -> if is_row_arg(a) {
      // A row where a type goes (a type's row argument is read by
      // `ann_row_arg`).
      R(TErr, diag(s, "E0400", row_not_here(), start, end))
    } else { elaborate_inner(s, a, cov) }
  }
}
fn row_not_here() -> String { "a row is written only where a type or an effect takes one" }
// A row written as a type argument, `{Log | e}`: the parser's phantom
// function type `fn() / {Log | e} -> $Row` (`as_row_arg`).
fn is_row_arg(a: Sp(TypeAnn)) -> Bool {
  match a {
    Sp(TypeAnn("fn", Cons(Sp(TypeAnn(r, _, _), _, _), Nil), Yes(_)), _, _) -> r == "$Row"
    _ -> False
  }
}
fn elaborate_inner(s: St, a: Sp(TypeAnn), cov: Bool) -> R(Ty) {
  match a {
    Sp(TypeAnn(name, args, written), start, end) -> {
      let n = len(args)
      if name == "$Row" && n == 0 { R(TCon("$Row", Nil), s) } else {
      if name == "fn" && n > 0 {
        match elaborate_fn_params(s, args, n - 1, !cov, Nil) {
          R(ps, s2) -> match elaborate(s2, last_ann(args), cov) {
            R(ret, s3) -> match written {
              // Unwritten: an upcast tail where the value is produced, a
              // real variable where it is consumed.
              No -> match fresh_row_marked(s3, cov) { R(w, s4) -> R(TFn(ps, ropen(w), ret), s4) }
              Yes(RowAnn(labels, tail)) -> match ann_labels(s3, labels, Nil) {
                R(ls, s4) -> match tail {
                  No -> R(TFn(ps, Row(ls, RClosed), ret), s4)
                  Yes(Sp(v, vs, ve)) -> match ann_row(s4, v, vs, ve) { R(w, s5) -> R(TFn(ps, Row(ls, ROpen(w)), ret), s5) }
                }
              }
            }
          }
        }
      } else { if n == 0 && is_lower(name) {
        match ann_vars(s) {
          R(vs, s2) -> match named_get(vs, name) {
            Yes(t) -> R(t, s2)
            No -> match ann_rows(s2) {
              R(ar, s2b) -> {
                let s2c = match arity_get(ar, name) {
                  Yes(_) -> diag(s2b, "E0400", "`" <> name <> "` names a type and a row", start, end)
                  No -> s2b
                }
                match fresh(s2c) { R(t, s3) -> R(t, set_ann_vars(s3, Cons(Named(name, t), vs))) }
              }
            }
          }
        }
      } else {
        let b = base_code(name)
        if b >= 0 && n > 0 {
          R(TErr, diag(s, "E0400", "`" <> name <> "` takes no type arguments", start, end))
        } else {
          if b >= 0 { R(base_ty(b), s) } else {
            match known_arity(s, name) {
              R(k, s2) -> if k < 0 {
                R(TErr, diag(s2, "E0432", "unknown type `" <> name <> "`", start, end))
              } else {
                if k != n {
                  R(TErr, diag(s2, "E0400", "type `" <> name <> "` expects " <> int.to_string(k) <> " argument(s), found " <> int.to_string(n), start, end))
                } else {
                  match ann_args(s2, name, args, 0, Nil) { R(ts, s3) -> R(TCon(name, ts), s3) }
                }
              }
            }
          }
        }
      } } }
    }
  }
}
// A named type's arguments are invariant (consumed positions); a row
// parameter's argument is a row (`ann_row_arg`), a type parameter's a type
// (`ann_type_arg`).
fn ann_args(s: St, decl: String, xs: List(Sp(TypeAnn)), j: Int, acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> match get_kinds(s) {
      R(kd, s2) -> {
        let param = param_name(kd, decl, j)
        let got = if kind_at(kd, decl, j) { ann_row_arg(s2, x, decl, param) } else { ann_type_arg(s2, x, decl, param) }
        match got { R(t, s3) -> ann_args(s3, decl, rest, j + 1, Cons(t, acc)) }
      }
    }
  }
}
fn wants_row(decl: String, param: String) -> String { "`" <> decl <> "`'s parameter `" <> param <> "` is a row: write one, `{Log}`" }
fn wants_type(decl: String, param: String) -> String { "`" <> decl <> "`'s parameter `" <> param <> "` is a type, not a row" }
fn ann_row_arg(s: St, a: Sp(TypeAnn), decl: String, param: String) -> R(Ty) {
  if is_row_arg(a) { elaborate_inner(s, a, False) } else {
    match a {
      Sp(TypeAnn(n, Nil, No), start, end) -> if is_lower(n) {
        match ann_row(s, n, start, end) { R(v, s2) -> R(phantom(ropen(v)), s2) }
      } else { R(TErr, diag(s, "E0400", wants_row(decl, param), start, end)) }
      Sp(_, start, end) -> R(TErr, diag(s, "E0400", wants_row(decl, param), start, end))
    }
  }
}
fn ann_type_arg(s: St, a: Sp(TypeAnn), decl: String, param: String) -> R(Ty) {
  match a {
    Sp(_, start, end) -> if is_row_arg(a) { R(TErr, diag(s, "E0400", wants_type(decl, param), start, end)) } else { elaborate(s, a, False) }
  }
}
// A row argument as a type (`phantom`): `fn() / R -> $Row`.
fn phantom(r: Row) -> Ty { TFn(Nil, r, TCon("$Row", Nil)) }
// A written row's labels (`ann_labels`): each a declared effect or `IO`.
fn ann_labels(s: St, xs: List(LabelAnn), acc: List(Lab)) -> R(List(Lab)) {
  match xs {
    Nil -> R(acc, s)
    Cons(LabelAnn(Sp(name, a, b), written), rest) -> match is_effect(s, name) {
      R(known, s2) -> if known || name == "IO" {
        match effect_kinds(s2) {
          R(ek, s3) -> {
            let arity = len(kind_params(ek, name))
            match written {
              // Unwritten: a fresh variable for each.
              No -> match fresh_list(s3, arity, Nil) { R(ts, s4) -> ann_labels(s4, rest, put_lab(acc, Lab(name, ts, a, b))) }
              Yes(args) -> if len(args) != arity {
                ann_labels(diag(s3, "E0400", "effect `" <> name <> "` takes " <> int.to_string(arity) <> " argument(s), found " <> int.to_string(len(args)), a, b), rest, acc)
              } else {
                match ann_label_args(s3, ek, name, args, 0, Nil) { R(ts, s4) -> ann_labels(s4, rest, put_lab(acc, Lab(name, ts, a, b))) }
              }
            }
          }
        }
      } else {
        ann_labels(diag(s2, "E0432", "unknown effect `" <> name <> "`", a, b), rest, acc)
      }
    }
  }
}
fn ann_label_args(s: St, ek: List(Kind), eff: String, xs: List(Sp(TypeAnn)), j: Int, acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> {
      let param = param_name(ek, eff, j)
      let got = if kind_at(ek, eff, j) { ann_row_arg(s, x, eff, param) } else { ann_type_arg(s, x, eff, param) }
      match got { R(t, s2) -> ann_label_args(s2, ek, eff, rest, j + 1, Cons(t, acc)) }
    }
  }
}
fn is_effect(s: St, name: String) -> R(Bool) {
  match get_hx(s) { R(Hx(_, _, _, _, effs, _, _, _, _), s2) -> R(has_str(effs, name), s2) }
}
fn last_ann(xs: List(Sp(TypeAnn))) -> Sp(TypeAnn) {
  match xs {
    Cons(x, Nil) -> x
    Cons(_, rest) -> last_ann(rest)
    Nil -> Sp(TypeAnn("Unit", Nil, No), 0, 0)
  }
}
fn elaborate_fn_params(s: St, xs: List(Sp(TypeAnn)), n: Int, cov: Bool, acc: List(Ty)) -> R(List(Ty)) {
  if n == 0 { R(rev(acc), s) } else {
    match xs {
      Nil -> R(rev(acc), s)
      Cons(x, rest) -> match elaborate(s, x, cov) { R(t, s2) -> elaborate_fn_params(s2, rest, n - 1, cov, Cons(t, acc)) }
    }
  }
}
// A named type's arguments (`ann_type_arg`): consumed positions.
fn elaborate_list(s: St, xs: List(Sp(TypeAnn)), acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> match elaborate(s, x, False) { R(t, s2) -> elaborate_list(s2, rest, Cons(t, acc)) }
  }
}
fn check_ann(s: St, ann: Maybe(Sp(TypeAnn)), t: Ty, cov: Bool) -> St {
  match ann {
    No -> s
    Yes(a) -> match a {
      Sp(_, start, end) -> match elaborate(s, a, cov) { R(want, s2) -> unify(s2, want, t, start, end) }
    }
  }
}
// A declared type's field (`elaborate_adt_ty`): its parameters are the
// declaration's (`DeclCx`: its name, its type parameters, its row
// parameters); a base type's arguments are not looked at; a wrong count of
// arguments is reported and the arguments still read.
// An effect's own label written without arguments in its declaration takes
// the declaration's own arguments (`own`).
type DeclCx { DeclCx(String, List(Named), List(Arity), Maybe(List(Ty))) }
fn elaborate_adt(s: St, a: Sp(TypeAnn), cx: DeclCx) -> R(Ty) {
  match a {
    Sp(_, start, end) -> if is_row_arg(a) { R(TErr, diag(s, "E0400", row_not_here(), start, end)) } else { elaborate_adt_inner(s, a, cx) }
  }
}
fn elaborate_adt_inner(s: St, a: Sp(TypeAnn), cx: DeclCx) -> R(Ty) {
  match a {
    Sp(TypeAnn(name, args, written), start, end) -> {
      let n = len(args)
      if name == "$Row" && n == 0 { R(TCon("$Row", Nil), s) } else {
      if name == "fn" && n > 0 {
        // A declaration's rows are exactly what is written: none is pure.
        match elaborate_adt_list(s, first_anns(args, n - 1, Nil), cx, Nil) {
          R(ps, s2) -> match elaborate_adt(s2, last_ann(args), cx) {
            R(ret, s3) -> match written {
              No -> R(TFn(ps, pure_row(), ret), s3)
              Yes(RowAnn(labels, tail)) -> match adt_labels(s3, labels, cx, Nil) {
                R(ls, s4) -> match tail {
                  No -> R(TFn(ps, Row(ls, RClosed), ret), s4)
                  Yes(Sp(v, vs, ve)) -> match cx {
                    DeclCx(decl, _, re, _) -> match arity_get(re, v) {
                      Yes(rv) -> R(TFn(ps, Row(ls, ROpen(rv)), ret), s4)
                      No -> R(TFn(ps, Row(ls, RClosed), ret), undeclared_row_var(s4, v, vs, ve))
                    }
                  }
                }
              }
            }
          }
        }
      } else {
        match cx {
          DeclCx(decl, pe, re, _) -> {
            let p = if n == 0 { named_get(pe, name) } else { No }
            match p {
              Yes(t) -> R(t, s)
              No -> if n == 0 && has_arity(re, name) {
                R(TErr, diag(s, "E0400", "`" <> name <> "` is a row parameter of `" <> decl <> "`: a type goes here", start, end))
              } else {
                let b = base_code(name)
                if b >= 0 { R(base_ty(b), s) } else {
                  match known_arity(s, name) {
                    R(k, s2) -> if k < 0 {
                      R(TErr, diag(s2, "E0432", "unknown type `" <> name <> "`", start, end))
                    } else {
                      let s3 = if k != n {
                        diag(s2, "E0400", "type `" <> name <> "` expects " <> int.to_string(k) <> " argument(s), found " <> int.to_string(n), start, end)
                      } else { s2 }
                      match adt_args(s3, name, args, 0, cx, Nil) { R(ts, s4) -> R(TCon(name, ts), s4) }
                    }
                  }
                }
              }
            }
          }
        }
      } }
    }
  }
}
// A declaration's written labels: each a declared effect or `IO`, with
// exactly its arguments (none written: the effect's own in its own
// declaration).
fn adt_labels(s: St, xs: List(LabelAnn), cx: DeclCx, acc: List(Lab)) -> R(List(Lab)) {
  match xs {
    Nil -> R(acc, s)
    Cons(LabelAnn(Sp(name, a, b), written), rest) -> if name == "IO" { adt_labels(s, rest, cx, put_lab(acc, Lab(name, Nil, a, b))) } else {
      match effect_kinds(s) {
        R(ek, s2) -> if !has_kind(ek, name) {
          adt_labels(diag(s2, "E0432", "unknown effect `" <> name <> "`", a, b), rest, cx, acc)
        } else {
          let arity = len(kind_params(ek, name))
          match written {
            No -> if arity == 0 { adt_labels(s2, rest, cx, put_lab(acc, Lab(name, Nil, a, b))) } else {
              match cx {
                DeclCx(decl, _, _, Yes(own)) -> if decl == name { adt_labels(s2, rest, cx, put_lab(acc, Lab(name, own, a, b))) } else {
                  adt_labels(diag(s2, "E0432", "effect `" <> name <> "` takes type arguments: write them, `" <> name <> "(..)`", a, b), rest, cx, acc)
                }
                _ -> adt_labels(diag(s2, "E0432", "effect `" <> name <> "` takes type arguments: write them, `" <> name <> "(..)`", a, b), rest, cx, acc)
              }
            }
            Yes(args) -> if len(args) != arity {
              adt_labels(diag(s2, "E0400", "effect `" <> name <> "` takes " <> int.to_string(arity) <> " argument(s), found " <> int.to_string(len(args)), a, b), rest, cx, acc)
            } else {
              match adt_label_args(s2, ek, name, args, 0, cx, Nil) { R(ts, s3) -> adt_labels(s3, rest, cx, put_lab(acc, Lab(name, ts, a, b))) }
            }
          }
        }
      }
    }
  }
}
fn has_kind(kd: List(Kind), name: String) -> Bool {
  match kd { Nil -> False  Cons(Kind(n, _), rest) -> n == name || has_kind(rest, name) }
}
fn adt_label_args(s: St, ek: List(Kind), eff: String, xs: List(Sp(TypeAnn)), j: Int, cx: DeclCx, acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> {
      let param = param_name(ek, eff, j)
      let got = if kind_at(ek, eff, j) { decl_row_arg(s, x, cx, eff, param) } else { decl_type_arg(s, x, cx, eff, param) }
      match got { R(t, s2) -> adt_label_args(s2, ek, eff, rest, j + 1, cx, Cons(t, acc)) }
    }
  }
}
fn has_arity(xs: List(Arity), name: String) -> Bool {
  match arity_get(xs, name) { Yes(_) -> True  No -> False }
}
// E0432 for a row variable a declaration does not declare.
fn undeclared_row_var(s: St, v: String, start: Int, end: Int) -> St {
  diag(s, "E0432", "a declaration's row cannot name a row variable (`" <> v <> "`) it does not declare", start, end)
}
fn adt_args(s: St, decl: String, xs: List(Sp(TypeAnn)), j: Int, cx: DeclCx, acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> match get_kinds(s) {
      R(kd, s2) -> {
        let param = param_name(kd, decl, j)
        let got = if kind_at(kd, decl, j) { decl_row_arg(s2, x, cx, decl, param) } else { decl_type_arg(s2, x, cx, decl, param) }
        match got { R(t, s3) -> adt_args(s3, decl, rest, j + 1, cx, Cons(t, acc)) }
      }
    }
  }
}
// A row parameter's argument in a declaration: a row, or one of the
// declaration's row parameters alone.
fn decl_row_arg(s: St, a: Sp(TypeAnn), cx: DeclCx, decl: String, param: String) -> R(Ty) {
  if is_row_arg(a) { elaborate_adt_inner(s, a, cx) } else {
    match cx {
      DeclCx(own, pe, re, _) -> match a {
        Sp(TypeAnn(n, Nil, No), start, end) -> if is_lower(n) {
          match arity_get(re, n) {
            Yes(rv) -> R(phantom(ropen(rv)), s)
            No -> match named_get(pe, n) {
              No -> R(TErr, undeclared_row_var(s, n, start, end))
              Yes(_) -> R(TErr, diag(s, "E0400", wants_row(decl, param), start, end))
            }
          }
        } else { R(TErr, diag(s, "E0400", wants_row(decl, param), start, end)) }
        Sp(_, start, end) -> R(TErr, diag(s, "E0400", wants_row(decl, param), start, end))
      }
    }
  }
}
fn decl_type_arg(s: St, a: Sp(TypeAnn), cx: DeclCx, decl: String, param: String) -> R(Ty) {
  match a {
    Sp(_, start, end) -> if is_row_arg(a) { R(TErr, diag(s, "E0400", wants_type(decl, param), start, end)) } else { elaborate_adt(s, a, cx) }
  }
}
fn first_anns(xs: List(Sp(TypeAnn)), n: Int, acc: List(Sp(TypeAnn))) -> List(Sp(TypeAnn)) {
  if n == 0 { rev(acc) } else { match xs { Nil -> rev(acc)  Cons(x, rest) -> first_anns(rest, n - 1, Cons(x, acc)) } }
}
fn elaborate_adt_list(s: St, xs: List(Sp(TypeAnn)), cx: DeclCx, acc: List(Ty)) -> R(List(Ty)) {
  match xs {
    Nil -> R(rev(acc), s)
    Cons(x, rest) -> match elaborate_adt(s, x, cx) { R(t, s2) -> elaborate_adt_list(s2, rest, cx, Cons(t, acc)) }
  }
}

// ---- Declarations -------------------------------------------------------------

fn known_types(decls: List(Sp(Decl)), acc: List(Arity)) -> List(Arity) {
  match decls {
    Nil -> acc
    Cons(Sp(DType(name, params, _, _), _, _), rest) -> known_types(rest, Cons(Arity(name, len(params)), acc))
    Cons(_, rest) -> known_types(rest, acc)
  }
}
fn ids(ts: List(Ty), acc: List(Int)) -> List(Int) {
  match ts { Nil -> rev(acc)  Cons(TVar(v), rest) -> ids(rest, Cons(v, acc))  Cons(_, rest) -> ids(rest, acc) }
}
fn zip_named(ns: List(String), ts: List(Ty), acc: List(Named)) -> List(Named) {
  match ns {
    Nil -> acc
    Cons(n, nr) -> match ts { Nil -> acc  Cons(t, tr) -> zip_named(nr, tr, Cons(Named(n, t), acc)) }
  }
}
fn add_ctor(s: St, name: String, k: Int) -> St {
  match get_cx(s) { R(Ctx(v, kn, c, e, ar, kd), s2) -> set_cx(s2, Ctx(v, kn, Cons(Arity(name, k), c), e, ar, kd)) }
}
fn add_empty(s: St, name: String) -> St {
  match get_cx(s) { R(Ctx(v, kn, c, e, ar, kd), s2) -> set_cx(s2, Ctx(v, kn, c, Cons(name, e), ar, kd)) }
}
fn add_adt_fields(s: St, result: Ty, vars: List(Int), fts: List(Ty)) -> St {
  match result {
    TCon(name, _) -> match get_eq(s) {
      R(Eqs(ms, rep, adts), s2) -> {
        let cs = match adt_of(adts, name) { Yes(Adt(_, _, c)) -> c  No -> Nil }
        set_eq(s2, Eqs(ms, rep, Cons(Adt(name, vars, append(cs, Cons(fts, Nil))), adts)))
      }
    }
    _ -> s
  }
}
// Each declared type's parameters' kinds (`decl_kinds`, spec
// 2026-10-30-elya-row-variables D3): a parameter is a row parameter when its
// declaration uses it where a row goes -- a row's tail, or the argument at
// another declaration's row parameter. A fixpoint: a parameter only turns
// from type to row.
type KindPass { KindPass(List(Kind), Bool) }
// The declared types' kinds and the effects'.
type Kinds { Kinds(List(Kind), List(Kind)) }
type KindsPass { KindsPass(Kinds, Bool) }
fn decl_kinds(decls: List(Sp(Decl))) -> Kinds { kinds_fix(decls, Kinds(kinds_init(decls, Nil), effect_kinds_init(decls, Nil))) }
fn kinds_init(decls: List(Sp(Decl)), acc: List(Kind)) -> List(Kind) {
  match decls {
    Nil -> rev(acc)
    Cons(Sp(DType(name, params, _, _), _, _), rest) -> kinds_init(rest, Cons(Kind(name, kps(params)), acc))
    Cons(_, rest) -> kinds_init(rest, acc)
  }
}
fn effect_kinds_init(decls: List(Sp(Decl)), acc: List(Kind)) -> List(Kind) {
  match decls {
    Nil -> rev(acc)
    Cons(Sp(DEffect(name, params, _, _), _, _), rest) -> effect_kinds_init(rest, Cons(Kind(name, kps(params)), acc))
    Cons(_, rest) -> effect_kinds_init(rest, acc)
  }
}
fn kps(ps: List(String)) -> List(KP) {
  match ps { Nil -> Nil  Cons(p, rest) -> Cons(KP(p, False), kps(rest)) }
}
fn kinds_fix(decls: List(Sp(Decl)), kd: Kinds) -> Kinds {
  match kinds_pass(decls, kd, False) {
    KindsPass(kd2, changed) -> if changed { kinds_fix(decls, kd2) } else { kd2 }
  }
}
fn kinds_pass(decls: List(Sp(Decl)), kd: Kinds, changed: Bool) -> KindsPass {
  match decls {
    Nil -> KindsPass(kd, changed)
    Cons(Sp(DType(name, params, _, variants), _, _), rest) -> match kd {
      Kinds(ts, es) -> match mark_kinds(ts, name, variant_uses(variants, params, kd, Nil)) {
        KindPass(ts2, c) -> kinds_pass(rest, Kinds(ts2, es), changed || c)
      }
    }
    Cons(Sp(DEffect(name, params, _, ops), _, _), rest) -> match kd {
      Kinds(ts, es) -> match mark_kinds(es, name, op_uses(ops, params, kd, Nil)) {
        KindPass(es2, c) -> kinds_pass(rest, Kinds(ts, es2), changed || c)
      }
    }
    Cons(_, rest) -> kinds_pass(rest, kd, changed)
  }
}
fn op_uses(ops: List(Sp(OpSig)), params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match ops {
    Nil -> out
    Cons(Sp(OpSig(_, _, ptys, ret), _, _), rest) -> op_uses(rest, params, kd, row_uses(ret, params, kd, anns_uses(ptys, params, kd, out)))
  }
}
fn variant_uses(vs: List(Sp(VariantDecl)), params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match vs {
    Nil -> out
    Cons(Sp(VariantDecl(_, fields), _, _), rest) -> variant_uses(rest, params, kd, anns_uses(fields, params, kd, out))
  }
}
fn anns_uses(xs: List(Sp(TypeAnn)), params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match xs { Nil -> out  Cons(x, rest) -> anns_uses(rest, params, kd, row_uses(x, params, kd, out)) }
}
// `row_uses`: the parameters (of `params`) an annotation uses where a row
// goes.
fn row_uses(a: Sp(TypeAnn), params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match a {
    Sp(TypeAnn(name, args, written), _, _) -> {
      let o1 = match written {
        Yes(RowAnn(labels, tail)) -> {
          let o = match tail { Yes(Sp(v, _, _)) -> if has_str(params, v) { Cons(v, out) } else { out }  No -> out }
          label_uses(labels, params, kd, o)
        }
        No -> out
      }
      arg_uses(name, args, 0, params, kd, o1)
    }
  }
}
fn label_uses(ls: List(LabelAnn), params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match ls {
    Nil -> out
    Cons(LabelAnn(Sp(n, _, _), Yes(xs)), rest) -> label_uses(rest, params, kd, label_arg_uses(n, xs, 0, params, kd, out))
    Cons(_, rest) -> label_uses(rest, params, kd, out)
  }
}
fn label_arg_uses(eff: String, xs: List(Sp(TypeAnn)), j: Int, params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match xs {
    Nil -> out
    Cons(x, rest) -> match kd {
      Kinds(_, es) -> {
        let o = if kind_at(es, eff, j) { bare_use(x, params, out) } else { out }
        label_arg_uses(eff, rest, j + 1, params, kd, row_uses(x, params, kd, o))
      }
    }
  }
}
fn arg_uses(name: String, args: List(Sp(TypeAnn)), j: Int, params: List(String), kd: Kinds, out: List(String)) -> List(String) {
  match args {
    Nil -> out
    Cons(x, rest) -> match kd {
      Kinds(ts, _) -> {
        let o = if name != "fn" && kind_at(ts, name, j) { bare_use(x, params, out) } else { out }
        arg_uses(name, rest, j + 1, params, kd, row_uses(x, params, kd, o))
      }
    }
  }
}
fn bare_use(x: Sp(TypeAnn), params: List(String), out: List(String)) -> List(String) {
  match x {
    Sp(TypeAnn(n, Nil, No), _, _) -> if has_str(params, n) { Cons(n, out) } else { out }
    _ -> out
  }
}
fn mark_kinds(kd: List(Kind), name: String, rows: List(String)) -> KindPass {
  match kd {
    Nil -> KindPass(Nil, False)
    Cons(Kind(n, ps), rest) -> if n == name {
      match mark_kps(ps, rows) { KindPass(_, c) -> KindPass(Cons(Kind(n, marked(ps, rows)), rest), c) }
    } else {
      match mark_kinds(rest, name, rows) { KindPass(r2, c) -> KindPass(Cons(Kind(n, ps), r2), c) }
    }
  }
}
fn marked(ps: List(KP), rows: List(String)) -> List(KP) {
  match ps { Nil -> Nil  Cons(KP(p, r), rest) -> Cons(KP(p, r || has_str(rows, p)), marked(rest, rows)) }
}
fn mark_kps(ps: List(KP), rows: List(String)) -> KindPass {
  match ps {
    Nil -> KindPass(Nil, False)
    Cons(KP(p, r), rest) -> if !r && has_str(rows, p) { KindPass(Nil, True) } else { mark_kps(rest, rows) }
  }
}
fn kind_params(kd: List(Kind), name: String) -> List(KP) {
  match kd { Nil -> Nil  Cons(Kind(n, ps), rest) -> if n == name { ps } else { kind_params(rest, name) } }
}
fn kind_at(kd: List(Kind), name: String, j: Int) -> Bool {
  match kp_at(kind_params(kd, name), j) { Yes(KP(_, r)) -> r  No -> False }
}
fn kp_at(ps: List(KP), j: Int) -> Maybe(KP) {
  match ps { Nil -> No  Cons(p, rest) -> if j == 0 { Yes(p) } else { kp_at(rest, j - 1) } }
}
fn param_name(kd: List(Kind), name: String, j: Int) -> String {
  match kp_at(kind_params(kd, name), j) { Yes(KP(p, _)) -> p  No -> "?" }
}
fn get_kinds(s: St) -> R(List(Kind)) {
  match get_cx(s) { R(Ctx(_, _, _, _, _, Kinds(kd, _)), s2) -> R(kd, s2) }
}
fn effect_kinds(s: St) -> R(List(Kind)) {
  match get_cx(s) { R(Ctx(_, _, _, _, _, Kinds(_, ek)), s2) -> R(ek, s2) }
}
// A declaration's parameters (`decl_params`): each a fresh type variable; a
// row parameter also a fresh row variable, its argument that row's phantom.
// The arguments, the type parameters' variables, the type and the row
// parameters by name, the row parameters' variables.
// And every parameter's type variable with its row variable (-1: a type
// parameter), in order (`effect_params`, `row_params`).
type DeclParams { DeclParams(List(Ty), List(Int), List(Named), List(Arity), List(Int), List(RPair)) }
fn decl_params(s: St, ps: List(KP), acc: DeclParams) -> R(DeclParams) {
  match ps {
    Nil -> match acc { DeclParams(args, vs, pe, re, rvs, all) -> R(DeclParams(rev(args), rev(vs), pe, re, rev(rvs), rev(all)), s) }
    Cons(KP(p, is_row), rest) -> match fresh(s) {
      R(v, s2) -> match acc {
        DeclParams(args, vs, pe, re, rvs, all) -> if is_row {
          let id = match v { TVar(i) -> i  _ -> 0 }
          match fresh_row(s2) { R(rv, s3) -> decl_params(s3, rest, DeclParams(Cons(phantom(ropen(rv)), args), vs, pe, Cons(Arity(p, rv), re), Cons(rv, rvs), Cons(RPair(id, rv), all))) }
        } else {
          let id = match v { TVar(i) -> i  _ -> 0 }
          decl_params(s2, rest, DeclParams(Cons(v, args), Cons(id, vs), Cons(Named(p, v), pe), re, rvs, Cons(RPair(id, 0 - 1), all)))
        }
      }
    }
  }
}
// The constructors' schemes, in declaration order (`infer_all`'s type pass).
fn type_decls(s: St, decls: List(Sp(Decl)), env: List(Entry)) -> R(List(Entry)) {
  match decls {
    Nil -> R(env, s)
    Cons(Sp(DType(name, _, _, variants), _, _), rest) -> match get_kinds(s) {
      R(kd, s1) -> match decl_params(s1, kind_params(kd, name), DeclParams(Nil, Nil, Nil, Nil, Nil, Nil)) {
        R(DeclParams(args, vars, pe, re, rvs, _), s2) -> {
          // Every declared type has its entry, a type without constructors too.
          let s2b = match get_eq(s2) { R(Eqs(ms, rep, adts), s2a) -> set_eq(s2a, Eqs(ms, rep, Cons(Adt(name, vars, Nil), adts))) }
          let s3 = match variants { Nil -> add_empty(s2b, name)  _ -> s2b }
          match ctors(s3, variants, TCon(name, args), vars, rvs, DeclCx(name, pe, re, No), env) {
            R(env2, s4) -> type_decls(s4, rest, env2)
          }
        }
      }
    }
    Cons(_, rest) -> type_decls(s, rest, env)
  }
}
fn ctors(s: St, vs: List(Sp(VariantDecl)), result: Ty, vars: List(Int), rvs: List(Int), cx: DeclCx, env: List(Entry)) -> R(List(Entry)) {
  match vs {
    Nil -> R(env, s)
    Cons(Sp(VariantDecl(cname, fields), _, _), rest) -> match elaborate_adt_list(add_ctor(s, cname, len(fields)), fields, cx, Nil) {
      R(fts, s1) -> {
        let s2 = add_adt_fields(s1, result, vars, fts)
        let t = match fts { Nil -> result  _ -> TFn(fts, pure_row(), result) }
        ctors(s2, rest, result, vars, rvs, cx, Cons(Entry(cname, Scheme(vars, rvs, t)), env))
      }
    }
  }
}

// ---- Expressions ----------------------------------------------------------------

fn is_value(e: Expr) -> Bool {
  match e {
    EVar(_) -> True  EQualified(_, _) -> True  EInt(_) -> True  EFloat -> True
    EStr(_) -> True  EBool(_) -> True  EUnit -> True  ELambda(_, _) -> True  _ -> False
  }
}

fn infer_block(s: St, b: Block, env: List(Entry), amb: Int) -> R(Ty) {
  match b {
    // A block is a scope of its own (Rust's `env.push()`): its mark is read
    // only by `env_mentions`.
    Block(stmts, tail) -> match infer_stmts(s, stmts, Cons(scope_mark(), env), amb) {
      R(env2, s2) -> match tail { No -> R(TB(4), s2)  Yes(t) -> infer_expr(s2, t, env2, amb) }
    }
  }
}
fn infer_stmts(s: St, stmts: List(Sp(Stmt)), env: List(Entry), amb: Int) -> R(List(Entry)) {
  match stmts {
    Nil -> R(env, s)
    Cons(st, rest) -> match st {
      Sp(SExpr(e), _, _) -> match infer_expr(s, e, env, amb) { R(_, s2) -> infer_stmts(s2, rest, env, amb) }
      Sp(SLet(name, ann, value), _, _) -> match infer_expr(add_level(s, 1), value, env, amb) {
        R(t, s2) -> {
          let s3 = add_level(check_ann(s2, ann, t, True), 0 - 1)
          match let_scheme(s3, value, t) { R(sc, s4) -> match value { Sp(_, va, vb) -> infer_stmts(note_binder(s4, va, vb, name, sc), rest, Cons(Entry(name, sc), env), amb) } }
        }
      }
    }
  }
}
// The value restriction (spec 4b-1 §2.4): only a syntactic value is
// generalized; a non-value's variables are the environment's from here on.
fn let_scheme(s: St, value: Sp(Expr), t: Ty) -> R(Scheme) {
  match value {
    Sp(e, _, _) -> if is_value(e) { generalize(s, t) } else {
      match cur_level(s) {
        R(lvl, s2) -> match resolve(lower_levels(s2, t, lvl), t) { R(rt, s3) -> R(Scheme(Nil, Nil, rt), s3) }
      }
    }
  }
}

// Record-then-zonk: every expression's type at its span, after inferring it.
fn infer_expr(s: St, e: Sp(Expr), env: List(Entry), amb: Int) -> R(Ty) {
  match e {
    Sp(node, start, end) -> match infer_inner(s, node, start, end, env, amb) {
      R(t, s2) -> R(t, record(s2, start, end, t))
    }
  }
}

fn binop_left(op: String) -> Ty {
  if op == "+." || op == "-." || op == "*." || op == "/." || op == "<." || op == "<=." || op == ">." || op == ">=." { TB(1) } else {
    if op == "<>" { TB(3) } else { if op == "&&" || op == "||" { TB(2) } else { TB(0) } }
  }
}
fn binop_result(op: String) -> Ty {
  if op == "<" || op == "<=" || op == ">" || op == ">=" || op == "<." || op == "<=." || op == ">." || op == ">=." || op == "&&" || op == "||" { TB(2) } else {
    binop_left(op)
  }
}

fn infer_inner(s: St, node: Expr, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match node {
    EInt(_) -> R(TB(0), s)
    EFloat -> R(TB(1), s)
    EStr(_) -> R(TB(3), s)
    EBool(_) -> R(TB(2), s)
    EUnit -> R(TB(4), s)
    EError -> R(TErr, s)
    EVar(name) -> match lookup(env, name) {
      Yes(sc) -> match instantiate_at(s, sc, start, end) { R(t, s2) -> open_covariant(borrow_value(s2, start, end, t), t) }
      No -> R(TErr, s)
    }
    EQualified(_, _) -> R(TErr, s)
    EUnary(op, x) -> match infer_expr(s, x, env, amb) {
      R(t, s2) -> {
        let want = if op == "!" { TB(2) } else { if op == "-." { TB(1) } else { TB(0) } }
        R(want, unify(s2, t, want, start, end))
      }
    }
    EBinary(op, l, r) -> match infer_expr(s, l, env, amb) {
      R(lt, s2) -> match infer_expr(s2, r, env, amb) {
        R(rt, s3) -> if op == "==" || op == "!=" {
          R(TB(2), require_data(unify(s3, lt, rt, start, end), lt, start, end, Span2(start, end)))
        } else {
          let want = binop_left(op)
          R(binop_result(op), unify(unify(s3, lt, want, start, end), rt, want, start, end))
        }
      }
    }
    EIf(c, tb, eb) -> match infer_expr(s, c, env, amb) {
      R(ct, s2) -> {
        let s3 = match c { Sp(_, cs, ce) -> unify_cond(s2, ct, cs, ce) }
        match infer_block(s3, sp_block(tb), env, amb) {
          R(tt, s4) -> match infer_block(s4, sp_block(eb), env, amb) {
            R(et, s5) -> R(tt, unify(s5, tt, et, start, end))
          }
        }
      }
    }
    EBlock(b) -> infer_block(s, b, env, amb)
    EMatch(x, arms) -> match infer_expr(s, x, env, amb) {
      R(st, s2) -> match fresh(s2) {
        R(result, s3) -> {
          let s4 = match arms { Nil -> match x { Sp(_, xs, xe) -> check_empty_match(s3, st, xs, xe) }  _ -> s3 }
          R(result, infer_arms(s4, arms, st, result, env, amb))
        }
      }
    }
    ECall(callee, args) -> infer_call(s, callee, args, start, end, env, amb)
    EHandle(body, h) -> infer_handle(s, body, h, start, end, env, amb)
    EResume(arg) -> match infer_expr(s, arg, env, amb) { R(at, s2) -> type_resume(s2, at, start, end, amb) }
    ELambda(params, body) -> infer_lambda(s, params, body, env)
  }
}
fn infer_arms(s: St, arms: List(Sp(MatchArm)), st: Ty, result: Ty, env: List(Entry), amb: Int) -> St {
  match arms {
    Nil -> s
    Cons(Sp(MatchArm(pat, body), _, _), rest) -> match check_pattern(s, pat, st, env, env) {
      R(env2, s2) -> match infer_expr(note_pat(s2, pat, env2), body, env2, amb) {
        R(bt, s3) -> match body { Sp(_, bs, be) -> infer_arms(unify(s3, bt, result, bs, be), rest, st, result, env, amb) }
      }
    }
  }
}
// A pattern against the type it must have (`check_pattern`): its bindings
// pushed onto `acc` in order; constructors looked up in `env`.
fn check_pattern(s: St, pat: Sp(Pattern), expected: Ty, env: List(Entry), acc: List(Entry)) -> R(List(Entry)) {
  match pat {
    Sp(node, start, end) -> match node {
      PWild -> R(acc, s)
      PVar(x) -> R(Cons(Entry(x, Scheme(Nil, Nil, expected)), acc), s)
      PInt(_) -> R(acc, unify(s, expected, TB(0), start, end))
      PBool(_) -> R(acc, unify(s, expected, TB(2), start, end))
      PStr(_) -> R(acc, unify(s, expected, TB(3), start, end))
      PUnit -> R(acc, unify(s, expected, TB(4), start, end))
      PCtor(name, args) -> match lookup(env, name) {
        No -> R(acc, s)
        Yes(sc) -> match instantiate(s, sc) {
          R(t, s2) -> {
            let fields = match t { TFn(fs, _, _) -> fs  _ -> Nil }
            let result = match t { TFn(_, _, r) -> r  _ -> t }
            let s3 = unify(s2, result, expected, start, end)
            let nf = len(fields)
            let na = len(args)
            let s4 = if na != nf {
              diag(s3, "E0402", "constructor `" <> name <> "` expects " <> int.to_string(nf) <> " field(s), found " <> int.to_string(na), start, end)
            } else { s3 }
            check_fields(s4, args, fields, env, acc)
          }
        }
      }
    }
  }
}
fn check_fields(s: St, ps: List(Sp(Pattern)), ts: List(Ty), env: List(Entry), acc: List(Entry)) -> R(List(Entry)) {
  match ps {
    Nil -> R(acc, s)
    Cons(p, pr) -> match ts {
      Nil -> R(acc, s)
      Cons(t, tr) -> match check_pattern(s, p, t, env, acc) { R(acc2, s2) -> check_fields(s2, pr, tr, env, acc2) }
    }
  }
}
fn is_empty_type(s: St, name: String) -> R(Bool) {
  match get_cx(s) { R(Ctx(v, k, c, e, ar, kd), s2) -> R(has_str(e, name), s2) }
}
fn check_empty_match(s: St, t: Ty, start: Int, end: Int) -> St {
  match resolve(s, t) {
    R(rt, s2) -> match rt {
      TErr -> s2
      TCon(n, _) -> match is_empty_type(s2, n) { R(e, s3) -> if e { s3 } else { empty_match_error(s3, rt, start, end) } }
      _ -> empty_match_error(s2, rt, start, end)
    }
  }
}
fn empty_match_error(s: St, rt: Ty, start: Int, end: Int) -> St {
  match show(rt, Names(Nil, 0)) {
    Shown(text, _) -> diag(s, "E0430", "a match with no arms needs a scrutinee whose type has no constructors; this is `" <> text <> "`", start, end)
  }
}
fn sp_block(b: Sp(Block)) -> Block { match b { Sp(x, _, _) -> x } }

fn unify_cond(s: St, t: Ty, start: Int, end: Int) -> St {
  match resolve(s, t) {
    R(rt, s2) -> match rt {
      TB(2) -> unify(s2, t, TB(2), start, end)
      TErr -> unify(s2, t, TB(2), start, end)
      TVar(_) -> unify(s2, t, TB(2), start, end)
      _ -> diag(s2, "E0403", "condition must be `Bool`", start, end)
    }
  }
}

fn infer_args(s: St, args: List(Sp(Expr)), env: List(Entry), acc: List(Ty), amb: Int) -> R(List(Ty)) {
  match args {
    Nil -> R(rev(acc), s)
    Cons(a, rest) -> match infer_expr(s, a, env, amb) { R(t, s2) -> infer_args(s2, rest, env, Cons(t, acc), amb) }
  }
}
// A pure builtin's parameters and result (`type_builtin_call`'s pure
// arms), or no parameters and an error for the others.
type Sig { Sig(List(Ty), Ty), NoSig }
fn pure_builtin(m: String, n: String) -> Sig {
  if (m == "int" || m == "float") && n == "to_string" { Sig(Cons(if m == "int" { TB(0) } else { TB(1) }, Nil), TB(3)) } else {
    if m == "float" && n == "of_int" { Sig(Cons(TB(0), Nil), TB(1)) } else {
      if m == "float" && (n == "truncate" || n == "round") { Sig(Cons(TB(1), Nil), TB(0)) } else {
        if m == "string" && n == "length" { Sig(Cons(TB(3), Nil), TB(0)) } else {
          if m == "string" && n == "byte_at" { Sig(Cons(TB(3), Cons(TB(0), Nil)), TB(0)) } else {
            if m == "string" && n == "slice" { Sig(Cons(TB(3), Cons(TB(0), Cons(TB(0), Nil))), TB(3)) } else {
              if m == "int" && (n == "wrapping_add" || n == "wrapping_sub" || n == "wrapping_mul" || n == "and" || n == "or" || n == "xor" || n == "shl" || n == "shr" || n == "ushr") {
                Sig(Cons(TB(0), Cons(TB(0), Nil)), TB(0))
              } else { NoSig }
            }
          }
        }
      }
    }
  }
}
fn host_signature(m: String, n: String) -> Sig {
  if m == "io" {
    if n == "println" { Sig(Cons(TB(3), Nil), TB(4)) } else {
      if n == "read_file" { Sig(Cons(TB(3), Nil), TB(3)) } else {
        if n == "file_exists" { Sig(Cons(TB(3), Nil), TB(2)) } else {
          if n == "write_file" { Sig(Cons(TB(3), Cons(TB(3), Nil)), TB(4)) } else {
            if n == "read_stdin" { Sig(Nil, TB(3)) } else {
              if n == "arg_count" { Sig(Nil, TB(0)) } else { if n == "arg" { Sig(Cons(TB(0), Nil), TB(3)) } else { if n == "run" { Sig(Cons(TB(3), Nil), TB(0)) } else { NoSig } } }
            }
          }
        }
      }
    }
  } else {
    if m == "time" && n == "now_ms" { Sig(Nil, TB(0)) } else { if m == "time" && n == "sleep_ms" { Sig(Cons(TB(0), Nil), TB(4)) } else { NoSig } }
  }
}
// The array builtins (spec 2026-11-14-elya-arrays-and-borrowing D2), pure,
// at a fresh element type; where an array is made its element must be
// duplicable (D1: a read copies one out).
fn array_call(s: St, n: String, args: List(Sp(Expr)), cs: Int, ce: Int, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match infer_args(s, args, env, Nil, amb) {
    R(ts, s1) -> match fresh(s1) {
      R(a, s2) -> {
        let xs = TCon("Array", Cons(a, Nil))
        let params = if n == "new" { Nil } else { if n == "push" { Cons(xs, Cons(a, Nil)) } else { if n == "set" { Cons(xs, Cons(TB(0), Cons(a, Nil))) } else { if n == "get" { Cons(xs, Cons(TB(0), Nil)) } else { Cons(xs, Nil) } } } }
        let ret = if n == "new" || n == "push" || n == "set" { xs } else { if n == "get" { a } else { TB(0) } }
        let want = TFn(params, pure_row(), ret)
        let s3 = unify(s2, want, TFn(ts, pure_row(), ret), start, end)
        let s4 = if n == "new" { require_dup(s3, a, Mark("", start, end, KElement, 0 - 1, 0 - 1), Nil) } else { s3 }
        R(ret, record(s4, cs, ce, want))
      }
    }
  }
}
fn buffer_call(s: St, n: String, args: List(Sp(Expr)), cs: Int, ce: Int, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match infer_args(s, args, env, Nil, amb) {
    R(ts, s1) -> {
      let bt = TCon("Buffer", Nil)
      let params = if n == "new" { Nil } else { if n == "push" { Cons(bt, Cons(TB(3), Nil)) } else { Cons(bt, Nil) } }
      let ret = if n == "new" || n == "push" { bt } else { if n == "finish" { TB(3) } else { TB(0) } }
      let want = TFn(params, pure_row(), ret)
      R(ret, record(unify(s1, want, TFn(ts, pure_row(), ret), start, end), cs, ce, want))
    }
  }
}
// The builtins on a `with any` clause's operation: `o : Op(t, fn() / H ->
// t)`; `op.perform` performs `H`.
fn op_ty(t: Ty, h: Int) -> Ty { TCon("$Op", Cons(t, Cons(TFn(Nil, ropen(h), t), Nil))) }
fn op_builtin(s: St, n: String, args: List(Sp(Expr)), cs: Int, ce: Int, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match infer_args(s, args, env, Nil, amb) {
    R(ts, s1) -> match fresh(s1) {
      R(t, s2) -> match fresh_row(s2) {
        R(h, s3) -> {
          let o = op_ty(t, h)
          let params = if n == "encode" { Cons(o, Cons(t, Nil)) } else { if n == "decode" { Cons(o, Cons(TB(3), Nil)) } else { Cons(o, Nil) } }
          let ret = if n == "name" || n == "show" || n == "encode" { TB(3) } else { t }
          let s4 = unify(s3, TFn(params, pure_row(), ret), TFn(ts, pure_row(), ret), start, end)
          let s5 = if n == "perform" {
            match resolve_row(s4, ropen(h)) { R(performed, s4b) -> hold_point(surface(add_row(s4b, amb, performed, start, end)), start, end, performed) }
          } else { s4 }
          R(ret, record(s5, cs, ce, TFn(params, if n == "perform" { ropen(h) } else { pure_row() }, ret)))
        }
      }
    }
  }
}
fn infer_call(s: St, callee: Sp(Expr), args: List(Sp(Expr)), start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match callee {
    Sp(EQualified(m, n), cs, ce) -> if m == "array" && (n == "new" || n == "push" || n == "set" || n == "get" || n == "length") { array_call(s, n, args, cs, ce, start, end, env, amb) } else { if m == "buffer" && (n == "new" || n == "push" || n == "finish" || n == "length") { buffer_call(s, n, args, cs, ce, start, end, env, amb) } else { match host_signature(m, n) {
      // The host's builtins perform `IO` (`type_builtin_call`).
      Sig(params, ret) -> match infer_args(s, args, env, Nil, amb) {
        R(ts, s2) -> {
          let s3 = unify(s2, TFn(params, pure_row(), ret), TFn(ts, pure_row(), ret), start, end)
          let s4 = surface(add_effect(s3, amb, "IO", start, end))
          R(ret, record(s4, cs, ce, TFn(params, Row(Cons(Lab("IO", Nil, cs, ce), Nil), RClosed), ret)))
        }
      }
      NoSig -> if m == "op" && (n == "name" || n == "show" || n == "perform" || n == "encode" || n == "decode") { op_builtin(s, n, args, cs, ce, start, end, env, amb) } else { match pure_builtin(m, n) {
        NoSig -> R(TErr, s)
        Sig(params, ret) -> match infer_args(s, args, env, Nil, amb) {
          R(ts, s2) -> {
            let want = TFn(params, pure_row(), ret)
            R(ret, record(unify(s2, want, TFn(ts, pure_row(), ret), start, end), cs, ce, want))
          }
        }
      } }
    } } }
    Sp(EVar(name), cs, ce) -> match ctor_arity(s, name) {
      R(k, s1) -> if k >= 0 {
        match infer_args(s1, args, env, Nil, amb) { R(ts, s2) -> ctor_call(s2, name, k, ts, start, end, env) }
      } else {
        // An operation's name not bound in scope is a perform.
        let op = match lookup(env, name) { Yes(_) -> R(No, s1)  No -> find_op(s1, name) }
        match op {
          R(Yes(info), s2) -> type_perform(s2, info, args, cs, ce, start, end, env, amb)
          R(No, s2) -> ordinary(s2, name, cs, ce, args, start, end, env, amb)
        }
      }
    }
    _ -> match infer_expr(s, callee, env, amb) { R(ft, s2) -> call_with(s2, ft, args, start, end, env, amb) }
  }
}
fn ctor_call(s: St, name: String, k: Int, ts: List(Ty), start: Int, end: Int, env: List(Entry)) -> R(Ty) {
  if len(ts) != k {
    let plural = if k == 1 { "" } else { "s" }
    R(TErr, diag(s, "E0433", "constructor `" <> name <> "` takes " <> int.to_string(k) <> " argument" <> plural <> " but was applied to a different number", start, end))
  } else {
    match lookup(env, name) {
      No -> R(TErr, s)
      Yes(sc) -> match instantiate(s, sc) {
        R(t, s2) -> match t {
          TFn(ps, _, result) -> R(result, unify_each(s2, ts, ps, start, end))
          _ -> R(t, s2)
        }
      }
    }
  }
}
// Each argument against its parameter, as far as both go.
fn unify_each(s: St, xs: List(Ty), ys: List(Ty), start: Int, end: Int) -> St { unify_pairs(s, xs, ys, start, end) }
// An ordinary call (`callee_scheme_type`, `type_ordinary_call`): the
// callee's instantiated type recorded at its span.
fn ordinary(s: St, name: String, cs: Int, ce: Int, args: List(Sp(Expr)), start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  let f = match lookup(env, name) {
    Yes(sc) -> match instantiate_at(s, sc, start, end) { R(t, s2) -> R(t, record(s2, cs, ce, t)) }
    No -> R(TErr, s)
  }
  match f { R(ft, s2) -> call_with(s2, ft, args, start, end, env, amb) }
}
// `type_ordinary_call`: the callee against a fresh arrow whose row is a
// phantom. Its labels reach the ambient row now; its tail through a pending
// inclusion when it is still a phantom nothing in scope relays, or deferred
// when it is a group member's row inside a lambda or a handled body, or
// else relayed.
fn call_with(s: St, f: Ty, args: List(Sp(Expr)), start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match infer_args(s, args, env, Nil, amb) {
    R(ts, s2) -> match fresh(s2) {
      R(result, s3) -> match fresh_phantom(s3) {
        R(cr, s4) -> {
          let s5 = unify(s4, f, TFn(ts, ropen(cr), result), start, end)
          match resolve_row(s5, ropen(cr)) {
            R(Row(ls, t), s6a) -> match hold_point(s6a, start, end, Row(ls, t)) { s6 -> match t {
              ROpen(v) -> match call_open(s6, v, amb, start, end) {
                R(keep, s7) -> R(result, surface(add_row(s7, amb, Row(ls, if keep { t } else { RClosed }), start, end)))
              }
              _ -> R(result, surface(add_row(s6, amb, Row(ls, t), start, end)))
            } }
          }
        }
      }
    }
  }
}
// Whether the call's tail `v` is relayed into the ambient row, or else
// recorded as an inclusion.
fn call_open(s: St, v: Int, amb: Int, start: Int, end: Int) -> R(Bool) {
  match get_gx(s) {
    R(Gx(incl, mincl, ptys, regions, deferred, gparams, gambs), s2) -> match rows_in(s2, ptys, Nil) {
      R(in_params, s3) -> match is_phantom(s3, v) {
        R(ph, s4) -> if ph && !has_int(in_params, v) {
          R(False, set_gx(s4, Gx(append(incl, Cons(Incl(v, amb, start, end), Nil)), mincl, ptys, regions, deferred, gparams, gambs)))
        } else {
          if has_int(in_params, v) { R(True, s4) } else {
            match member_in_lambda(s4, v, amb) {
              R(m, s5) -> if m >= 0 {
                match get_gx(s5) {
                  R(Gx(i2, mi2, p2, r2, d2, gp2, ga2), s6) -> R(False, set_gx(s6, Gx(i2, append(mi2, Cons(Incl(m, amb, start, end), Nil)), p2, r2, d2, gp2, ga2)))
                }
              } else { R(True, s5) }
            }
          }
        }
      }
    }
  }
}
// `member_in_handle_body`: inside a lambda or a handled body (a region
// that includes), a call whose row is a group member's, not relayed by the
// group's parameters, is deferred. The member's ambient row, or -1.
fn member_in_lambda(s: St, v: Int, amb: Int) -> R(Int) {
  match get_gx(s) {
    R(Gx(_, _, _, regions, _, gparams, gambs), s2) -> match regions {
      Nil -> R(0 - 1, s2)
      Cons(Region(region, includes), _) -> if !includes { R(0 - 1, s2) } else {
        match rhead(s2, ROpen(amb)) {
          R(at, s3) -> match rhead(s3, ROpen(region)) {
            R(rt, s4) -> if !tail_eq(at, rt) || tail_eq(at, ROpen(v)) { R(0 - 1, s4) } else {
              match rows_in(s4, gparams, Nil) {
                R(relayed, s5) -> if has_int(relayed, v) { R(0 - 1, s5) } else { member_with(s5, gambs, v) }
              }
            }
          }
        }
      }
    }
  }
}
fn member_with(s: St, ambs: List(Int), v: Int) -> R(Int) {
  match ambs {
    Nil -> R(0 - 1, s)
    Cons(m, rest) -> match rhead(s, ROpen(m)) { R(t, s2) -> if tail_eq(t, ROpen(v)) { R(m, s2) } else { member_with(s2, rest, v) } }
  }
}

// `open_covariant`: a value's closed arrows get an upcast tail, down its
// results.
fn open_covariant(s: St, t: Ty) -> R(Ty) {
  match resolve(s, t) { R(rt, s2) -> open_arrows(s2, rt) }
}
fn open_arrows(s: St, t: Ty) -> R(Ty) {
  match t {
    TFn(ps, rw, r) -> {
      let opened = match rw {
        Row(ls, RClosed) -> match fresh_phantom(s) { R(w, s2) -> R(Row(ls, ROpen(w)), s2) }
        _ -> R(rw, s)
      }
      match opened { R(rw2, s2) -> match open_arrows(s2, r) { R(r2, s3) -> R(TFn(ps, rw2, r2), s3) } }
    }
    _ -> R(t, s)
  }
}

// ---- Lambdas (`lambda_enter`, `lambda_exit`) ------------------------------

fn infer_lambda(s: St, params: List(Sp(Param)), body: Sp(Block), env: List(Entry)) -> R(Ty) {
  match lambda_params(s, params, env, Nil) {
    R(LamIn(env2, pts), s2) -> match fresh_row(s2) {
      R(lam, s3) -> match get_gx(s3) {
        R(Gx(incl, mincl, ptys, regions, deferred, gparams, gambs), s4) -> {
          let s5 = add_depth(set_gx(s4, Gx(incl, mincl, append(ptys, pts), Cons(Region(lam, True), regions), deferred, gparams, gambs)), 1)
          match infer_block(s5, sp_block(body), env2, lam) {
            R(bt, s6) -> match get_gx(add_depth(s6, 0 - 1)) {
              R(Gx(i7, mi7, _, r7, d7, gp7, ga7), s7) -> {
                let regions2 = match r7 { Cons(_, rest) -> rest  Nil -> Nil }
                lambda_exit(flush(set_gx(s7, Gx(i7, mi7, ptys, regions2, d7, gp7, ga7))), lam, append(ptys, pts), pts, bt)
              }
            }
          }
        }
      }
    }
  }
}
fn add_depth(s: St, d: Int) -> St {
  match get_hx(s) { R(Hx(rs, cr, depth, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(rs, cr, depth + d, ops, effs, dead, mu, gn, af)) }
}
type LamIn { LamIn(List(Entry), List(Ty)) }
fn lambda_params(s: St, params: List(Sp(Param)), env: List(Entry), acc: List(Ty)) -> R(LamIn) {
  match params {
    Nil -> R(LamIn(env, rev(acc)), s)
    Cons(Sp(Param(name, ann, _), start, end), rest) -> match fresh(s) {
      R(pv, s2) -> {
        let s3 = check_ann(record(note_binder(s2, start, end, name, Scheme(Nil, Nil, pv)), start, end, pv), ann, pv, False)
        lambda_params(s3, rest, Cons(Entry(name, Scheme(Nil, Nil, pv)), env), Cons(pv, acc))
      }
    }
  }
}
fn lambda_exit(s: St, lam: Int, scope: List(Ty), pts: List(Ty), bt: Ty) -> R(Ty) {
  match rhead(s, ROpen(lam)) {
    R(lt, s2) -> match get_gx(s2) {
      R(Gx(incl, mincl, ptys, regions, deferred, gparams, gambs), s3) -> match includes_member(s3, mincl, lt) {
        R(inc, s4) -> {
          let open = match lt { ROpen(_) -> True  _ -> False }
          let s5 = if inc && open {
            set_gx(s4, Gx(incl, mincl, ptys, regions, append(deferred, Cons(Deferred(lam, scope), Nil)), gparams, gambs))
          } else { close_residual(s4, lam, scope) }
          match resolve_row(s5, ropen(lam)) {
            R(row, s6) -> match row {
              Row(ls, RClosed) -> match fresh_phantom(s6) { R(w, s7) -> R(TFn(pts, Row(ls, ROpen(w)), bt), s7) }
              _ -> R(TFn(pts, row, bt), s6)
            }
          }
        }
      }
    }
  }
}
fn includes_member(s: St, mincl: List(Incl), lt: Tail) -> R(Bool) {
  match mincl {
    Nil -> R(False, s)
    Cons(Incl(_, dst, _, _), rest) -> match rhead(s, ROpen(dst)) {
      R(t, s2) -> if tail_eq(t, lt) { R(True, s2) } else { includes_member(s2, rest, lt) }
    }
  }
}
// `close_unrelayed_residual`: an ambient row nothing in `params` relays
// closes to pure, unless a handle's clauses row still being filled ends
// in it.
fn close_residual(s: St, amb: Int, params: List(Ty)) -> St {
  match rhead(s, ROpen(amb)) {
    R(t, s2) -> match t {
      ROpen(rho) -> match get_hx(s2) {
        R(Hx(_, crs, _, _, _, _, _, _, _), s3) -> match tail_in(s3, crs, rho) {
          R(pending, s4) -> if pending { s4 } else {
            match rows_in(s4, params, Nil) {
              R(in_params, s5) -> if has_int(in_params, rho) { s5 } else { bind_row(s5, rho, pure_row(), 0, 0) }
            }
          }
        }
      }
      _ -> s2
    }
  }
}
// Whether one of the rows `rs` ends in `v` now.
fn tail_in(s: St, rs: List(Int), v: Int) -> R(Bool) {
  match rs {
    Nil -> R(False, s)
    Cons(r, rest) -> match rhead(s, ROpen(r)) { R(t, s2) -> if tail_eq(t, ROpen(v)) { R(True, s2) } else { tail_in(s2, rest, v) } }
  }
}

// ---- Inclusions (`flush_inclusions`) ----------------------------------------

// Each pending inclusion in order, again until nothing more gets in: a
// pass over all of them reaches what src/types.rs's queue of the woken
// ones reaches, in the same order, since one that nothing woke adds
// nothing. A label that meets a closed row is reported once and its
// inclusion is dead (`incl_dead`); a member inclusion is dropped instead.
fn incl_eq(x: Incl, y: Incl) -> Bool {
  match x { Incl(a, b, c, d) -> match y { Incl(e, f, g, h) -> a == e && b == f && c == g && d == h } }
}
fn has_incl(xs: List(Incl), x: Incl) -> Bool {
  match xs { Nil -> False  Cons(y, rest) -> incl_eq(x, y) || has_incl(rest, x) }
}
fn without_incls(xs: List(Incl), gone: List(Incl)) -> List(Incl) {
  match xs { Nil -> Nil  Cons(x, rest) -> if has_incl(gone, x) { without_incls(rest, gone) } else { Cons(x, without_incls(rest, gone)) } }
}
fn get_dead(s: St) -> R(List(Incl)) {
  match get_hx(s) { R(Hx(_, _, _, _, _, dead, mu, gn, af), s2) -> R(dead, s2) }
}
fn kill_incl(s: St, x: Incl) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(rs, cr, d, ops, effs, Cons(x, dead), mu, gn, af)) }
}
fn flush(s: St) -> St {
  match row_count(s) {
    R(n0, s0) -> match get_gx(s0) {
      R(Gx(incl, _, _, _, _, gparams, _), s1) -> match flush_incl(s1, incl, False) {
        R(c1, s2) -> match rows_in(s2, gparams, Nil) {
          R(relayed, s3) -> match get_gx(s3) {
            R(Gx(_, mincl, _, _, _, _, _), s4) -> match flush_member(s4, mincl, relayed, c1, Nil) {
              R(Flushed(c2, gone), s5) -> match get_gx(s5) {
                R(Gx(i6, mi6, p6, r6, d6, gp6, ga6), s6) -> match row_count(set_gx(s6, Gx(i6, without_incls(mi6, gone), p6, r6, d6, gp6, ga6))) {
                  R(n1, s7) -> if c2 || n1 != n0 { flush(s7) } else { s7 }
                }
              }
            }
          }
        }
      }
    }
  }
}
type Flushed { Flushed(Bool, List(Incl)) }
fn flush_incl(s: St, xs: List(Incl), changed: Bool) -> R(Bool) {
  match xs {
    Nil -> R(changed, s)
    Cons(x, rest) -> match get_dead(s) {
      R(dead, s1) -> if has_incl(dead, x) { flush_incl(s1, rest, changed) } else {
        match x {
          Incl(src, dst, a, b) -> match resolve_row(s1, ropen(dst)) {
            R(Row(hl, ht), s2) -> if tail_eq(ht, RError) { flush_incl(kill_incl(s2, x), rest, changed) } else {
              match resolve_row(s2, ropen(src)) {
                R(Row(wl, wt), s3) -> match relay_incl(s3, dst, ht, wt, a, b) {
                  R(c1, s4) -> match incl_labels(s4, x, dst, hl, wl, a, b, False) {
                    R(c2, s5) -> flush_incl(s5, rest, changed || c1 || c2)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
// A recorded tail that has since become meaningful is a relay after all.
fn relay_incl(s: St, dst: Int, have: Tail, want: Tail, a: Int, b: Int) -> R(Bool) {
  match want {
    ROpen(w) -> match is_phantom(s, w) {
      R(ph, s2) -> if !ph && !tail_eq(have, ROpen(w)) {
        match add_row(s2, dst, ropen(w), a, b) { R(c, s3) -> R(match c { Nil -> True  _ -> False }, surface(R(c, s3))) }
      } else { R(False, s2) }
    }
    _ -> R(False, s)
  }
}
fn incl_labels(s: St, x: Incl, dst: Int, have: List(Lab), want: List(Lab), a: Int, b: Int, changed: Bool) -> R(Bool) {
  match want {
    Nil -> R(changed, s)
    Cons(Lab(n, args, _, _), rest) -> if has_lab(have, n) { incl_labels(s, x, dst, have, rest, a, b, changed) } else {
      match add_effect_args(s, dst, n, args, a, b) {
        R(c, s2) -> match c {
          Nil -> incl_labels(s2, x, dst, have, rest, a, b, True)
          _ -> incl_labels(surface(R(c, kill_incl(s2, x))), x, dst, have, rest, a, b, changed)
        }
      }
    }
  }
}
fn flush_member(s: St, xs: List(Incl), relayed: List(Int), changed: Bool, gone: List(Incl)) -> R(Flushed) {
  match xs {
    Nil -> R(Flushed(changed, gone), s)
    Cons(x, rest) -> match x {
      Incl(src, dst, a, b) -> match resolve_row(s, ropen(dst)) {
        R(Row(hl, ht), s2) -> if tail_eq(ht, RError) { flush_member(s2, rest, relayed, changed, gone) } else {
          match resolve_row(s2, ropen(src)) {
            R(Row(wl, wt), s3) -> {
              let relay = match wt { ROpen(w) -> has_int(relayed, w) && !tail_eq(ht, ROpen(w))  _ -> False }
              let r1 = if relay {
                match wt {
                  ROpen(w) -> match unify_row(s3, ropen(dst), ropen(w), a, b) {
                    R(c, s4) -> match c { Nil -> R(Flushed(True, gone), s4)  _ -> R(Flushed(changed, Cons(x, gone)), surface(R(c, s4))) }
                  }
                  _ -> R(Flushed(changed, gone), s3)
                }
              } else { R(Flushed(changed, gone), s3) }
              match r1 {
                R(Flushed(c1, g1), s5) -> match member_labels(s5, x, dst, hl, wl, a, b, c1, g1) {
                  R(Flushed(c2, g2), s6) -> flush_member(s6, rest, relayed, c2, g2)
                }
              }
            }
          }
        }
      }
    }
  }
}
fn member_labels(s: St, x: Incl, dst: Int, have: List(Lab), want: List(Lab), a: Int, b: Int, changed: Bool, gone: List(Incl)) -> R(Flushed) {
  match want {
    Nil -> R(Flushed(changed, gone), s)
    // The same effect on both sides: its arguments must agree, a conflict
    // reported once.
    Cons(Lab(n, args, _, _), rest) -> match lab_get(have, n) {
      Yes(Lab(_, hargs, _, _)) -> match diag_count(s) {
        R(before, s1) -> match diag_count(unify_effect_args(s1, n, hargs, args, a, b)) {
          R(after, s2) -> member_labels(s2, x, dst, have, rest, a, b, changed, if after > before { Cons(x, gone) } else { gone })
        }
      }
      No -> match add_effect_args(s, dst, n, args, a, b) {
        R(c, s2) -> match c {
          Nil -> member_labels(s2, x, dst, have, rest, a, b, True, gone)
          _ -> member_labels(surface(R(c, s2)), x, dst, have, rest, a, b, changed, Cons(x, gone))
        }
      }
    }
  }
}

// ---- Effects: performs, handlers, `resume` ------------------------------------

fn op_get(ops: List(OpInfo), name: String) -> Maybe(OpInfo) {
  match ops { Nil -> No  Cons(OpInfo(n, e, ep, ps, r), rest) -> if n == name { Yes(OpInfo(n, e, ep, ps, r)) } else { op_get(rest, name) } }
}
fn find_op(s: St, name: String) -> R(Maybe(OpInfo)) {
  match get_hx(s) { R(Hx(_, _, _, ops, _, _, _, _, _), s2) -> R(op_get(ops, name), s2) }
}
// The effect declarations' operations (`ops`), after every type: each
// operation's parameters and result as a declaration's fields are read.
// Each effect's parameters fresh, shared by its operations' signatures
// (read as a declaration's fields are); a row parameter a row variable, and
// the effect's own label in its declaration carries its arguments.
fn effect_decls(s: St, decls: List(Sp(Decl))) -> St {
  match decls {
    Nil -> s
    Cons(Sp(DEffect(name, _, _, sigs), _, _), rest) -> match effect_kinds(s) {
      R(ek, s1) -> match decl_params(s1, kind_params(ek, name), DeclParams(Nil, Nil, Nil, Nil, Nil, Nil)) {
        R(DeclParams(args, _, pe, re, _, all), s2) -> effect_decls(op_sigs(s2, name, all, DeclCx(name, pe, re, Yes(args)), sigs), rest)
      }
    }
    Cons(_, rest) -> effect_decls(s, rest)
  }
}
fn op_sigs(s: St, eff: String, all: List(RPair), cx: DeclCx, sigs: List(Sp(OpSig))) -> St {
  match sigs {
    Nil -> s
    Cons(Sp(OpSig(name, _, ptys, ret), _, _), rest) -> match elaborate_adt_list(s, ptys, cx, Nil) {
      R(ps, s2) -> match elaborate_adt(s2, ret, cx) {
        R(rt, s3) -> match get_hx(s3) {
          R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s4) -> op_sigs(set_hx(s4, Hx(rs, cr, d, Cons(OpInfo(name, eff, all, ps, rt), ops), effs, dead, mu, gn, af)), eff, all, cx, rest)
        }
      }
    }
  }
}
// The effects declared `multi` (a `with multi` handler needs one).
fn multi_names(decls: List(Sp(Decl)), acc: List(String)) -> List(String) {
  match decls {
    Nil -> acc
    Cons(Sp(DEffect(name, _, True, _), _, _), rest) -> multi_names(rest, Cons(name, acc))
    Cons(_, rest) -> multi_names(rest, acc)
  }
}
fn is_multi(s: St, name: String) -> R(Bool) {
  match get_hx(s) { R(Hx(_, _, _, _, _, _, mu, gn, af), s2) -> R(has_str(mu, name), s2) }
}
fn effect_names(decls: List(Sp(Decl)), acc: List(String)) -> List(String) {
  match decls {
    Nil -> acc
    Cons(Sp(DEffect(name, _, _, _), _, _), rest) -> effect_names(rest, Cons(name, acc))
    Cons(_, rest) -> effect_names(rest, acc)
  }
}
// `type_perform`: the callee is the operation at its effect's closed row;
// the arguments against its parameters; the effect reaches the ambient row.
fn type_perform(s: St, op: OpInfo, args: List(Sp(Expr)), cs: Int, ce: Int, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match op {
    // The effect's parameters instantiated fresh before the arguments are
    // inferred (`instantiate_op`).
    OpInfo(_, eff, all, ps0, ret0) -> match fresh_effect_args(s, all, EffArgs(Nil, Nil, Nil)) {
      R(EffArgs(eargs, m, rm), s1) -> {
        let ps = match all { Nil -> ps0  _ -> subst_list(ps0, m, rm, Nil) }
        let ret = match all { Nil -> ret0  _ -> subst(ret0, m, rm) }
        match infer_args(s1, args, env, Nil, amb) {
          R(ts, s2) -> {
            let s3 = record(s2, cs, ce, TFn(ps, Row(Cons(Lab(eff, eargs, cs, ce), Nil), RClosed), ret))
            let s4 = unify(s3, TFn(ps, pure_row(), ret), TFn(ts, pure_row(), ret), start, end)
            R(ret, hold_point(surface(add_effect_args(s4, amb, eff, eargs, start, end)), start, end, Row(Cons(Lab(eff, Nil, cs, ce), Nil), RClosed)))
          }
        }
      }
    }
  }
}
// Fresh arguments for an effect: a type variable per type parameter, a
// fresh row's phantom per row parameter, and the substitutions taking the
// declaration's variables to them (`fresh_effect_args`).
type EffArgs { EffArgs(List(Ty), List(Pair), List(RPair)) }
fn fresh_effect_args(s: St, all: List(RPair), acc: EffArgs) -> R(EffArgs) {
  match all {
    Nil -> match acc { EffArgs(args, m, rm) -> R(EffArgs(rev(args), m, rm), s) }
    Cons(RPair(p, rv), rest) -> match acc {
      EffArgs(args, m, rm) -> if rv >= 0 {
        match fresh_row(s) {
          R(f, s2) -> {
            let a = phantom(ropen(f))
            fresh_effect_args(s2, rest, EffArgs(Cons(a, args), Cons(Pair(p, a), m), Cons(RPair(rv, f), rm)))
          }
        }
      } else {
        match fresh(s) { R(a, s2) -> fresh_effect_args(s2, rest, EffArgs(Cons(a, args), Cons(Pair(p, a), m), rm)) }
      }
    }
  }
}
// `handler_effect`: the one effect a handler's clauses cover; a clause of
// another is E0423 at the clause. "" when none is known.
fn handler_effect(s: St, cs: List(Sp(OpClause)), found: String) -> R(String) {
  match cs {
    Nil -> R(found, s)
    Cons(Sp(OpClause(qual, op, _, _), a, b), rest) -> {
      let known = match qual { Yes(e) -> R(e, s)  No -> match find_op(s, op) { R(m, s2) -> R(match m { Yes(OpInfo(_, e, _, _, _)) -> e  No -> "" }, s2) } }
      match known {
        R(e, s2) -> if e == "" { handler_effect(s2, rest, found) } else {
          if found == "" { handler_effect(s2, rest, e) } else {
            if found == e { handler_effect(s2, rest, found) } else { handler_effect(diag(s2, "E0423", "a handler must cover a single effect", a, b), rest, found) }
          }
        }
      }
    }
  }
}
fn push_region(s: St, r: Region) -> St {
  match get_gx(s) { R(Gx(i, mi, p, rs, d, gp, ga), s2) -> set_gx(s2, Gx(i, mi, p, Cons(r, rs), d, gp, ga)) }
}
fn pop_region(s: St) -> St {
  match get_gx(s) { R(Gx(i, mi, p, rs, d, gp, ga), s2) -> set_gx(s2, Gx(i, mi, p, match rs { Cons(_, rest) -> rest  Nil -> Nil }, d, gp, ga)) }
}
fn get_ptys(s: St) -> R(List(Ty)) {
  match get_gx(s) { R(Gx(_, _, p, _, _, _, _), s2) -> R(p, s2) }
}
fn remove_lab(xs: List(Lab), n: String) -> List(Lab) {
  match xs { Nil -> Nil  Cons(l, rest) -> if lab_name(l) == n { rest } else { Cons(l, remove_lab(rest, n)) } }
}
// `infer_handle` (not `with any`): the body in a row holding the handled
// effect; the return clause, then each operation clause, in rows of their
// own; what they perform reaches the ambient row, and the clauses' labels
// the clauses row an escaped `resume` reads.
fn infer_handle(s: St, body: Sp(Expr), h: Handler, start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match h {
    Handler(_, True, clauses, ret) -> infer_any_handle(s, body, clauses, ret, start, end, env, amb)
    Handler(many, _, clauses, ret) -> match one_shot(handler_effect(s, clauses, ""), many, start, end) {
      R(eff, s0) -> match handle_args(s0, eff) {
      R(EffArgs(eargs, em, erm), s1) -> match fresh_row(s1) {
        R(amb_in, s2) -> {
          let s3 = if eff == "" { s2 } else { surface(add_effect_args(s2, amb_in, eff, eargs, start, end)) }
          match infer_expr(push_region(s3, Region(amb_in, True)), body, env, amb_in) {
            R(body_ty, s4) -> match fresh(pop_region(s4)) {
              R(result, s5) -> match fresh_row(s5) {
                R(ret_amb, s6) -> {
                  let s7 = match ret {
                    Yes(ReturnClause(binder, rbody)) -> match infer_expr(push_region(note_ret(s6, binder, rbody, body_ty), Region(ret_amb, False)), rbody, Cons(Entry(binder, Scheme(Nil, Nil, body_ty)), env), ret_amb) {
                      R(ret_ty, s6b) -> match rbody { Sp(_, rs, re) -> unify(pop_region(s6b), ret_ty, result, rs, re) }
                    }
                    No -> unify(s6, result, body_ty, start, end)
                  }
                  match get_ptys(flush(s7)) {
                    R(scope, s8) -> match resolve_row(close_residual(s8, ret_amb, scope), ropen(ret_amb)) {
                      R(ret_row, s9) -> match fresh_row(surface(add_row(s9, amb, ret_row, start, end))) {
                        R(clauses_row, s10) -> match push_clause_row(s10, clauses_row) {
                          s11 -> match op_clauses(s11, clauses, Resume(TErr, result, amb_in, ret_amb, eff, 0, clauses_row), EffArgs(eargs, em, erm), env, amb, Nil) {
                            R(cambs, s12) -> {
                              let s13 = flush(clause_labels(pop_clause_row(s12), rev(cambs), clauses_row, eff, start, end))
                              match rhead(s13, ROpen(amb)) {
                                R(own, s14) -> match rhead(s14, ROpen(clauses_row)) {
                                  R(ct, s15) -> {
                                    let s16 = if tail_eq(ct, own) { s15 } else { match get_ptys(s15) { R(sp, s15b) -> close_residual(s15b, clauses_row, sp) } }
                                    match resolve_row(if many { repeats(s16, amb_in, start, end) } else { s16 }, ropen(amb_in)) {
                                      R(Row(ls, t), s17) -> {
                                        let residual = Row(remove_lab(ls, eff), t)
                                        let s18 = surface(add_row(s17, amb, residual, start, end))
                                        // What escapes the handle holds what its points hold (D3).
                                        R(result, hold_handle(s18, start, end, Cons(residual, Cons(ropen(ret_amb), ropens(rev(cambs))))))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  }
}
// `infer_any_handle`: a `with any` handler handles every effect its body
// performs but `IO`. Each clause's operation is an `Op(t, fn() / H -> t)`
// of a rigid answer type `'tN` its own; what it handles must be data
// (E0434, when the group is solved), and an answer type may not escape its
// clause (E0435).
type Skol { Skol(String, Int, Int) }
fn infer_any_handle(s: St, body: Sp(Expr), clauses: List(Sp(OpClause)), ret: Maybe(ReturnClause), start: Int, end: Int, env: List(Entry), amb: Int) -> R(Ty) {
  match fresh_row(s) {
    R(amb_in, s1) -> match infer_expr(push_region(s1, Region(amb_in, True)), body, env, amb_in) {
      R(body_ty, s2) -> match fresh(pop_region(s2)) {
        R(result, s3) -> match fresh_row(s3) {
          R(ret_amb, s4) -> {
            let s5 = match ret {
              Yes(ReturnClause(binder, rbody)) -> match infer_expr(push_region(note_ret(s4, binder, rbody, body_ty), Region(ret_amb, False)), rbody, Cons(Entry(binder, Scheme(Nil, Nil, body_ty)), env), ret_amb) {
                R(ret_ty, s4b) -> match rbody { Sp(_, rs, re) -> unify(pop_region(s4b), ret_ty, result, rs, re) }
              }
              No -> unify(s4, result, body_ty, start, end)
            }
            match get_ptys(flush(s5)) {
              R(scope, s6) -> match resolve_row(close_residual(s6, ret_amb, scope), ropen(ret_amb)) {
                R(ret_row, s7) -> match resolve_row(surface(add_row(s7, amb, ret_row, start, end)), ropen(amb_in)) {
                  // The handled row: the body's, but `IO`.
                  R(Row(bl, bt), s8) -> {
                    let hl = remove_lab(bl, "IO")
                    match fresh_row(s8) {
                      R(clauses_row, s9) -> match any_clauses(push_clause_row(s9, clauses_row), clauses, Row(hl, bt), result, amb_in, ret_amb, clauses_row, env, amb, Nil, Nil) {
                        R(Clauses(cambs, sks), s10) -> {
                          let s11 = flush(clause_labels(pop_clause_row(s10), cambs, clauses_row, "", start, end))
                          match rhead(s11, ROpen(amb)) {
                            R(own, s12) -> match rhead(s12, ROpen(clauses_row)) {
                              R(ct, s13) -> {
                                let s14 = if tail_eq(ct, own) { s13 } else { match get_ptys(s13) { R(sp, s13b) -> close_residual(s13b, clauses_row, sp) } }
                                // The residual: `IO`, never dispatched to a handler.
                                match resolve_row(s14, ropen(amb_in)) {
                                  R(Row(bl2, _), s15) -> {
                                    let s16 = match lab_get(bl2, "IO") { Yes(Lab(_, args, a, b)) -> surface(add_effect_args(s15, amb, "IO", args, a, b))  No -> s15 }
                                    // Forwarding: a clause that performs its operation again
                                    // poured the handled tail into its ambient.
                                    match rhead(s16, bt) {
                                      R(htail, s17) -> match forwards(s17, cambs, htail) {
                                        R(fw, s18) -> {
                                          let s19 = push_site(s18, GSite(hl, bt, fw, start, end))
                                          let s20 = hold_any_ops(escapes(s19, sks, result, env, amb), start, end, Row(hl, bt))
                                          R(result, hold_handle(s20, start, end, Cons(ropen(ret_amb), ropens(cambs))))
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
type Clauses { Clauses(List(Int), List(Skol)) }
fn ropens(vs: List(Int)) -> List(Row) {
  match vs { Nil -> Nil  Cons(v, rest) -> Cons(ropen(v), ropens(rest)) }
}
fn forwards(s: St, cambs: List(Int), htail: Tail) -> R(Bool) {
  match htail {
    ROpen(_) -> forwards_any(s, cambs, htail)
    _ -> R(False, s)
  }
}
fn forwards_any(s: St, cambs: List(Int), htail: Tail) -> R(Bool) {
  match cambs {
    Nil -> R(False, s)
    Cons(c, rest) -> match rhead(s, ROpen(c)) { R(t, s2) -> if tail_eq(t, htail) { R(True, s2) } else { forwards_any(s2, rest, htail) } }
  }
}
fn any_clauses(s: St, cs: List(Sp(OpClause)), handled: Row, result: Ty, amb_in: Int, ret_amb: Int, crow: Int, env: List(Entry), amb: Int, cambs: List(Int), sks: List(Skol)) -> R(Clauses) {
  match cs {
    Nil -> R(Clauses(rev(cambs), rev(sks)), s)
    Cons(Sp(OpClause(_, _, params, cbody), ca, cb), rest) -> match get_gn(s) {
      R(Gn(k, gr, pg), s1) -> {
        let sk = "'t" <> int.to_string(k + 1)
        let t = TCon(sk, Nil)
        let o = TCon("$Op", Cons(t, Cons(TFn(Nil, handled, t), Nil)))
        match any_params(set_gn(s1, Gn(k + 1, gr, pg)), params, o, env) {
          R(env2, s2) -> match fresh_row(s2) {
            R(camb, s3) -> match get_hx(s3) {
              R(Hx(_, _, depth, _, _, _, _, _, _), s4) -> match get_ptys(s4) {
                R(saved, s5) -> {
                  let s6 = push_region(set_ptys(push_resume(s5, Resume(t, result, amb_in, ret_amb, "*", depth, crow)), append(saved, Cons(o, Nil))), Region(camb, False))
                  match infer_expr(s6, cbody, env2, camb) {
                    R(cty, s7) -> match get_ptys(flush(pop_region(s7))) {
                      R(scope, s8) -> match resolve_row(set_ptys(close_residual(s8, camb, scope), saved), ropen(camb)) {
                        R(row, s9) -> match cbody {
                          Sp(_, bs, be) -> {
                            let s10 = unify(surface(add_row(s9, amb, row, bs, be)), cty, result, bs, be)
                            any_clauses(pop_resume(s10), rest, handled, result, amb_in, ret_amb, crow, env, amb, Cons(camb, cambs), Cons(Skol(sk, ca, cb), sks))
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
fn any_params(s: St, ps: List(Sp(Param)), o: Ty, env: List(Entry)) -> R(List(Entry)) {
  match ps {
    Nil -> R(env, s)
    Cons(Sp(Param(name, _, _), a, b), rest) -> any_params(note_binder(record(s, a, b, o), a, b, name, Scheme(Nil, Nil, o)), rest, o, Cons(Entry(name, Scheme(Nil, Nil, o)), env))
  }
}
// E0435: a clause's answer type in the handle's result, in a binding
// outside the clause, or in the ambient row's labels' arguments.
fn escapes(s: St, sks: List(Skol), result: Ty, env: List(Entry), amb: Int) -> St {
  match sks {
    Nil -> s
    Cons(Skol(sk, a, b), rest) -> match resolve(s, result) {
      R(rt, s2) -> match env_mentions(s2, env, sk) {
        R(in_env, s3) -> match resolve_row(s3, ropen(amb)) {
          R(Row(al, _), s4) -> {
            let hit = mentions_con(rt, sk) || in_env || labs_mention_con(al, sk)
            escapes(if hit { diag(s4, "E0435", "an operation's answer type escapes its clause", a, b) } else { s4 }, rest, result, env, amb)
          }
        }
      }
    }
  }
}
// Rust walks each scope's open entries: a name bound again in the same
// scope hides its earlier binding there (`open_entries`).
fn scope_mark() -> Entry { Entry("{", Scheme(Nil, Nil, TErr)) }
fn env_mentions(s: St, env: List(Entry), sk: String) -> R(Bool) { env_mentions_in(s, env, sk, Nil) }
fn env_mentions_in(s: St, env: List(Entry), sk: String, seen: List(String)) -> R(Bool) {
  match env {
    Nil -> R(False, s)
    Cons(Entry("{", _), rest) -> env_mentions_in(s, rest, sk, Nil)
    Cons(Entry(n, Scheme(_, _, t)), rest) -> if has_str(seen, n) { env_mentions_in(s, rest, sk, seen) } else {
      match resolve(s, t) { R(rt, s2) -> if mentions_con(rt, sk) { R(True, s2) } else { env_mentions_in(s2, rest, sk, Cons(n, seen)) } }
    }
  }
}
fn mentions_con(t: Ty, name: String) -> Bool {
  match t {
    TCon(n, args) -> n == name || mentions_con_list(args, name)
    TFn(ps, Row(ls, _), r) -> mentions_con_list(ps, name) || mentions_con(r, name) || labs_mention_con(ls, name)
    _ -> False
  }
}
fn mentions_con_list(xs: List(Ty), name: String) -> Bool { match xs { Nil -> False  Cons(x, rest) -> mentions_con(x, name) || mentions_con_list(rest, name) } }
fn labs_mention_con(ls: List(Lab), name: String) -> Bool { match ls { Nil -> False  Cons(Lab(_, a, _, _), rest) -> mentions_con_list(a, name) || labs_mention_con(rest, name) } }
// A return clause's binder is keyed by the clause's body.
fn note_ret(s: St, binder: String, rbody: Sp(Expr), t: Ty) -> St {
  match rbody { Sp(_, a, b) -> note_binder(s, a, b, binder, Scheme(Nil, Nil, t)) }
}
// E0427: `with multi` over an effect not declared `multi`.
fn one_shot(r: R(String), many: Bool, start: Int, end: Int) -> R(String) {
  match r {
    R(eff, s) -> if many && eff != "" {
      match is_multi(s, eff) {
        R(yes, s2) -> R(eff, if yes { s2 } else { diag(s2, "E0427", "a one-shot effect cannot be handled with `multi`", start, end) })
      }
    } else { R(eff, s) }
  }
}
// E0426, a warning: a `with multi` handler's body performing an observable
// effect (`IO`), which a second resume repeats.
fn repeats(s: St, amb_in: Int, start: Int, end: Int) -> St {
  match resolve_row(s, ropen(amb_in)) {
    R(Row(ls, _), s2) -> if has_lab(ls, "IO") { warn(s2, "E0426", "a multi-shot handler may run its continuation's effects more than once", start, end) } else { s2 }
  }
}
// One instantiation of the handled effect's parameters, shared by the
// body's row and every clause.
fn handle_args(s: St, eff: String) -> R(EffArgs) {
  match get_hx(s) {
    R(Hx(_, _, _, ops, _, _, _, _, _), s2) -> match op_of_effect(ops, eff) {
      Yes(all) -> fresh_effect_args(s2, all, EffArgs(Nil, Nil, Nil))
      No -> R(EffArgs(Nil, Nil, Nil), s2)
    }
  }
}
fn op_of_effect(ops: List(OpInfo), eff: String) -> Maybe(List(RPair)) {
  match ops { Nil -> No  Cons(OpInfo(_, e, all, _, _), rest) -> if e == eff && eff != "" { Yes(all) } else { op_of_effect(rest, eff) } }
}
fn push_clause_row(s: St, r: Int) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(rs, Cons(r, cr), d, ops, effs, dead, mu, gn, af)) }
}
fn pop_clause_row(s: St) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(rs, match cr { Cons(_, rest) -> rest  Nil -> Nil }, d, ops, effs, dead, mu, gn, af)) }
}
fn push_resume(s: St, r: Resume) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(Cons(r, rs), cr, d, ops, effs, dead, mu, gn, af)) }
}
fn pop_resume(s: St) -> St {
  match get_hx(s) { R(Hx(rs, cr, d, ops, effs, dead, mu, gn, af), s2) -> set_hx(s2, Hx(match rs { Cons(_, rest) -> rest  Nil -> Nil }, cr, d, ops, effs, dead, mu, gn, af)) }
}
fn set_ptys(s: St, p: List(Ty)) -> St {
  match get_gx(s) { R(Gx(i, mi, _, rs, d, gp, ga), s2) -> set_gx(s2, Gx(i, mi, p, rs, d, gp, ga)) }
}
// Each operation clause: its parameters at the operation's types (fresh
// past them), `resume` taking the operation's result; its own row closed
// unless relayed, and poured into the ambient. The clauses' rows, newest
// first.
fn op_clauses(s: St, cs: List(Sp(OpClause)), cx: Resume, ea: EffArgs, env: List(Entry), amb: Int, acc: List(Int)) -> R(List(Int)) {
  match cs {
    Nil -> R(acc, s)
    Cons(Sp(OpClause(_, op, params, cbody), _, _), rest) -> match find_op(s, op) {
      R(m, s1) -> {
        // The handler's one instantiation of the effect's parameters.
        let sig = match m {
          // (Its own effect's parameters, position by position, even for a
          // clause of another effect, which E0423 reports.)
          Yes(OpInfo(_, _, all, ps, r)) -> match ea { EffArgs(eargs, _, erm) -> { let em = zip_params(all, eargs)  Sig(subst_list(ps, em, erm, Nil), subst(r, em, erm)) } }
          No -> Sig(Nil, TErr)
        }
        match sig {
          Sig(ops, b) -> match clause_params(s1, params, ops, env) {
            R(env2, s2) -> match fresh_row(s2) {
              R(camb, s3) -> match get_hx(s3) {
                R(Hx(_, _, depth, _, _, _, _, _, _), s4) -> match cx {
                  Resume(_, result, body_amb, ret_amb, handled, _, crow) -> match get_ptys(s4) {
                    R(saved, s5) -> {
                      let s6 = push_region(set_ptys(push_resume(s5, Resume(b, result, body_amb, ret_amb, handled, depth, crow)), append(saved, ops)), Region(camb, False))
                      match infer_expr(s6, cbody, env2, camb) {
                        R(cty, s7) -> match get_ptys(flush(pop_region(s7))) {
                          R(scope, s8) -> match resolve_row(set_ptys(close_residual(s8, camb, scope), saved), ropen(camb)) {
                            R(row, s9) -> match cbody {
                              Sp(_, bs, be) -> {
                                let s10 = unify(surface(add_row(s9, amb, row, bs, be)), cty, result, bs, be)
                                op_clauses(pop_resume(s10), rest, cx, ea, env, amb, Cons(camb, acc))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          NoSig -> R(acc, s1)
        }
      }
    }
  }
}
fn clause_params(s: St, ps: List(Sp(Param)), ts: List(Ty), env: List(Entry)) -> R(List(Entry)) {
  match ps {
    Nil -> R(env, s)
    Cons(Sp(Param(name, _, _), a, b), rest) -> {
      let got = match ts { Cons(t, _) -> R(t, s)  Nil -> fresh(s) }
      match got { R(t, s2) -> clause_params(record(note_binder(s2, a, b, name, Scheme(Nil, Nil, t)), a, b, t), rest, match ts { Cons(_, tr) -> tr  Nil -> Nil }, Cons(Entry(name, Scheme(Nil, Nil, t)), env)) }
    }
  }
}
// Each clause's labels but the handled effect, and its open tail, reach the
// clauses row.
fn clause_labels(s: St, cambs: List(Int), crow: Int, eff: String, start: Int, end: Int) -> St {
  match cambs {
    Nil -> s
    Cons(ca, rest) -> match resolve_row(s, ropen(ca)) {
      R(Row(ls, t), s2) -> {
        let s3 = clause_labs(s2, ls, crow, eff)
        let s4 = match t { ROpen(_) -> surface(add_row(s3, crow, Row(Nil, t), start, end))  _ -> s3 }
        clause_labels(s4, rest, crow, eff, start, end)
      }
    }
  }
}
fn clause_labs(s: St, ls: List(Lab), crow: Int, eff: String) -> St {
  match ls {
    Nil -> s
    Cons(Lab(n, args, a, b), rest) -> clause_labs(if n == eff { s } else { surface(add_effect_args(s, crow, n, args, a, b)) }, rest, crow, eff)
  }
}
// `type_resume`: the argument against the operation's result; the rest of
// the handled body and the return clause run again, so their labels (but
// the handled one) reach this ambient, and a relayed tail too. Escaped
// into a lambda, every clause's effects and the body's member rows too.
fn type_resume(s: St, arg_ty: Ty, start: Int, end: Int, amb: Int) -> R(Ty) {
  match get_hx(s) {
    R(Hx(rs, _, depth, _, _, _, _, _, _), s1) -> match rs {
      Nil -> R(TErr, s1)
      Cons(Resume(arg, result, body_amb, ret_amb, handled, d, crow), _) -> {
        let s2 = unify(s1, arg_ty, arg, start, end)
        let s3 = if depth > d { escaped(surface(add_row(s2, amb, ropen(crow), start, end)), body_amb, amb) } else { s2 }
        match get_ptys(s3) {
          R(ptys, s4) -> match rows_in(s4, ptys, Nil) {
            R(in_params, s5) -> R(result, rerun(rerun(s5, body_amb, handled, in_params, amb, start, end), ret_amb, "", in_params, amb, start, end))
          }
        }
      }
    }
  }
}
fn escaped(s: St, body_amb: Int, amb: Int) -> St {
  match rhead(s, ROpen(body_amb)) {
    R(bt, s2) -> match get_gx(s2) {
      R(Gx(_, mincl, _, _, _, _, _), s3) -> match more_member(s3, mincl, bt, amb, Nil) {
        R(more, s4) -> match get_gx(s4) {
          R(Gx(i, mi, p, r, d, gp, ga), s5) -> set_gx(s5, Gx(i, append(mi, rev(more)), p, r, d, gp, ga))
        }
      }
    }
  }
}
fn more_member(s: St, xs: List(Incl), bt: Tail, amb: Int, acc: List(Incl)) -> R(List(Incl)) {
  match xs {
    Nil -> R(acc, s)
    Cons(Incl(m, dst, a, b), rest) -> match rhead(s, ROpen(dst)) {
      R(t, s2) -> more_member(s2, rest, bt, amb, if tail_eq(t, bt) { Cons(Incl(m, amb, a, b), acc) } else { acc })
    }
  }
}
// A `with any` handler's resume (`except` "*") reruns only the body's `IO`,
// and relays no tail.
fn rerun(s: St, src: Int, except: String, in_params: List(Int), amb: Int, start: Int, end: Int) -> St {
  match resolve_row(s, ropen(src)) {
    R(Row(ls, t), s2) -> if except == "*" { clause_labs(s2, only_io(ls), amb, "") } else {
      let s3 = clause_labs(s2, ls, amb, except)
      match t {
        ROpen(w) -> if has_int(in_params, w) { surface(add_row(s3, amb, Row(Nil, t), start, end)) } else { s3 }
        _ -> s3
      }
    }
  }
}
fn only_io(ls: List(Lab)) -> List(Lab) {
  match ls { Nil -> Nil  Cons(l, rest) -> if lab_name(l) == "IO" { Cons(l, Nil) } else { only_io(rest) } }
}

// ---- The call graph (`collect_refs`, `tarjan_scc`) ----------------------------

fn refs_block(b: Block, acc: List(String)) -> List(String) {
  match b {
    Block(stmts, tail) -> {
      let a2 = refs_stmts(stmts, acc)
      match tail { No -> a2  Yes(t) -> refs_expr(t, a2) }
    }
  }
}
fn refs_stmts(stmts: List(Sp(Stmt)), acc: List(String)) -> List(String) {
  match stmts {
    Nil -> acc
    Cons(st, rest) -> match st {
      Sp(SLet(_, _, v), _, _) -> refs_stmts(rest, refs_expr(v, acc))
      Sp(SExpr(e), _, _) -> refs_stmts(rest, refs_expr(e, acc))
    }
  }
}
fn refs_list(xs: List(Sp(Expr)), acc: List(String)) -> List(String) {
  match xs { Nil -> acc  Cons(x, rest) -> refs_list(rest, refs_expr(x, acc)) }
}
fn refs_arms(arms: List(Sp(MatchArm)), acc: List(String)) -> List(String) {
  match arms {
    Nil -> acc
    Cons(a, rest) -> match a { Sp(MatchArm(_, body), _, _) -> refs_arms(rest, refs_expr(body, acc)) }
  }
}
fn refs_clauses(cs: List(Sp(OpClause)), acc: List(String)) -> List(String) {
  match cs {
    Nil -> acc
    Cons(c, rest) -> match c { Sp(OpClause(_, _, _, body), _, _) -> refs_clauses(rest, refs_expr(body, acc)) }
  }
}
// Newest first, as `acc` grows.
fn refs_expr(e: Sp(Expr), acc: List(String)) -> List(String) {
  match e {
    Sp(node, _, _) -> match node {
      EVar(n) -> Cons(n, acc)
      ECall(c, args) -> refs_list(args, refs_expr(c, acc))
      EUnary(_, x) -> refs_expr(x, acc)
      EBinary(_, l, r) -> refs_expr(r, refs_expr(l, acc))
      EIf(c, t, f) -> refs_block(sp_block(f), refs_block(sp_block(t), refs_expr(c, acc)))
      EBlock(b) -> refs_block(b, acc)
      EMatch(x, arms) -> refs_arms(arms, refs_expr(x, acc))
      ELambda(_, body) -> refs_block(sp_block(body), acc)
      EHandle(body, h) -> match h {
        Handler(_, _, clauses, ret) -> {
          let a2 = refs_clauses(clauses, refs_expr(body, acc))
          match ret { No -> a2  Yes(ReturnClause(_, rb)) -> refs_expr(rb, a2) }
        }
      }
      EResume(x) -> refs_expr(x, acc)
      _ -> acc
    }
  }
}
// The last function of a name, as Rust's name-to-index map keeps it.
fn fn_index(fns: List(FnInfo), name: String, i: Int, found: Int) -> Int {
  match fns {
    Nil -> found
    Cons(f, rest) -> match f {
      FnInfo(n, _, _, _, _, _, _) -> fn_index(rest, name, i + 1, if n == name { i } else { found })
    }
  }
}
fn edges_of(fns: List(FnInfo), names: List(String), acc: List(Int)) -> List(Int) {
  match names {
    Nil -> rev(acc)
    Cons(n, rest) -> {
      let j = fn_index(fns, n, 0, 0 - 1)
      edges_of(fns, rest, if j < 0 || has_int(acc, j) { acc } else { Cons(j, acc) })
    }
  }
}
fn all_edges(fns: List(FnInfo), xs: List(FnInfo), acc: List(List(Int))) -> List(List(Int)) {
  match xs {
    Nil -> rev(acc)
    Cons(f, rest) -> match f {
      FnInfo(_, _, _, _, _, body, _) -> all_edges(fns, rest, Cons(edges_of(fns, rev(refs_block(sp_block(body), Nil)), Nil), acc))
    }
  }
}
fn nth_edges(es: List(List(Int)), i: Int) -> List(Int) {
  match es { Nil -> Nil  Cons(e, rest) -> if i == 0 { e } else { nth_edges(rest, i - 1) } }
}

// Tarjan's state: index, low, on-stack, the stack, the counter, the
// components (newest first).
linear type Tj { Tj(Array(Int), Array(Int), Array(Bool), List(Int), Int, List(List(Int))) }
type Frame { Frame(Int, Int) }
fn filled(a: Array(Int), n: Int, v: Int) -> Array(Int) { if n == 0 { a } else { filled(array.push(a, v), n - 1, v) } }
fn filled_b(a: Array(Bool), n: Int) -> Array(Bool) { if n == 0 { a } else { filled_b(array.push(a, False), n - 1) } }

fn tarjan(es: List(List(Int)), n: Int) -> List(List(Int)) {
  match tj_starts(Tj(filled(array.new(), n, 0 - 1), filled(array.new(), n, 0), filled_b(array.new(), n), Nil, 0, Nil), es, 0, n) {
    Tj(_, _, _, _, _, out) -> rev(out)
  }
}
fn tj_starts(t: Tj, es: List(List(Int)), start: Int, n: Int) -> Tj {
  if start == n { t } else {
    match t {
      Tj(index, low, on, stack, counter, out) -> {
        let seen = array.get(index, start) >= 0
        let t2 = Tj(index, low, on, stack, counter, out)
        tj_starts(if seen { t2 } else { tj_loop(t2, es, Cons(Frame(start, 0), Nil)) }, es, start + 1, n)
      }
    }
  }
}
fn tj_loop(t: Tj, es: List(List(Int)), call: List(Frame)) -> Tj {
  match call {
    Nil -> t
    Cons(fr, below) -> match fr {
      Frame(v, pi) -> {
        let t2 = if pi == 0 { tj_visit(t, v) } else { t }
        tj_scan(t2, es, v, pi, nth_edges(es, v), below)
      }
    }
  }
}
fn tj_visit(t: Tj, v: Int) -> Tj {
  match t {
    Tj(index, low, on, stack, counter, out) ->
      Tj(array.set(index, v, counter), array.set(low, v, counter), array.set(on, v, True), Cons(v, stack), counter + 1, out)
  }
}
fn tj_scan(t: Tj, es: List(List(Int)), v: Int, pi: Int, edges: List(Int), below: List(Frame)) -> Tj {
  if pi < len(edges) {
    let w = nth_int(edges, pi)
    match t {
      Tj(index, low, on, stack, counter, out) -> {
        let iw = array.get(index, w)
        if iw < 0 {
          tj_loop(Tj(index, low, on, stack, counter, out), es, Cons(Frame(w, 0), Cons(Frame(v, pi + 1), below)))
        } else {
          let low2 = if array.get(on, w) {
            let lv = array.get(low, v)
            array.set(low, v, if iw < lv { iw } else { lv })
          } else { low }
          tj_scan(Tj(index, low2, on, stack, counter, out), es, v, pi + 1, edges, below)
        }
      }
    }
  } else {
    tj_finish(t, es, v, below)
  }
}
fn tj_finish(t: Tj, es: List(List(Int)), v: Int, below: List(Frame)) -> Tj {
  match t {
    Tj(index, low, on, stack, counter, out) -> {
      let lv = array.get(low, v)
      let t2 = if lv == array.get(index, v) {
        tj_pop(Tj(index, low, on, stack, counter, out), v, Nil)
      } else { Tj(index, low, on, stack, counter, out) }
      match below {
        Nil -> t2
        Cons(Frame(parent, ppi), rest) -> match t2 {
          Tj(i2, l2, o2, s2, c2, out2) -> {
            let lp = array.get(l2, parent)
            let l3 = array.set(l2, parent, if lv < lp { lv } else { lp })
            tj_resume(Tj(i2, l3, o2, s2, c2, out2), es, parent, ppi, rest)
          }
        }
      }
    }
  }
}
// The parent frame continues its scan where it stopped.
fn tj_resume(t: Tj, es: List(List(Int)), v: Int, pi: Int, below: List(Frame)) -> Tj {
  tj_scan(t, es, v, pi, nth_edges(es, v), below)
}
fn tj_pop(t: Tj, v: Int, comp: List(Int)) -> Tj {
  match t {
    Tj(index, low, on, stack, counter, out) -> match stack {
      Nil -> Tj(index, low, on, stack, counter, Cons(rev(comp), out))
      Cons(w, rest) -> {
        let t2 = Tj(index, low, array.set(on, w, False), rest, counter, out)
        if w == v { match t2 { Tj(a, b, c, d, e, o) -> Tj(a, b, c, d, e, Cons(rev(Cons(w, comp)), o)) } } else { tj_pop(t2, v, Cons(w, comp)) }
      }
    }
  }
}

// ---- The top level (`infer_all`) ------------------------------------------------

fn fn_infos(decls: List(Sp(Decl)), acc: List(FnInfo)) -> List(FnInfo) {
  match decls {
    Nil -> rev(acc)
    Cons(d, rest) -> match d {
      Sp(DFn(_, name, params, row, ret, body), start, end) -> fn_infos(rest, Cons(FnInfo(name, start, end, params, ret, body, row), acc))
      _ -> fn_infos(rest, acc)
    }
  }
}
type SchemeLine { SchemeLine(String, String) }
// What the groups leave: the environment and the scheme lines.
type Out { Out(List(Entry), List(SchemeLine)) }

fn check_anns(s: St, params: List(Sp(Param)), tys: List(Ty)) -> St {
  match params {
    Nil -> s
    Cons(p, rest) -> match tys {
      Nil -> s
      Cons(t, trest) -> match p { Sp(Param(_, ann, _), _, _) -> check_anns(check_ann(s, ann, t, False), rest, trest) }
    }
  }
}
type MemsEnv { MemsEnv(List(Mem), List(Entry)) }
// One group (`infer_all`'s loop): members, bodies, the rows' steps 2.4 to
// 2.7, then the schemes.
fn group(s: St, fns: List(FnInfo), g: List(Int), env: List(Entry)) -> R(Out) {
  match members_list(s, fns, g, env, Nil) {
    R(MemsEnv(rms, env2), s2) -> {
      let ms = rev(rms)
      match get_gx(s2) {
        R(Gx(incl, mincl, ptys, regions, deferred, _, _), s3) -> {
          let s4 = set_gx(s3, Gx(incl, mincl, ptys, regions, deferred, mem_params(ms, Nil), mem_ambs(ms, Nil)))
          match bodies(s4, fns, ms, env2, Nil) {
            R(ms2, s5) -> schemes_of(close_group(s5, fns, ms2), fns, ms2, env2, Nil)
          }
        }
      }
    }
  }
}
fn mem_params(ms: List(Mem), acc: List(Ty)) -> List(Ty) {
  match ms { Nil -> acc  Cons(Mem(_, ps, _, _, _, _, _), rest) -> mem_params(rest, append(acc, ps)) }
}
fn mem_ambs(ms: List(Mem), acc: List(Int)) -> List(Int) {
  match ms { Nil -> rev(acc)  Cons(Mem(_, _, amb, _, _, _, _), rest) -> mem_ambs(rest, Cons(amb, acc)) }
}
// Step 1: a fresh monotype per member, its annotations checked, its type
// recorded at its declaration.
fn members_list(s: St, fns: List(FnInfo), g: List(Int), env: List(Entry), acc: List(Mem)) -> R(MemsEnv) {
  match g {
    Nil -> R(MemsEnv(acc, env), s)
    Cons(i, rest) -> match nth_fn(fns, i) {
      FnInfo(name, ds, de, params, ret, _, declared) -> match fresh_list(s, len(params), Nil) {
        R(ps, s2) -> match fresh_row(s2) {
          R(amb, s2b) -> match fresh(s2b) {
            R(result, s3) -> {
              let ft = TFn(ps, ropen(amb), result)
              let s4a = check_ann(check_anns(set_ann_rows(set_ann_vars(s3, Nil), Nil), params, ps), ret, result, True)
              match declared_label_args(s4a, declared) {
                R(dl, s4) -> match ann_vars(s4) {
                  R(avs, s4b) -> match ann_rows(s4b) {
                    R(ar, s5) -> members_list(record(s5, ds, de, ft), fns, rest, Cons(Entry(name, Scheme(Nil, Nil, ft)), env), Cons(Mem(i, ps, amb, result, avs, ar, dl), acc))
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
fn bind_params(s: St, params: List(Sp(Param)), tys: List(Ty), env: List(Entry)) -> R(List(Entry)) {
  match params {
    Nil -> R(env, s)
    Cons(p, rest) -> match tys {
      Nil -> R(env, s)
      Cons(t, trest) -> match p {
        Sp(Param(name, _, _), start, end) -> bind_params(note_binder(record(s, start, end, t), start, end, name, Scheme(Nil, Nil, t)), rest, trest, Cons(Entry(name, Scheme(Nil, Nil, t)), env))
      }
    }
  }
}
fn set_param_tys(s: St, ptys: List(Ty)) -> St {
  match get_gx(s) { R(Gx(i, mi, _, r, d, gp, ga), s2) -> set_gx(s2, Gx(i, mi, ptys, r, d, gp, ga)) }
}
// Step 2: each body under its parameters and its ambient row, the group
// monomorphic. Each member's named rows, its body's included, kept for its
// declared row (2.48).
fn bodies(s: St, fns: List(FnInfo), ms: List(Mem), env: List(Entry), acc: List(Mem)) -> R(List(Mem)) {
  match ms {
    Nil -> R(rev(acc), set_ann_rows(s, Nil))
    Cons(Mem(i, ps, amb, result, avs, ar, dl), rest) -> match nth_fn(fns, i) {
      FnInfo(_, _, _, params, _, body, _) -> match bind_params(set_ann_rows(set_ann_vars(s, avs), ar), params, ps, env) {
        R(benv, s2) -> match body {
          Sp(b, bs, be) -> match infer_block(set_param_tys(s2, ps), b, benv, amb) {
            R(bt, s3) -> match ann_rows(unify(set_param_tys(s3, Nil), result, bt, bs, be)) {
              R(ar2, s4) -> bodies(s4, fns, rest, env, Cons(Mem(i, ps, amb, result, avs, ar2, dl), acc))
            }
          }
        }
      }
    }
  }
}
// Steps 2.4 to 2.7.
fn close_group(s: St, fns: List(FnInfo), ms: List(Mem)) -> St {
  match get_gx(s) {
    R(Gx(incl, _, _, _, deferred, gparams, _), s2) -> match rows_in(s2, gparams, Nil) {
      R(in_params, s3) -> {
        // 2.4: a pending inclusion whose source the parameters relay means it.
        let s4 = flush(unmark_relayed(s3, incl, in_params))
        // 2.45: the lambdas' deferred rows, with the group's parameters.
        let s5 = close_deferred(s4, deferred, gparams)
        // 2.48: a declared row ending in a named variable, with its own
        // member's names, before anything closes.
        // 2.5: each member's residual ambient row.
        // 2.47: a declared row's written label arguments are what the body
        // performs at them.
        let s6 = close_members(set_ann_rows(named_rows(label_args_at(s5, ms), fns, ms), Nil), ms)
        // 2.6: the declared rows, exactly, and what `main` may perform.
        let s6b = exact_rows(settle_members(s6, fns, ms), fns, ms)
        // 2.7: what is still pending reaches its rows; the group's phantoms
        // that nothing bound close to pure.
        match get_gx(flush(s6b)) {
          R(Gx(_, _, ptys, regions, _, _, _), s7) -> match row_count(s7) {
            R(n, s8) -> match get_hx(s8) {
              R(Hx(rs9, cr9, d9, ops9, effs9, _, mu9, gn9, af9), s9) -> check_generic_rows(close_phantoms(set_hx(set_gx(s9, Gx(Nil, Nil, ptys, regions, Nil, Nil, Nil)), Hx(rs9, cr9, d9, ops9, effs9, Nil, mu9, gn9, af9)), 0, n))
            }
          }
        }
      }
    }
  }
}
fn unmark_relayed(s: St, xs: List(Incl), in_params: List(Int)) -> St {
  match xs {
    Nil -> s
    Cons(Incl(src, _, _, _), rest) -> match rhead(s, ROpen(src)) {
      R(t, s2) -> match t {
        ROpen(w) -> unmark_relayed(if has_int(in_params, w) { set_phantom(s2, w, False) } else { s2 }, rest, in_params)
        _ -> unmark_relayed(s2, rest, in_params)
      }
    }
  }
}
fn close_deferred(s: St, ds: List(Deferred), gparams: List(Ty)) -> St {
  match ds {
    Nil -> s
    Cons(Deferred(l, params), rest) -> close_deferred(close_residual(s, l, append(params, gparams)), rest, gparams)
  }
}
fn close_members(s: St, ms: List(Mem)) -> St {
  match ms {
    Nil -> s
    Cons(Mem(_, ps, amb, _, _, _, _), rest) -> close_members(close_residual(s, amb, ps), rest)
  }
}
// A declared row's labels written with arguments, elaborated where the
// member's annotation names are live (`declared_label_args`).
fn declared_label_args(s: St, declared: Maybe(RowAnn)) -> R(List(Lab)) {
  match declared {
    No -> R(Nil, s)
    Yes(RowAnn(labels, _)) -> match effect_kinds(s) {
      R(ek, s2) -> match ann_labels(s2, written_args(labels, ek), Nil) { R(ls, s3) -> R(ls, s3) }
    }
  }
}
fn written_args(ls: List(LabelAnn), ek: List(Kind)) -> List(LabelAnn) {
  match ls {
    Nil -> Nil
    Cons(LabelAnn(Sp(n, a, b), Yes(xs)), rest) -> if has_kind(ek, n) { Cons(LabelAnn(Sp(n, a, b), Yes(xs)), written_args(rest, ek)) } else { written_args(rest, ek) }
    Cons(_, rest) -> written_args(rest, ek)
  }
}
fn label_args_at(s: St, ms: List(Mem)) -> St {
  match ms {
    Nil -> s
    Cons(Mem(_, _, amb, _, _, _, dl), rest) -> label_args_at(label_args_one(s, amb, dl), rest)
  }
}
fn label_args_one(s: St, amb: Int, dl: List(Lab)) -> St {
  match dl {
    Nil -> s
    Cons(Lab(n, want, a, b), rest) -> match resolve_row(s, ropen(amb)) {
      R(Row(performed, _), s2) -> label_args_one(match lab_get(performed, n) {
        Yes(Lab(_, have, _, _)) -> unify_effect_args(s2, n, have, want, a, b)
        No -> s2
      }, amb, rest)
    }
  }
}
fn named_rows(s: St, fns: List(FnInfo), ms: List(Mem)) -> St {
  match ms {
    Nil -> s
    Cons(Mem(i, _, amb, _, _, ar, _), rest) -> match nth_fn(fns, i) {
      FnInfo(_, _, _, _, _, _, declared) -> named_rows(match declared {
        Yes(RowAnn(labels, Yes(v))) -> check_named_row(set_ann_rows(s, ar), amb, labels, v)
        _ -> s
      }, fns, rest)
    }
  }
}
// `check_named_row`: a declared row `{A, B | e}`. A declared label the body
// never performs is E0423 at it; otherwise the performed row is the declared
// labels (as performed) and the named variable.
fn check_named_row(s: St, amb: Int, labels: List(LabelAnn), v: Sp(String)) -> St {
  match resolve_row(s, ropen(amb)) {
    R(Row(performed, _), s2) -> match unused_labs(labels, performed) {
      Cons(Lab(_, _, a, b), _) -> diag(s2, "E0423", "effect row mismatch", a, b)
      Nil -> match v {
        Sp(name, vs, ve) -> match ann_row(s2, name, vs, ve) {
          R(tail, s2b) -> match rhead(s2b, ROpen(tail)) {
          R(now_t, s2c) -> {
          // A performed label whose arguments mention the named row (a task's
          // own `Async(e)` under `/ {e}`) cannot be in it.
          let now = match now_t { ROpen(w) -> w  _ -> tail }
          match left_out(s2c, performed, labels, now) {
          R(Cons(Lab(_, _, a, b), _), s2d) -> diag(s2d, "E0423", "effect row mismatch", a, b)
          R(Nil, s3) -> {
            let m = performed_of(labels, performed, Nil)
            match labels {
              Cons(LabelAnn(Sp(_, a, b), _), _) -> surface(unify_row(s3, ropen(amb), Row(m, ROpen(tail)), a, b))
              Nil -> surface(unify_row(s3, ropen(amb), Row(m, ROpen(tail)), 0, 0))
            }
          }
          }
          }
          }
        }
      }
    }
  }
}
fn left_out(s: St, performed: List(Lab), labels: List(LabelAnn), now: Int) -> R(List(Lab)) {
  match performed {
    Nil -> R(Nil, s)
    Cons(Lab(k, args, a, b), rest) -> if declares(labels, k) { left_out(s, rest, labels, now) } else {
      match mentions_any(s, now, args) {
        R(m, s2) -> match left_out(s2, rest, labels, now) { R(more, s3) -> R(if m { Cons(Lab(k, args, a, b), more) } else { more }, s3) }
      }
    }
  }
}
fn mentions_any(s: St, v: Int, xs: List(Ty)) -> R(Bool) {
  match xs {
    Nil -> R(False, s)
    Cons(x, rest) -> match mentions_row(s, v, x) { R(m, s2) -> if m { R(True, s2) } else { mentions_any(s2, v, rest) } }
  }
}
fn performed_of(labels: List(LabelAnn), performed: List(Lab), acc: List(Lab)) -> List(Lab) {
  match labels {
    Nil -> acc
    Cons(LabelAnn(Sp(n, _, _), _), rest) -> performed_of(rest, performed, match lab_get(performed, n) { Yes(l) -> put_lab(acc, l)  No -> acc })
  }
}
fn lab_get(ls: List(Lab), n: String) -> Maybe(Lab) {
  match ls { Nil -> No  Cons(l, rest) -> if lab_name(l) == n { Yes(l) } else { lab_get(rest, n) } }
}
// 2.6 first: a member's row with one effect met twice along it has its
// arguments unified.
fn settle_members(s: St, fns: List(FnInfo), ms: List(Mem)) -> St {
  match ms {
    Nil -> s
    Cons(Mem(i, _, amb, _, _, _, _), rest) -> match nth_fn(fns, i) {
      FnInfo(_, _, _, _, _, Sp(_, bs, be), _) -> settle_members(settle(s, ropen(amb), bs, be), fns, rest)
    }
  }
}
fn exact_rows(s: St, fns: List(FnInfo), ms: List(Mem)) -> St {
  match ms {
    Nil -> s
    Cons(Mem(i, _, amb, _, _, _, _), rest) -> match nth_fn(fns, i) {
      FnInfo(name, _, _, _, _, _, declared) -> {
        let s2 = match declared { Yes(RowAnn(labels, No)) -> check_exact_row(s, amb, labels)  _ -> s }
        exact_rows(if name == "main" { check_main_discharge(s2, amb) } else { s2 }, fns, rest)
      }
    }
  }
}
// `check_exact_row`: an annotated function performs exactly its declared
// row. Declared pure, any effect is E0421; otherwise each difference, in
// either direction, is E0423 at its first label.
fn check_exact_row(s: St, amb: Int, declared: List(LabelAnn)) -> St {
  match resolve_row(s, ropen(amb)) {
    R(Row(performed, _), s2) -> match declared {
      Nil -> match performed {
        Nil -> s2
        Cons(Lab(_, _, a, b), _) -> diag(s2, "E0421", "this function is declared pure but performs `" <> join_labs(performed, "") <> "`", a, b)
      }
      _ -> {
        let s3 = match extra_labs(performed, declared) { Cons(Lab(_, _, a, b), _) -> diag(s2, "E0423", "effect row mismatch", a, b)  Nil -> s2 }
        match unused_labs(declared, performed) { Cons(Lab(_, _, a, b), _) -> diag(s3, "E0423", "effect row mismatch", a, b)  Nil -> s3 }
      }
    }
  }
}
fn join_labs(ls: List(Lab), acc: String) -> String {
  match ls { Nil -> acc  Cons(Lab(n, _, _, _), rest) -> join_labs(rest, if acc == "" { n } else { acc <> ", " <> n }) }
}
fn declares(xs: List(LabelAnn), n: String) -> Bool {
  match xs { Nil -> False  Cons(LabelAnn(Sp(m, _, _), _), rest) -> m == n || declares(rest, n) }
}
fn extra_labs(ls: List(Lab), declared: List(LabelAnn)) -> List(Lab) {
  match ls { Nil -> Nil  Cons(l, rest) -> if declares(declared, lab_name(l)) { extra_labs(rest, declared) } else { Cons(l, extra_labs(rest, declared)) } }
}
fn unused_labs(declared: List(LabelAnn), ls: List(Lab)) -> List(Lab) {
  match declared {
    Nil -> Nil
    Cons(LabelAnn(Sp(n, a, b), _), rest) -> if has_lab(ls, n) { unused_labs(rest, ls) } else { Cons(Lab(n, Nil, a, b), unused_labs(rest, ls)) }
  }
}
// `check_main_discharge`: `main` may perform only `IO`; each other effect
// is E0420 where it is performed.
fn check_main_discharge(s: St, amb: Int) -> St {
  match resolve_row(s, ropen(amb)) { R(Row(ls, _), s2) -> unhandled(s2, ls) }
}
fn unhandled(s: St, ls: List(Lab)) -> St {
  match ls {
    Nil -> s
    Cons(Lab(n, _, a, b), rest) -> unhandled(if n == "IO" { s } else { diag(s, "E0420", "effect `" <> n <> "` is never handled", a, b) }, rest)
  }
}
// 2.8, E0434: every row a `with any` handler handles is data: each label a
// user effect (never `IO`) whose operations take and answer data at the
// label's arguments. A tail still open is generically handled from now on.
fn check_generic_rows(s: St) -> St {
  match get_gn(s) {
    R(Gn(k, gr, pg), s2) -> generic_sites_check(set_gn(s2, Gn(k, gr, Nil)), pg)
  }
}
fn generic_sites_check(s: St, sites: List(GSite)) -> St {
  match sites {
    Nil -> s
    Cons(GSite(snap, tail, fw, a, b), rest) -> match resolve_row(s, Row(Nil, tail)) {
      R(Row(rl, rt), s2) -> {
        let labels = if fw { snap } else { keep_labs(snap, rl) }
        let s3 = site_labels(s2, labels, a, b)
        let s4 = match rt {
          ROpen(v) -> match get_gn(s3) { R(Gn(k, gr, pg), s3b) -> set_gn(s3b, Gn(k, if has_int(gr, v) { gr } else { Cons(v, gr) }, pg)) }
          _ -> s3
        }
        generic_sites_check(s4, rest)
      }
    }
  }
}
fn site_labels(s: St, ls: List(Lab), a: Int, b: Int) -> St {
  match ls {
    Nil -> s
    Cons(Lab(n, args, _, _), rest) -> if n == "IO" {
      site_labels(diag(s, "E0434", "`IO` cannot be handled by `with any`", a, b), rest, a, b)
    } else {
      match get_hx(s) {
        R(Hx(_, _, _, ops, _, _, _, _, _), s2) -> site_labels(ops_data(s2, sort_ops(ops_of(ops, n)), args, a, b), rest, a, b)
      }
    }
  }
}
fn ops_of(ops: List(OpInfo), eff: String) -> List(OpInfo) {
  match ops { Nil -> Nil  Cons(OpInfo(n, e, all, ps, r), rest) -> if e == eff { Cons(OpInfo(n, e, all, ps, r), ops_of(rest, eff)) } else { ops_of(rest, eff) } }
}
// By name (Rust sorts them).
fn sort_ops(ops: List(OpInfo)) -> List(OpInfo) {
  match ops { Nil -> Nil  Cons(o, rest) -> insert_op(sort_ops(rest), o) }
}
fn insert_op(xs: List(OpInfo), o: OpInfo) -> List(OpInfo) {
  match xs {
    Nil -> Cons(o, Nil)
    Cons(x, rest) -> match x {
      OpInfo(n, _, _, _, _) -> match o { OpInfo(m, _, _, _, _) -> if str_lt(m, n, 0) { Cons(o, xs) } else { Cons(x, insert_op(rest, o)) } }
    }
  }
}
fn ops_data(s: St, ops: List(OpInfo), args: List(Ty), a: Int, b: Int) -> St {
  match ops {
    Nil -> s
    Cons(OpInfo(_, _, all, ps, r), rest) -> {
      let m = zip_params(all, args)
      let tys = subst_list(append(ps, Cons(r, Nil)), m, Nil, Nil)
      match any_not_data(s, tys) {
        R(bad, s2) -> ops_data(if bad { diag(s2, "E0434", "an effect handled by `with any` must be data", a, b) } else { s2 }, rest, args, a, b)
      }
    }
  }
}
fn zip_params(all: List(RPair), args: List(Ty)) -> List(Pair) {
  match all { Nil -> Nil  Cons(RPair(p, _), rest) -> match args { Nil -> Nil  Cons(t, ar) -> Cons(Pair(p, t), zip_params(rest, ar)) } }
}
fn any_not_data(s: St, ts: List(Ty)) -> R(Bool) {
  match ts {
    Nil -> R(False, s)
    Cons(t, rest) -> match resolve(s, t) {
      R(rt, s2) -> match get_eq(s2) {
        R(Eqs(ms, rep, adts), s3) -> match not_data(adts, rt, Nil) { Why(bad, _) -> if bad { R(True, s3) } else { any_not_data(s3, rest) } }
      }
    }
  }
}
// `not_data` on a resolved type.
fn not_data(adts: List(Adt), t: Ty, seen: List(String)) -> Why {
  match t {
    TFn(_, _, _) -> Why(True, seen)
    TVar(_) -> Why(True, seen)
    TCon(n, args) -> match not_data_list(adts, args, seen) {
      Why(True, seen2) -> Why(True, seen2)
      Why(False, seen2) -> decl_not_data(adts, n, seen2)
    }
    _ -> Why(False, seen)
  }
}
fn not_data_list(adts: List(Adt), ts: List(Ty), seen: List(String)) -> Why {
  match ts {
    Nil -> Why(False, seen)
    Cons(t, rest) -> match not_data(adts, t, seen) { Why(True, s2) -> Why(True, s2)  Why(False, s2) -> not_data_list(adts, rest, s2) }
  }
}
fn close_phantoms(s: St, v: Int, n: Int) -> St {
  if v == n { s } else {
    match is_phantom(s, v) {
      R(ph, s2) -> {
        let s3 = if ph {
          match row_bound(s2, v) { R(Row(_, b), s2b) -> match b { RNone -> bind_row(s2b, v, pure_row(), 0, 0)  _ -> s2b } }
        } else { s2 }
        close_phantoms(set_phantom(s3, v, False), v + 1, n)
      }
    }
  }
}
// Step 3: each member generalized; at the top level the environment holds
// only closed schemes, so every free variable and row variable is
// quantified.
fn schemes_of(s: St, fns: List(FnInfo), ms: List(Mem), env: List(Entry), lines: List(SchemeLine)) -> R(Out) {
  match ms {
    Nil -> R(Out(env, lines), s)
    Cons(Mem(i, ps, amb, result, _, _, _), rest) -> match nth_fn(fns, i) {
      FnInfo(name, _, _, _, _, _, _) -> match resolve(s, TFn(ps, ropen(amb), result)) {
        R(rt, s2) -> {
          let sc = Scheme(rev(free_vars(rt, Nil)), rev(free_rows(rt, Nil)), rt)
          schemes_of(s2, fns, rest, Cons(Entry(name, sc), env), Cons(SchemeLine(name, show_scheme(sc)), lines))
        }
      }
    }
  }
}
fn groups(s: St, fns: List(FnInfo), gs: List(List(Int)), env: List(Entry), lines: List(SchemeLine)) -> R(List(SchemeLine)) {
  match gs {
    Nil -> R(lines, s)
    Cons(g, rest) -> match group(s, fns, g, env) {
      R(Out(env2, more), s2) -> groups(s2, fns, rest, env2, rev_onto(rev(more), lines))
    }
  }
}

// ---- Printing (`write_ty`, `display_scheme`, `TyPrinter`) -----------------------

// A name given: a type variable (kind 0) or a row variable (kind 1); the
// two kinds share one count of letters (`Names`).
type Name { Name(Int, Int, String) }
linear type Names { Names(List(Name), Int) }
linear type Shown { Shown(String, Names) }
fn letter(i: Int) -> String {
  let c = string.slice("abcdefghijklmnopqrstuvwxyz", i % 26, i % 26 + 1)
  if i < 26 { c } else { c <> int.to_string(i / 26) }
}
fn name_get(ns: List(Name), k: Int, v: Int) -> Maybe(String) {
  match ns { Nil -> No  Cons(Name(j, u, n), rest) -> if j == k && u == v { Yes(n) } else { name_get(rest, k, v) } }
}
fn name_kind(names: Names, k: Int, v: Int) -> Shown {
  match names {
    Names(ns, count) -> match name_get(ns, k, v) {
      Yes(n) -> Shown(n, Names(ns, count))
      No -> {
        let n = letter(count)
        Shown(n, Names(Cons(Name(k, v, n), ns), count + 1))
      }
    }
  }
}
fn name_of(names: Names, v: Int) -> Shown { name_kind(names, 0, v) }
fn row_name(names: Names, v: Int) -> Shown { name_kind(names, 1, v) }
// A pure row is invisible; another prints ` / {E, F | e}` (`write_row`).
fn show_row(rw: Row, names: Names) -> Shown {
  match rw {
    Row(Nil, RClosed) -> Shown("", names)
    _ -> match write_row(rw, names) { Shown(w, n2) -> Shown(" / " <> w, n2) }
  }
}
fn write_row(rw: Row, names: Names) -> Shown {
  match rw {
    Row(ls, t) -> match write_labs(ls, names, "") {
      Shown(labs, names2) -> match t {
        ROpen(v) -> match row_name(names2, v) { Shown(n, n2) -> Shown("{" <> labs <> (if labs == "" { "" } else { " | " }) <> n <> "}", n2) }
        RError -> Shown("{" <> labs <> " | <error>}", names2)
        _ -> Shown("{" <> labs <> "}", names2)
      }
    }
  }
}
// A parametric effect prints its arguments (`State(Int)`).
fn write_labs(ls: List(Lab), names: Names, acc: String) -> Shown {
  match ls {
    Nil -> Shown(acc, names)
    Cons(Lab(n, args, _, _), rest) -> {
      let pre = if acc == "" { n } else { acc <> ", " <> n }
      match args {
        Nil -> write_labs(rest, names, pre)
        _ -> match show_list(args, names, "") { Shown(a, n2) -> write_labs(rest, n2, pre <> "(" <> a <> ")") }
      }
    }
  }
}
fn show_labs(ls: List(Lab), acc: String) -> String {
  match ls { Nil -> acc  Cons(Lab(n, _, _, _), rest) -> show_labs(rest, if acc == "" { n } else { acc <> ", " <> n }) }
}
fn show(t: Ty, names: Names) -> Shown {
  match t {
    TVar(v) -> name_of(names, v)
    TB(c) -> Shown(if c == 0 { "Int" } else { if c == 1 { "Float" } else { if c == 2 { "Bool" } else { if c == 3 { "String" } else { "Unit" } } } }, names)
    // A row argument is its row: `Task({Log | a})`, not its phantom.
    TFn(Nil, rw, TCon("$Row", Nil)) -> write_row(rw, names)
    // A `with any` clause's operation: `Op(t / {E})`.
    TCon("$Op", Cons(t, Cons(TFn(_, rw, _), Nil))) -> match show(t, names) {
      Shown(ts, n2) -> match write_row(rw, n2) { Shown(w, n3) -> Shown("Op(" <> ts <> " / " <> w <> ")", n3) }
    }
    TFn(ps, rw, r) -> match show_list(ps, names, "") {
      Shown(p, n2) -> match show_row(rw, n2) {
        Shown(w, n2b) -> match show(r, n2b) { Shown(rs, n3) -> Shown("fn(" <> p <> ")" <> w <> " -> " <> rs, n3) }
      }
    }
    TCon(n, args) -> match args {
      Nil -> Shown(n, names)
      _ -> match show_list(args, names, "") { Shown(a, n2) -> Shown(n <> "(" <> a <> ")", n2) }
    }
    _ -> Shown("<error>", names)
  }
}
fn show_list(xs: List(Ty), names: Names, sep: String) -> Shown {
  match xs {
    Nil -> Shown("", names)
    Cons(x, rest) -> match show(x, names) {
      Shown(a, n2) -> match show_list(rest, n2, ", ") { Shown(b, n3) -> Shown(sep <> a <> b, n3) }
    }
  }
}
fn seed(vs: List(Int), k: Int, names: Names, acc: String) -> Shown {
  match vs {
    Nil -> Shown(acc, names)
    Cons(v, rest) -> match name_kind(names, k, v) {
      Shown(n, n2) -> seed(rest, k, n2, if acc == "" { n } else { acc <> " " <> n })
    }
  }
}
// Quantified type variables named first, then row variables
// (`display_scheme`).
fn show_scheme(sc: Scheme) -> String {
  match sc {
    Scheme(vars, rvars, t) -> match seed(vars, 0, Names(Nil, 0), "") {
      Shown(q1, n1) -> match seed(rvars, 1, n1, q1) {
        Shown(q, n2) -> match show(t, n2) {
          Shown(body, _) -> if q == "" { body } else { "forall " <> q <> ". " <> body }
        }
      }
    }
  }
}

// ---- Sorting and the dump -------------------------------------------------------

fn str_lt(a: String, b: String, i: Int) -> Bool {
  if i == string.length(a) { i < string.length(b) } else {
    if i == string.length(b) { False } else {
      let x = string.byte_at(a, i)
      let y = string.byte_at(b, i)
      if x == y { str_lt(a, b, i + 1) } else { x < y }
    }
  }
}
fn line_le(a: SchemeLine, b: SchemeLine) -> Bool {
  match a {
    SchemeLine(n1, s1) -> match b {
      SchemeLine(n2, s2) -> if n1 == n2 { !str_lt(s2, s1, 0) } else { str_lt(n1, n2, 0) }
    }
  }
}
fn rec_le(a: Rec, b: Rec) -> Bool {
  match a { Rec(s1, e1, _) -> match b { Rec(s2, e2, _) -> s1 < s2 || s1 == s2 && e1 <= e2 } }
}
type Halves(a) { Halves(List(a), List(a)) }
fn split(xs: List(a), l: List(a), r: List(a)) -> Halves(a) {
  match xs {
    Nil -> Halves(l, r)
    Cons(x, rest) -> split(rest, r, Cons(x, l))
  }
}
// A stable merge sort: the first of equals stays first.
fn sort_by(xs: List(a), le: fn(a, a) -> Bool) -> List(a) {
  match xs {
    Nil -> Nil
    Cons(_, Nil) -> xs
    _ -> match halve(xs, len(xs) / 2, Nil) {
      Halves(l, r) -> merge(sort_by(l, le), sort_by(r, le), le, Nil)
    }
  }
}
fn halve(xs: List(a), n: Int, acc: List(a)) -> Halves(a) {
  if n == 0 { Halves(rev(acc), xs) } else {
    match xs { Nil -> Halves(rev(acc), Nil)  Cons(x, rest) -> halve(rest, n - 1, Cons(x, acc)) }
  }
}
fn merge(l: List(a), r: List(a), le: fn(a, a) -> Bool, acc: List(a)) -> List(a) {
  match l {
    Nil -> rev_onto(acc, r)
    Cons(x, lr) -> match r {
      Nil -> rev_onto(acc, l)
      Cons(y, rr) -> if le(x, y) { merge(lr, r, le, Cons(x, acc)) } else { merge(l, rr, le, Cons(y, acc)) }
    }
  }
}
// After a stable sort of the newest-first records, the first of each span
// is the last recorded there.
fn last_per_span(rs: List(Rec), prev_s: Int, prev_e: Int, acc: List(Rec)) -> List(Rec) {
  match rs {
    Nil -> rev(acc)
    Cons(Rec(s, e, t), rest) -> if s == prev_s && e == prev_e { last_per_span(rest, s, e, acc) } else {
      last_per_span(rest, s, e, Cons(Rec(s, e, t), acc))
    }
  }
}
fn quoted(m: String) -> String { "\"" <> m <> "\"" }

fn dump_types(s: St, rs: List(Rec), b: Buffer) -> R(Buffer) {
  match rs {
    Nil -> R(b, s)
    Cons(Rec(start, end, t), rest) -> match resolve(s, t) {
      R(rt, s2) -> match show(rt, Names(Nil, 0)) {
        Shown(text, _) -> dump_types(s2, rest, buffer.push(b, "type " <> int.to_string(start) <> " " <> int.to_string(end) <> " " <> text <> "\n"))
      }
    }
  }
}
fn dump_schemes(ls: List(SchemeLine), b: Buffer) -> Buffer {
  match ls {
    Nil -> b
    Cons(SchemeLine(n, sc), rest) -> dump_schemes(rest, buffer.push(b, "scheme " <> n <> " " <> sc <> "\n"))
  }
}
fn any_error(ds: List(Diag)) -> Bool {
  match ds { Nil -> False  Cons(Diag(k, _, _, _, _), rest) -> k == "error" || any_error(rest) }
}
fn dump_diags(ds: List(Diag), b: Buffer) -> Buffer {
  match ds {
    Nil -> b
    Cons(Diag(kind, code, msg, start, end), rest) -> dump_diags(rest, buffer.push(b, kind <> " " <> code <> " " <> int.to_string(start) <> " " <> int.to_string(end) <> " " <> quoted(msg) <> "\n"))
  }
}

// The pattern's bindings noted once it is all checked (`bind_arm_pattern`).
fn note_pat(s: St, p: Sp(Pattern), env: List(Entry)) -> St {
  match p {
    Sp(PVar(x), a, b) -> match lookup(env, x) { Yes(sc) -> note_binder(s, a, b, x, sc)  No -> s }
    Sp(PCtor(_, args), _, _) -> note_pats(s, args, env)
    _ -> s
  }
}
fn note_pats(s: St, ps: List(Sp(Pattern)), env: List(Entry)) -> St {
  match ps { Nil -> s  Cons(p, rest) -> note_pats(note_pat(s, p, env), rest, env) }
}

type Ran { Ran(List(SchemeLine), St) }
// Inference over the whole module: the scheme lines and the final state.
fn infer_module(m: Module, size: Int) -> Ran {
  match m {
    Module(_, decls) -> {
      let af0 = Af(affine.facts(m, size), Nil, Nil, Nil, Nil, Nil, Cons("Buffer", Cons("Array", linear_names(decls, Nil))))
      let fns = fn_infos(decls, Nil)
      let order = tarjan(all_edges(fns, fns, Nil), len(fns))
      let known = Cons(Arity("Array", 1), known_types(decls, Nil))
      let st0 = St(array.new(), array.new(), 0, Nil, Nil, Ctx(Nil, known, Nil, Nil, Nil, decl_kinds(decls)), Rows(array.new(), array.new(), array.new()), Gx(Nil, Nil, Nil, Nil, Nil, Nil, Nil), Eqs(Nil, Nil, Nil), Hx(Nil, Nil, 0, Nil, Nil, Nil, Nil, Gn(0, Nil, Nil), af0))
      let st1 = set_hx(st0, Hx(Nil, Nil, 0, Nil, effect_names(decls, Nil), Nil, multi_names(decls, Nil), Gn(0, Nil, Nil), af0))
      let declared = match type_decls(st1, decls, Nil) { R(env0, s0) -> R(env0, effect_decls(s0, decls)) }
      match match declared { R(env0, s0) -> groups(s0, fns, order, env0, Nil) } {
        R(lines, s) -> Ran(lines, s)
      }
    }
  }
}
// The diagnostics in order, the affine ones after the others and only when
// there is no other error (D7, `with_affine`).
fn all_diags(ds0: List(Diag), hx: Hx) -> List(Diag) {
  match hx {
    Hx(_, _, _, _, _, _, _, _, Af(_, _, _, _, _, ad, _)) -> rev(if any_error(ds0) { ds0 } else { append(ad, ds0) })
  }
}

pub fn check_dump(m: Module, size: Int) -> String {
  match infer_module(m, size) {
    Ran(lines, s) -> match s {
      St(sub, lv, cur, ds0, rs, cx, rw, gx, eq, hx) -> {
        let ds = all_diags(ds0, hx)
        let b1 = dump_schemes(sort_by(rev(lines), line_le), buffer.new())
        let recs = last_per_span(sort_by(rs, rec_le), 0 - 1, 0 - 1, Nil)
        match dump_types(St(sub, lv, cur, Nil, Nil, cx, rw, gx, eq, hx), recs, b1) {
          R(b2, _) -> buffer.finish(dump_diags(ds, b2))
        }
      }
    }
  }
}

// What Core reads (self-hosting part 5, spec 2026-11-27-elya-backend-in-elya
// D3): every node's type by span, sorted, each resolved through the final
// substitution, so one variable is one `TVar` across the whole module; and
// whether the program has an error.
type Typed { Typed(List(Rec), Bool) }
fn resolve_recs(s: St, rs: List(Rec), acc: List(Rec)) -> List(Rec) {
  match rs {
    Nil -> rev(acc)
    Cons(Rec(a, b, t), rest) -> match resolve(s, t) { R(rt, s2) -> resolve_recs(s2, rest, Cons(Rec(a, b, rt), acc)) }
  }
}
pub fn typed(m: Module, size: Int) -> Typed {
  match infer_module(m, size) {
    Ran(_, s) -> match s {
      St(sub, lv, cur, ds0, rs, cx, rw, gx, eq, hx) -> {
        let err = any_error(all_diags(ds0, hx))
        let recs = last_per_span(sort_by(rs, rec_le), 0 - 1, 0 - 1, Nil)
        Typed(resolve_recs(St(sub, lv, cur, Nil, Nil, cx, rw, gx, eq, hx), recs, Nil), err)
      }
    }
  }
}
pub fn show_ty(t: Ty, names: Names) -> Shown { show(t, names) }

// The checker's diagnostics in the dump form, for the driver (spec
// 2026-11-27-elya-the-switch D2), and whether one is an error.
type Checked { Checked(String, Bool) }
pub fn diagnostics(m: Module, size: Int) -> Checked {
  match infer_module(m, size) {
    Ran(_, s) -> match s {
      St(_, _, _, ds0, _, _, _, _, _, hx) -> {
        let ds = all_diags(ds0, hx)
        Checked(buffer.finish(dump_diags(ds, buffer.new())), any_error(ds))
      }
    }
  }
}
pub fn no_names() -> Names { Names(Nil, 0) }

pub fn main() / {IO} {
  let text = io.read_file(io.arg(0))
  match parse.parse_tree(text) {
    Parsed(m, _) -> {
      let out = check_dump(m, string.length(text))
      if string.length(out) == 0 { Unit } else { io.println(string.slice(out, 0, string.length(out) - 1)) }
    }
    ParseError(_, _, _) -> Unit
  }
}
