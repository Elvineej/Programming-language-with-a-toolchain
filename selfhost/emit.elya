// The back end in Elya, stage B1 (spec
// docs/superpowers/specs/2026-11-27-elya-backend-in-elya-design.md D6):
// first-order `Int`, `Bool` and `Unit` programs, written as LLVM IR text
// that `clang` compiles with the runtime the Rust back end links
// (crates/codegen/src/runtime.c). Checked by running both programs (D2).
//
// Values as the Rust back end lays them out (D4): `Int` and `Unit` an `i64`,
// `Bool` an `i1`, a `String` a `ptr` the runtime made. Every function is
// `tailcc` and a call in tail position `musttail` (D5). Anything outside the
// stage is refused by name before any IR is written.
import parse / {IO}
import check / {IO}
import core / {IO}
import mono / {IO}
import resolve / {IO}

fn rev_onto(xs: List(a), acc: List(a)) -> List(a) {
  match xs { Nil -> acc  Cons(x, rest) -> rev_onto(rest, Cons(x, acc)) }
}
fn rev(xs: List(a)) -> List(a) { rev_onto(xs, Nil) }

// ---- Types ------------------------------------------------------------------

type LTy { LI64, LI1, LPtr, LNone }
fn lt_of(t: Ty) -> LTy {
  match t {
    TB(0) -> LI64
    // A float is a word of its bits (spec 2026-11-28-elya-float-in-elya D4).
    TB(1) -> LI64
    TB(2) -> LI1
    TB(4) -> LI64
    TB(3) -> LPtr
    TCon(_, _) -> LPtr
    TFn(_, _, _) -> LPtr
    _ -> LNone
  }
}
fn lt_text(t: LTy) -> String {
  match t { LI64 -> "i64"  LI1 -> "i1"  LPtr -> "ptr"  LNone -> "?" }
}

// ---- Refusal: the stage's fragment -----------------------------------------

type Stage { InStage, Outside(String) }
fn first(a: Stage, b: Stage) -> Stage { match a { InStage -> b  Outside(w) -> Outside(w) } }
fn ty_ok(t: Ty) -> Stage { match lt_of(t) { LNone -> Outside("a value of a type outside the stage")  LPtr -> InStage  _ -> InStage } }
fn builtins() -> List(String) {
  Cons("io.println", Cons("int.to_string", Cons("string.length", Cons("string.byte_at", Cons("string.slice", Cons("int.wrapping_add", Cons("int.wrapping_sub", Cons("int.wrapping_mul", Cons("int.and", Cons("int.or", Cons("int.xor", Cons("int.shl", Cons("int.shr", Cons("int.ushr", Cons("array.new", Cons("array.push", Cons("array.set", Cons("array.get", Cons("array.length", Cons("buffer.new", Cons("buffer.push", Cons("buffer.finish", Cons("buffer.length", Cons("io.read_file", Cons("io.file_exists", Cons("io.write_file", Cons("io.read_stdin", Cons("io.arg_count", Cons("io.arg", Cons("io.run", Cons("io.exit", Cons("io.os", Cons("float.to_string", Cons("float.of_int", Cons("float.truncate", Cons("float.round", Cons("float.parse", Cons("float.to_bits", Cons("float.of_bits", Nil)))))))))))))))))))))))))))))))))))))))
}
fn builtin_ok(n: String) -> Stage {
  if has(builtins(), n) { InStage } else { Outside("builtin " <> n) }
}
fn prim_ok(op: String) -> Stage {
  if op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" || op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" || op == "Concat" || op == "AddF" || op == "SubF" || op == "MulF" || op == "DivF" || op == "LtF" || op == "LeF" || op == "GtF" || op == "GeF" { InStage } else { Outside("operator " <> op) }
}
fn has_fn(fs: List(CFn), n: String) -> Bool {
  match fs { Nil -> False  Cons(CFn(m, _, _), rest) -> m == n || has_fn(rest, n) }
}
fn has(xs: List(String), x: String) -> Bool { match xs { Nil -> False  Cons(y, rest) -> y == x || has(rest, x) } }
fn param_names(ps: List(CParam), acc: List(String)) -> List(String) {
  match ps { Nil -> acc  Cons(CParam(n, _), rest) -> param_names(rest, Cons(n, acc)) }
}
fn check_all(fs: List(CFn), locals: List(String), xs: List(CExpr)) -> Stage {
  match xs { Nil -> InStage  Cons(x, rest) -> first(check_expr(fs, locals, x), check_all(fs, locals, rest)) }
}
fn eq_operand(op: String, x: CExpr) -> Stage {
  match x {
    CExpr(_, _, t, _) -> if (op == "Eq" || op == "Ne") { match lt_of(t) { LNone -> Outside("== on a type outside the stage")  _ -> InStage } } else {
      if op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" { match t { TB(0) -> InStage  _ -> Outside("an ordering of a type outside the stage") } } else { InStage }
    }
  }
}
fn check_expr(fs: List(CFn), locals: List(String), e: CExpr) -> Stage {
  match e {
    CExpr(_, _, t, k) -> first(ty_ok(t), match k {
      KLit(LStr(_)) -> InStage
      KLit(_) -> InStage
      KVar(n) -> if has(locals, n) || has_fn(fs, n) { InStage } else { Outside("a name outside the stage") }
      KApp(f, args) -> check_all(fs, locals, Cons(f, args))
      KBuiltin(n, args) -> first(builtin_ok(n), check_all(fs, locals, args))
      KPrim(op, args) -> first(prim_ok(op), first(match args { Cons(x, _) -> eq_operand(op, x)  Nil -> InStage }, check_all(fs, locals, args)))
      KLet(n, v, b) -> first(check_expr(fs, locals, v), check_expr(fs, Cons(n, locals), b))
      KIf(c, a, b) -> first(check_expr(fs, locals, c), first(check_expr(fs, locals, a), check_expr(fs, locals, b)))
      KCtor(_, args) -> check_all(fs, locals, args)
      KLambda(ps, b) -> first(check_params(ps), first(if count_in(free_vars(b, param_names(ps, Nil), Nil), locals, 0) > 61 { Outside("a closure of more than 61 captures") } else { InStage }, check_expr(fs, param_names(ps, locals), b)))
      KMatch(sc, arms) -> first(check_expr(fs, locals, sc), check_arms(fs, locals, arms))
      KHandle(body, _, cs, ret) -> first(check_expr(fs, locals, body), first(check_clauses(fs, locals, cs), match ret { No -> InStage  Yes(CRet(n, rb)) -> check_expr(fs, Cons(n, locals), rb) }))
      KResume(v) -> check_expr(fs, locals, v)
      KPerform(_, _, _, args) -> check_all(fs, locals, args)
    })
  }
}
fn pat_names(p: CPat, acc: List(String)) -> List(String) {
  match p { QVar(n) -> Cons(n, acc)  QCtor(_, args) -> pats_names(args, acc)  _ -> acc }
}
fn pats_names(ps: List(CPat), acc: List(String)) -> List(String) {
  match ps { Nil -> acc  Cons(p, rest) -> pats_names(rest, pat_names(p, acc)) }
}
fn check_arms(fs: List(CFn), locals: List(String), arms: List(CArm)) -> Stage {
  match arms { Nil -> InStage  Cons(CArm(p, b), rest) -> first(check_expr(fs, pat_names(p, locals), b), check_arms(fs, locals, rest)) }
}
fn check_clauses(fs: List(CFn), locals: List(String), cs: List(CClause)) -> Stage {
  match cs { Nil -> InStage  Cons(CClause(_, _, ps, b), rest) -> first(check_params(ps), first(check_expr(fs, param_names(ps, locals), b), check_clauses(fs, locals, rest))) }
}
fn check_params(ps: List(CParam)) -> Stage {
  match ps { Nil -> InStage  Cons(CParam(_, t), rest) -> first(ty_ok(t), check_params(rest)) }
}
fn check_fns(all: List(CFn), fs: List(CFn)) -> Stage {
  match fs {
    Nil -> match main_type(all) { LI64 -> InStage  LI1 -> InStage  _ -> Outside("`main` of a type outside the stage") }
    Cons(CFn(_, ps, body), rest) -> first(check_params(ps), first(check_expr(all, param_names(ps, Nil), body), check_fns(all, rest)))
  }
}
fn main_type(fs: List(CFn)) -> LTy {
  match fs { Nil -> LNone  Cons(CFn(n, _, CExpr(_, _, t, _)), rest) -> if n == "main" { lt_of(t) } else { main_type(rest) } }
}
// A row's pointer mask is one word: a constructor's fields from bit 0, a
// closure's captures from bit 1 (after its code), so 62 fields and 61
// captures at most; Rust's wider rows (mask words) are not in the stage.
fn count_in(ns: List(String), locals: List(String), n: Int) -> Int {
  match ns { Nil -> n  Cons(x, rest) -> count_in(rest, locals, if has(locals, x) { n + 1 } else { n }) }
}
fn check_ctors(cs: List(CCtor)) -> Stage {
  match cs { Nil -> InStage  Cons(CCtor(_, fs), rest) -> if len_tys(fs, 0) > 62 { Outside("a constructor of more than 62 fields") } else { check_ctors(rest) } }
}
fn check_types(ts: List(CType)) -> Stage {
  match ts { Nil -> InStage  Cons(CType(_, cs), rest) -> first(check_ctors(cs), check_types(rest)) }
}
fn check_generics(gs: List(CGeneric)) -> Stage {
  match gs { Nil -> InStage  Cons(CGeneric(_, _, cs), rest) -> first(check_ctors(cs), first(if wide_fields(cs) { Outside("a parametric type's field of a function of more than three parameters") } else { InStage }, check_generics(rest))) }
}
// A record is a ground type, so a parametric type's field cannot need one.
fn wide_fn(t: Ty) -> Bool {
  match t { TFn(ps, _, r) -> len_tys(ps, 0) > 3 || wide_fns(ps) || wide_fn(r)  TCon(_, xs) -> wide_fns(xs)  _ -> False }
}
fn wide_fns(ts: List(Ty)) -> Bool { match ts { Nil -> False  Cons(t, rest) -> wide_fn(t) || wide_fns(rest) } }
fn wide_fields(cs: List(CCtor)) -> Bool { match cs { Nil -> False  Cons(CCtor(_, fs), rest) -> wide_fns(fs) || wide_fields(rest) } }
fn check_module(m: CModule) -> Stage {
  match m { CModule(ts, gs, fs) -> first(check_types(ts), first(check_generics(gs), first(check_fns(fs, fs), check_effects(fs)))) }
}

// ---- Emission state ---------------------------------------------------------

// The function's lines so far (newest first), the next fresh number, the
// current block's label, and the module's string constants (newest first).
type SConst { SConst(String, String) }
// A function written after the one being written: a lambda's code (its
// number, parameters, body, captures, result) or a top-level function's
// wrapper as a value (its name).
// A site's resumption (its number, the hole's name and type, what it saves,
// the rest of its region) and a handle's functions (its number, body,
// clauses, return clause, what its frame saves, the body's type).
type LJob {
  LamJob(Int, List(CParam), CExpr, List(EBind), LTy), WrapJob(String),
  SiteJob(Int, String, Ty, List(EBind), CExpr),
  HandJob(Int, CExpr, List(CClause), Maybe(CRet), List(EBind), Ty)
}
// The module's string constants, the jobs still to write, the closure rows
// so far (arity and pointer mask, newest first), the closures numbered, the
// functions wrapped (all newest first).
// The effects' rows so far: the site frames' and the handler frames' (both
// newest first; a tag is its base plus its index), and the resumptions
// numbered.
type FRows { FRows(List(Row2), List(Row2), Int) }
type Mx { Mx(List(SConst), List(LJob), List(Row2), Int, List(String), FRows) }
type Row2 { Row2(Int, Int) }
linear type Emit { Emit(Buffer, Int, String, Mx, Int) }
type Val { Val(String, LTy) }
linear type Gotv { Gotv(Val, Emit) }
type EBind { EBind(String, Val) }
type ESig { ESig(String, List(LTy), LTy) }
// A constructor: its name, its tag, its fields' types.
type CInfo { CInfo(String, String, Int, List(Ty)) }
// The module's facts: the functions' signatures, the constructors, the
// string tag (after the constructors, as the descriptor table has it).
// The closures' tags lie between the constructors' and the string's, as
// `elya_eq` reads them.
// Effects (spec 2026-11-28-elya-backend-effects): the CPS functions, every
// (effect, operation) of the module numbered, and the bounds on the site
// frames and handler frames, whose rows follow the array's.
type EffOp { EffOp(String, String) }
type EffCx { EffCx(List(String), List(EffOp), Int, Int) }
type ECx { ECx(List(ESig), List(CInfo), Int, EffCx) }
fn cx_sigs(cx: ECx) -> List(ESig) { match cx { ECx(ss, _, _, _) -> ss } }
fn stag(cx: ECx) -> String { match cx { ECx(_, _, t, _) -> int.to_string(t) } }

fn line(em: Emit, s: String) -> Emit {
  match em { Emit(b, n, l, ss, k) -> Emit(buffer.push(b, "  " <> s <> "\n"), n, l, ss, k) }
}
fn fresh(em: Emit) -> Fresh1 {
  match em { Emit(b, n, l, ss, k) -> Fresh1("%t" <> int.to_string(n), Emit(b, n + 1, l, ss, k)) }
}
linear type Fresh1 { Fresh1(String, Emit) }
fn new_label(em: Emit) -> Fresh1 {
  match em { Emit(b, n, l, ss, k) -> Fresh1("L" <> int.to_string(n), Emit(b, n + 1, l, ss, k)) }
}
fn start_block(em: Emit, label: String) -> Emit {
  match em { Emit(b, n, _, ss, k) -> Emit(buffer.push(b, label <> ":\n"), n, label, ss, k) }
}
fn label_of(em: Emit) -> AtLabel {
  match em { Emit(b, n, l, ss, k) -> AtLabel(l, Emit(b, n, l, ss, k)) }
}
linear type AtLabel { AtLabel(String, Emit) }

fn lookup(env: List(EBind), n: String) -> Val {
  match env { Nil -> Val("undef", LI64)  Cons(EBind(m, v), rest) -> if m == n { v } else { lookup(rest, n) } }
}
fn bound(env: List(EBind), n: String) -> Bool {
  match env { Nil -> False  Cons(EBind(m, _), rest) -> m == n || bound(rest, n) }
}
fn is_fn(cx: ECx, n: String) -> Bool { has_sig(cx_sigs(cx), n) }
fn has_sig(sigs: List(ESig), n: String) -> Bool { match sigs { Nil -> False  Cons(ESig(m, _, _), rest) -> m == n || has_sig(rest, n) } }
fn sig_of(sigs: List(ESig), n: String) -> ESig {
  match sigs { Nil -> ESig(n, Nil, LI64)  Cons(ESig(m, ps, r), rest) -> if m == n { ESig(m, ps, r) } else { sig_of(rest, n) } }
}

// ---- Expressions ------------------------------------------------------------

fn ty_lt(e: CExpr) -> LTy { match e { CExpr(_, _, t, _) -> lt_of(t) } }

fn lit_value(l: CLit) -> String {
  match l { LInt(n) -> int.to_string(n)  LBool(b) -> if b { "true" } else { "false" }  LUnit -> "0"  LFloat(n) -> int.to_string(n)  LNegZero -> "-9223372036854775808"  _ -> "0" }
}

// A string literal: a private constant of its bytes, made a runtime string
// by `elya_str_lit` (the string tag, the bytes, their length).
fn hex_digit(n: Int) -> String { string.slice("0123456789ABCDEF", n, n + 1) }
// The text between escapes; empty between two bytes of one character,
// where a slice would split the character.
fn between(s: String, from: Int, i: Int) -> String { if from < i { string.slice(s, from, i) } else { "" } }
fn ir_bytes(s: String, i: Int, from: Int, b: Buffer) -> Buffer {
  if i >= string.length(s) { buffer.push(b, between(s, from, i)) } else {
    let c = string.byte_at(s, i)
    if c < 32 || c > 126 || c == 34 || c == 92 {
      ir_bytes(s, i + 1, i + 1, buffer.push(buffer.push(b, between(s, from, i)), "\\" <> hex_digit(c / 16) <> hex_digit(c % 16)))
    } else { ir_bytes(s, i + 1, from, b) }
  }
}
// The heap values live across a call that may collect: every pointer the
// scope binds, the operands already computed (`pend`) and the call's own
// arguments are pushed on the runtime's shadow stack before it and popped
// after (D5). Over-rooting a dead value only keeps it a little longer.
fn env_roots(env: List(EBind), acc: List(String)) -> List(String) {
  match env { Nil -> acc  Cons(EBind(_, Val(v, LPtr)), rest) -> env_roots(rest, Cons(v, acc))  Cons(_, rest) -> env_roots(rest, acc) }
}
fn val_roots(vs: List(Val), acc: List(String)) -> List(String) {
  match vs { Nil -> acc  Cons(Val(v, LPtr), rest) -> val_roots(rest, Cons(v, acc))  Cons(_, rest) -> val_roots(rest, acc) }
}
fn push_roots(em: Emit, rs: List(String)) -> Emit {
  match rs { Nil -> em  Cons(r, rest) -> push_roots(line(em, "call void @elya_gc_push(ptr " <> r <> ")"), rest) }
}
fn pop_roots(em: Emit, rs: List(String)) -> Emit {
  match rs { Nil -> em  Cons(_, rest) -> pop_roots(line(em, "call void @elya_gc_pop()"), rest) }
}
fn roots(env: List(EBind), pend: List(Val), args: List(Val)) -> List(String) {
  val_roots(args, val_roots(pend, env_roots(env, Nil)))
}
// A call that may allocate, its result `t` (a void call when `LNone`).
fn rooted(em: Emit, rs: List(String), call: String, t: LTy) -> Gotv {
  match t {
    LNone -> Gotv(Val("0", LI64), pop_roots(line(push_roots(em, rs), call), rs))
    _ -> match fresh(push_roots(em, rs)) { Fresh1(v, em2) -> Gotv(Val(v, t), pop_roots(line(em2, v <> " = " <> call), rs)) }
  }
}

fn str_lit(cx: ECx, em: Emit, rs: List(String), v: String) -> Gotv {
  match em {
    Emit(b, n, l, ss, k) -> {
      let name = "@.str." <> int.to_string(k)
      rooted(Emit(b, n, l, match ss { Mx(cs, js, rws, lk, ws, fr) -> Mx(Cons(SConst(name, v), cs), js, rws, lk, ws, fr) }, k + 1), rs, "call ptr @elya_str_lit(i64 " <> stag(cx) <> ", ptr " <> name <> ", i64 " <> int.to_string(string.length(v)) <> ")", LPtr)
    }
  }
}

linear type Gotvs { Gotvs(List(Val), Emit) }
// Arguments left to right, each computed with the ones before it rooted.
fn emit_args(cx: ECx, env: List(EBind), pend: List(Val), xs: List(CExpr), em: Emit, acc: List(Val)) -> Gotvs {
  match xs {
    Nil -> Gotvs(rev(acc), em)
    Cons(x, rest) -> match emit(cx, env, rev_onto(acc, pend), x, em) { Gotv(v, em2) -> emit_args(cx, env, pend, rest, em2, Cons(v, acc)) }
  }
}
fn arg_list(vs: List(Val)) -> String {
  match vs { Nil -> ""  Cons(Val(s, t), Nil) -> lt_text(t) <> " " <> s  Cons(Val(s, t), rest) -> lt_text(t) <> " " <> s <> ", " <> arg_list(rest) }
}
fn nth(vs: List(Val), i: Int) -> Val {
  match vs { Nil -> Val("undef", LI64)  Cons(v, rest) -> if i == 0 { v } else { nth(rest, i - 1) } }
}
fn vtext(v: Val) -> String { match v { Val(s, _) -> s } }

// A check that stops the program through the runtime when `cond` holds.
fn trap_with(em: Emit, cond: String, fail: String) -> Emit {
  match new_label(em) {
    Fresh1(bad, em2) -> match new_label(em2) {
      Fresh1(ok, em3) -> start_block(line(line(start_block(line(em3, "br i1 " <> cond <> ", label %" <> bad <> ", label %" <> ok), bad), "call void @" <> fail), "unreachable"), ok)
    }
  }
}
fn trap(em: Emit, cond: String, fail: String) -> Emit { trap_with(em, cond, fail <> "()") }
fn checked(em: Emit, intr: String, a: String, b: String) -> Gotv {
  match fresh(em) {
    Fresh1(pair, em2) -> match fresh(line(em2, pair <> " = call { i64, i1 } @llvm." <> intr <> ".with.overflow.i64(i64 " <> a <> ", i64 " <> b <> ")")) {
      Fresh1(v, em3) -> match fresh(line(em3, v <> " = extractvalue { i64, i1 } " <> pair <> ", 0")) {
        Fresh1(o, em4) -> Gotv(Val(v, LI64), trap(line(em4, o <> " = extractvalue { i64, i1 } " <> pair <> ", 1"), o, "elya_int_overflow"))
      }
    }
  }
}
fn assign(em: Emit, rhs: String, t: LTy) -> Gotv {
  match fresh(em) { Fresh1(v, em2) -> Gotv(Val(v, t), line(em2, v <> " = " <> rhs)) }
}
// A shift by more than 63 (or less than 0) stops the program by name.
fn shift(em: Emit, name: String, ins: String, a: String, b: String) -> Gotv {
  match fresh(em) {
    Fresh1(bad, em2) -> assign(trap_with(line(em2, bad <> " = icmp ugt i64 " <> b <> ", 63"), bad, "elya_shift_range(ptr @.name." <> name <> ", i64 " <> b <> ")"), ins <> " i64 " <> a <> ", " <> b, LI64)
  }
}
// A float operation on two words (Rust's `float_prim`): bit casts to
// `double`, IEEE arithmetic (no failure), and back; `==` is `oeq` and `!=`
// `une`, so a NaN is unequal to itself and `-0.0` equals `0.0`; the
// orderings are ordered (false with a NaN).
fn float_prim(op: String, x: String, y: String, em: Emit) -> Gotv {
  match fresh(em) {
    Fresh1(fx, em2) -> match fresh(line(em2, fx <> " = bitcast i64 " <> x <> " to double")) {
      Fresh1(fy, em3) -> {
        let em4 = line(em3, fy <> " = bitcast i64 " <> y <> " to double")
        let arith = if op == "AddF" { "fadd" } else { if op == "SubF" { "fsub" } else { if op == "MulF" { "fmul" } else { if op == "DivF" { "fdiv" } else { "" } } } }
        if arith != "" {
          match fresh(em4) {
            Fresh1(r, em5) -> assign(line(em5, r <> " = " <> arith <> " double " <> fx <> ", " <> fy), "bitcast double " <> r <> " to i64", LI64)
          }
        } else {
          let cc = if op == "Eq" { "oeq" } else { if op == "Ne" { "une" } else { if op == "LtF" { "olt" } else { if op == "LeF" { "ole" } else { if op == "GtF" { "ogt" } else { "oge" } } } } }
          assign(em4, "fcmp " <> cc <> " double " <> fx <> ", " <> fy, LI1)
        }
      }
    }
  }
}
fn prim(cx: ECx, env: List(EBind), pend: List(Val), op: String, is_str: Bool, is_fl: Bool, a: Val, b: Val, em: Emit) -> Gotv {
  if is_fl || string.length(op) == 4 && string.slice(op, 3, 4) == "F" { float_prim(op, vtext(a), vtext(b), em) } else {
  match a {
    Val(x, at) -> match b {
      Val(y, _) -> if op == "Add" { checked(em, "sadd", x, y) } else { if op == "Sub" { checked(em, "ssub", x, y) } else { if op == "Mul" { checked(em, "smul", x, y) } else {
        if op == "Div" {
          match fresh(em) {
            Fresh1(z, em2) -> match fresh(trap(line(em2, z <> " = icmp eq i64 " <> y <> ", 0"), z, "elya_div_zero")) {
              Fresh1(mn, em3) -> match fresh(line(em3, mn <> " = icmp eq i64 " <> x <> ", -9223372036854775808")) {
                Fresh1(m1, em4) -> match fresh(line(em4, m1 <> " = icmp eq i64 " <> y <> ", -1")) {
                  Fresh1(ov, em5) -> assign(trap(line(em5, ov <> " = and i1 " <> mn <> ", " <> m1), ov, "elya_int_overflow"), "sdiv i64 " <> x <> ", " <> y, LI64)
                }
              }
            }
          }
        } else { if op == "Rem" {
          match fresh(em) {
            Fresh1(z, em2) -> match fresh(trap(line(em2, z <> " = icmp eq i64 " <> y <> ", 0"), z, "elya_rem_zero")) {
              Fresh1(m1, em3) -> match fresh(line(em3, m1 <> " = icmp eq i64 " <> y <> ", -1")) {
                Fresh1(d, em4) -> assign(line(em4, d <> " = select i1 " <> m1 <> ", i64 1, i64 " <> y), "srem i64 " <> x <> ", " <> d, LI64)
              }
            }
          }
        } else { if op == "Concat" {
          rooted(em, roots(env, pend, Cons(a, Cons(b, Nil))), "call ptr @elya_str_concat(i64 " <> stag(cx) <> ", ptr " <> x <> ", ptr " <> y <> ")", LPtr)
        } else { if at == LPtr {
          match assign(em, (if is_str { "call i64 @elya_str_eq(ptr " <> x <> ", ptr " <> y <> ")" } else { "call i64 @elya_eq(ptr " <> x <> ", ptr " <> y <> ", i64 " <> stag(cx) <> ", i64 " <> int.to_string(n_ctors(cx)) <> ")" }), LI64) {
            Gotv(Val(r, _), em2) -> assign(em2, "icmp " <> (if op == "Eq" { "ne" } else { "eq" }) <> " i64 " <> r <> ", 0", LI1)
          }
        } else {
          let cc = if op == "Eq" { "eq" } else { if op == "Ne" { "ne" } else { if op == "Lt" { "slt" } else { if op == "Le" { "sle" } else { if op == "Gt" { "sgt" } else { "sge" } } } } }
          assign(em, "icmp " <> cc <> " " <> lt_text(at) <> " " <> x <> ", " <> y, LI1)
        } } } }
      } } }
    }
  }
  }
}

// An array's words: a traced array (its own tag, after the string's) when
// its elements are heap values, else the string's tag, traced nowhere.
fn elem_of(t: Ty) -> Ty { match t { TCon("Array", Cons(e, _)) -> e  _ -> TB(0) } }
fn array_tag(cx: ECx, t: Ty) -> String { match cx { ECx(_, _, st, _) -> int.to_string(if lt_of(elem_of(t)) == LPtr { st + 1 } else { st }) } }
fn builtin(cx: ECx, env: List(EBind), pend: List(Val), n: String, args: List(CExpr), t: Ty, vs: List(Val), em: Emit) -> Gotv {
  let a = vtext(nth(vs, 0))
  let b = vtext(nth(vs, 1))
  let rs = roots(env, pend, vs)
  if string.length(n) > 6 && string.slice(n, 0, 6) == "float." { float_builtin(cx, rs, n, a, em) } else {
  if string.slice(n, 0, 3) == "arr" || string.slice(n, 0, 3) == "buf" || string.slice(n, 0, 3) == "io." && n != "io.println" { io_data(cx, rs, n, args, t, vs, em) } else {
  if n == "int.to_string" { rooted(em, roots(env, pend, vs), "call ptr @elya_int_to_string(i64 " <> stag(cx) <> ", i64 " <> a <> ")", LPtr) } else {
  if n == "io.println" { rooted(em, roots(env, pend, vs), "call void @elya_println(ptr " <> a <> ")", LNone) } else {
  if n == "string.length" { assign(em, "call i64 @elya_str_length(ptr " <> a <> ")", LI64) } else {
  if n == "string.byte_at" { assign(em, "call i64 @elya_str_byte_at(ptr " <> a <> ", i64 " <> b <> ")", LI64) } else {
  if n == "string.slice" { rooted(em, roots(env, pend, vs), "call ptr @elya_str_slice(i64 " <> stag(cx) <> ", ptr " <> a <> ", i64 " <> b <> ", i64 " <> vtext(nth(vs, 2)) <> ")", LPtr) } else {
  if n == "int.wrapping_add" { assign(em, "add i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.wrapping_sub" { assign(em, "sub i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.wrapping_mul" { assign(em, "mul i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.and" { assign(em, "and i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.or" { assign(em, "or i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.xor" { assign(em, "xor i64 " <> a <> ", " <> b, LI64) } else {
  if n == "int.shl" { shift(em, "shl", "shl", a, b) } else {
  if n == "int.shr" { shift(em, "shr", "ashr", a, b) } else {
  if n == "int.ushr" { shift(em, "ushr", "lshr", a, b) } else { unknown(em, n) } } } } } } } } } } } } } } } }
}
// `float.*` (spec 2026-11-28-elya-float-in-elya D4), as the Rust back end
// lowers them: the text and the conversions through the runtime, `of_int` by
// `sitofp`, the bits as the word itself.
fn float_builtin(cx: ECx, rs: List(String), n: String, a: String, em: Emit) -> Gotv {
  if n == "float.to_string" { rooted(em, rs, "call ptr @elya_float_to_string(i64 " <> stag(cx) <> ", i64 " <> a <> ")", LPtr) } else {
  if n == "float.of_int" { match fresh(em) { Fresh1(f, em2) -> assign(line(em2, f <> " = sitofp i64 " <> a <> " to double"), "bitcast double " <> f <> " to i64", LI64) } } else {
  if n == "float.truncate" { assign(em, "call i64 @elya_float_to_int(ptr @.name.truncate, i64 " <> a <> ", i64 0)", LI64) } else {
  if n == "float.round" { assign(em, "call i64 @elya_float_to_int(ptr @.name.round, i64 " <> a <> ", i64 1)", LI64) } else {
  if n == "float.parse" { assign(em, "call i64 @elya_float_parse(ptr " <> a <> ")", LI64) } else {
  if n == "float.to_bits" || n == "float.of_bits" { Gotv(Val(a, LI64), em) } else { unknown(em, n) } } } } } }
}
// A builtin the dispatch does not know: text `clang` refuses, so a list and
// a dispatch that disagree fail the build instead of compiling to undef.
fn unknown(em: Emit, n: String) -> Gotv { assign(em, "unknown builtin " <> n, LI64) }
fn arg_ty(args: List(CExpr)) -> Ty { match args { Cons(CExpr(_, _, t, _), _) -> t  Nil -> TB(4) } }
fn io_data(cx: ECx, rs: List(String), n: String, args: List(CExpr), t: Ty, vs: List(Val), em: Emit) -> Gotv {
  let a = vtext(nth(vs, 0))
  let b = vtext(nth(vs, 1))
  let st = stag(cx)
  if n == "array.new" { rooted(em, rs, "call ptr @elya_array_new(i64 " <> array_tag(cx, t) <> ")", LPtr) } else {
  if n == "array.push" { match to_word(em, nth(vs, 1)) { Gotv(Val(w, _), em2) -> rooted(em2, rs, "call ptr @elya_array_push(ptr " <> a <> ", i64 " <> w <> ")", LPtr) } } else {
  if n == "array.set" { match to_word(em, nth(vs, 2)) { Gotv(Val(w, _), em2) -> rooted(em2, rs, "call ptr @elya_array_set(ptr " <> a <> ", i64 " <> b <> ", i64 " <> w <> ")", LPtr) } } else {
  if n == "array.get" { match assign(em, "call i64 @elya_array_get(ptr " <> a <> ", i64 " <> b <> ")", LI64) { Gotv(Val(w, _), em2) -> from_word(em2, w, lt_of(t)) } } else {
  if n == "array.length" || n == "buffer.length" { assign(em, "call i64 @elya_array_length(ptr " <> a <> ")", LI64) } else {
  if n == "buffer.new" { rooted(em, rs, "call ptr @elya_buffer_new(i64 " <> st <> ")", LPtr) } else {
  if n == "buffer.push" { rooted(em, rs, "call ptr @elya_buffer_push(i64 " <> st <> ", ptr " <> a <> ", ptr " <> b <> ")", LPtr) } else {
  if n == "buffer.finish" { rooted(em, rs, "call ptr @elya_buffer_finish(i64 " <> st <> ", ptr " <> a <> ")", LPtr) } else {
  if n == "io.read_file" { rooted(em, rs, "call ptr @elya_io_read_file(i64 " <> st <> ", ptr " <> a <> ")", LPtr) } else {
  if n == "io.file_exists" { match assign(em, "call i64 @elya_io_file_exists(ptr " <> a <> ")", LI64) { Gotv(Val(w, _), em2) -> assign(em2, "icmp ne i64 " <> w <> ", 0", LI1) } } else {
  if n == "io.write_file" { rooted(em, rs, "call void @elya_io_write_file(ptr " <> a <> ", ptr " <> b <> ")", LNone) } else {
  if n == "io.read_stdin" { rooted(em, rs, "call ptr @elya_io_read_stdin(i64 " <> st <> ")", LPtr) } else {
  if n == "io.arg_count" { assign(em, "call i64 @elya_io_arg_count()", LI64) } else {
  if n == "io.run" { rooted(em, rs, "call i64 @elya_io_run(ptr " <> a <> ")", LI64) } else {
  if n == "io.exit" { rooted(em, rs, "call void @elya_io_exit(i64 " <> a <> ")", LNone) } else {
  if n == "io.os" { rooted(em, rs, "call ptr @elya_io_os(i64 " <> st <> ")", LPtr) } else {
  if n == "io.arg" { rooted(em, rs, "call ptr @elya_io_arg(i64 " <> st <> ", i64 " <> a <> ")", LPtr) } else { unknown(em, n) } } } } } } } } } } } } } } } } }
}

fn emit(cx: ECx, env: List(EBind), pend: List(Val), e: CExpr, em: Emit) -> Gotv {
  match e {
    CExpr(_, _, t, k) -> match k {
      KLit(LStr(v)) -> str_lit(cx, em, roots(env, pend, Nil), v)
      KLit(l) -> Gotv(Val(lit_value(l), lt_of(t)), em)
      KVar(n) -> if bound(env, n) || !is_fn(cx, n) { Gotv(lookup(env, n), em) } else { fn_value(cx, env, pend, n, em) }
      KLambda(ps, body) -> lambda(cx, env, pend, ps, body, t, em)
      KLet(n, v, b) -> match emit(cx, env, pend, v, em) { Gotv(val, em2) -> emit(cx, Cons(EBind(n, val), env), pend, b, em2) }
      KPrim(op, Cons(a, Cons(b, Nil))) -> match emit(cx, env, pend, a, em) {
        Gotv(va, em2) -> match emit(cx, env, Cons(va, pend), b, em2) { Gotv(vb, em3) -> prim(cx, env, pend, op, is_string(a), is_float(a), va, vb, em3) }
      }
      KCtor(n, Nil) -> match t {
        // A constructor with fields used as a value: `fn(a1, .., an) { C(a1, .., an) }`.
        TFn(ps, _, r) -> lambda(cx, env, pend, ctor_params(ps, 0), CExpr(0, 0, r, KCtor(n, ctor_args(ps, 0))), t, em)
        _ -> construct(cx, env, pend, n, t, Nil, em)
      }
      KCtor(n, args) -> match emit_args(cx, env, pend, args, em, Nil) { Gotvs(vs, em2) -> construct(cx, env, pend, n, t, vs, em2) }
      KMatch(sc, arms) -> match emit(cx, env, pend, sc, em) {
        Gotv(sv, em2) -> match new_label(em2) {
          Fresh1(join, em3) -> match emit_arms(cx, env, pend, sv, ty_of(sc), arms, em3, join, Nil, TNo) {
            Arms(ins, em4) -> assign(start_block(em4, join), "phi " <> lt_text(lt_of(t)) <> " " <> phi_ins(ins), lt_of(t))
          }
        }
      }
      KBuiltin(n, args) -> match emit_args(cx, env, pend, args, em, Nil) { Gotvs(vs, em2) -> builtin(cx, env, pend, n, args, t, vs, em2) }
      KApp(CExpr(_, _, _, KVar(f)), args) -> if bound(env, f) || !is_fn(cx, f) { closure_call(cx, env, pend, e, em, No) } else {
        match emit_args(cx, env, pend, args, em, Nil) {
          Gotvs(vs, em2) -> match sig_of(cx_sigs(cx), f) { ESig(_, _, r) -> rooted(em2, roots(env, pend, vs), "call tailcc " <> lt_text(r) <> " @elya." <> f <> "(" <> arg_list(vs) <> ")", r) }
        }
      }
      KApp(_, _) -> closure_call(cx, env, pend, e, em, No)
      KIf(c, a, b) -> match emit(cx, env, pend, c, em) {
        Gotv(Val(cv, _), em2) -> match new_label(em2) {
          Fresh1(lt, em3) -> match new_label(em3) {
            Fresh1(lf, em4) -> match new_label(em4) {
              Fresh1(lj, em5) -> match emit(cx, env, pend, a, start_block(line(em5, "br i1 " <> cv <> ", label %" <> lt <> ", label %" <> lf), lt)) {
                Gotv(Val(av, _), em6) -> match label_of(em6) {
                  AtLabel(la, em7) -> match emit(cx, env, pend, b, start_block(line(em7, "br label %" <> lj), lf)) {
                    Gotv(Val(bv, _), em8) -> match label_of(em8) {
                      AtLabel(lb, em9) -> assign(start_block(line(em9, "br label %" <> lj), lj), "phi " <> lt_text(lt_of(t)) <> " [ " <> av <> ", %" <> la <> " ], [ " <> bv <> ", %" <> lb <> " ]", lt_of(t))
                    }
                  }
                }
              }
            }
          }
        }
      }
      KHandle(body, _, cs, ret) -> emit_handle(cx, env, pend, body, cs, ret, t, em)
      KResume(v) -> match emit(cx, env, pend, v, em) {
        Gotv(val, em2) -> match resume_start(env, val, em2) {
          Resumed(w, rk, rc, rp, em3) -> match rooted(em3, roots(env, pend, Nil), "call tailcc i64 " <> rc <> "(i64 " <> w <> ", ptr " <> rk <> ")", LI64) {
            Gotv(Val(r, _), em4) -> from_word(line(em4, "store ptr " <> rp <> ", ptr @elya_current_handler"), r, lt_of(t))
          }
        }
      }
      // A site never reaches direct code (the pre-pass names every one); if
      // one did, the IR fails to build rather than compute `undef`.
      _ -> unknown(em, "a site in direct code")
    }
  }
}

// An expression in tail position: its value returned, a call of a function
// `musttail` (the caller's and the callee's results are one type there;
// nothing of the caller's is live after it, so nothing is rooted).
fn emit_tail(cx: ECx, env: List(EBind), e: CExpr, em: Emit, r: LTy) -> Emit {
  match e {
    CExpr(_, _, t, k) -> match k {
      KLet(n, v, b) -> match emit(cx, env, Nil, v, em) { Gotv(val, em2) -> emit_tail(cx, Cons(EBind(n, val), env), b, em2, r) }
      KIf(c, a, b) -> match emit(cx, env, Nil, c, em) {
        Gotv(Val(cv, _), em2) -> match new_label(em2) {
          Fresh1(lt, em3) -> match new_label(em3) {
            Fresh1(lf, em4) -> emit_tail(cx, env, b, start_block(emit_tail(cx, env, a, start_block(line(em4, "br i1 " <> cv <> ", label %" <> lt <> ", label %" <> lf), lt), r), lf), r)
          }
        }
      }
      KMatch(sc, arms) -> match emit(cx, env, Nil, sc, em) {
        Gotv(sv, em2) -> match emit_arms(cx, env, Nil, sv, ty_of(sc), arms, em2, "", Nil, TDir(r)) { Arms(_, em3) -> em3 }
      }
      KApp(CExpr(_, _, _, KVar(f)), args) -> if bound(env, f) || !is_fn(cx, f) { match closure_call(cx, env, Nil, e, em, Yes(r)) { Gotv(_, em2) -> em2 } } else {
        match emit_args(cx, env, Nil, args, em, Nil) {
          Gotvs(vs, em2) -> match fresh(em2) {
            Fresh1(v, em3) -> line(line(em3, v <> " = musttail call tailcc " <> lt_text(r) <> " @elya." <> f <> "(" <> arg_list(vs) <> ")"), "ret " <> lt_text(r) <> " " <> v)
          }
        }
      }
      KApp(_, _) -> match closure_call(cx, env, Nil, e, em, Yes(r)) { Gotv(_, em2) -> em2 }
      _ -> match emit(cx, env, Nil, e, em) { Gotv(Val(v, _), em2) -> line(em2, "ret " <> lt_text(r) <> " " <> v) }
    }
  }
}

// ---- Closures -----------------------------------------------------------------

// A closure is `[tag][code][captures...]`; its code takes the closure first,
// then the arguments (the Rust back end's convention).
fn closure_call(cx: ECx, env: List(EBind), pend: List(Val), e: CExpr, em: Emit, tail: Maybe(LTy)) -> Gotv {
  match e {
    CExpr(_, _, t, KApp(callee, args)) -> match emit(cx, env, pend, callee, em) {
      Gotv(clo, em2) -> match emit_args(cx, env, Cons(clo, pend), args, em2, Nil) {
        Gotvs(vs, em3) -> match fresh(em3) {
          Fresh1(cp, em4) -> match fresh(line(em4, cp <> " = getelementptr i64, ptr " <> vtext(clo) <> ", i64 1")) {
            Fresh1(cw, em5) -> match fresh(line(em5, cw <> " = load i64, ptr " <> cp)) {
              Fresh1(code, em6) -> {
                let em7 = line(em6, code <> " = inttoptr i64 " <> cw <> " to ptr")
                let r = lt_of(t)
                let call = "tailcc " <> lt_text(r) <> " " <> code <> "(" <> arg_list(Cons(clo, vs)) <> ")"
                match tail {
                  Yes(rt) -> match fresh(em7) { Fresh1(v, em8) -> Gotv(Val(v, rt), line(line(em8, v <> " = musttail call " <> call), "ret " <> lt_text(rt) <> " " <> v)) }
                  No -> rooted(em7, roots(env, pend, Cons(clo, vs)), "call " <> call, r)
                }
              }
            }
          }
        }
      }
    }
    _ -> Gotv(Val("undef", LI64), em)
  }
}

// A closure's tag: the next after the constructors', its row recorded.
linear type Numbered { Numbered(Int, Emit) }
fn new_closure(em: Emit, arity: Int, mask: Int, job: LJob) -> Numbered {
  match em {
    Emit(b, n, l, Mx(cs, js, rws, lk, ws, fr), k) -> Numbered(lk, Emit(b, n, l, Mx(cs, Cons(job, js), Cons(Row2(arity, mask), rws), lk + 1, ws, fr), k))
  }
}
fn cap_mask(caps: List(EBind), bit: Int, acc: Int) -> Int {
  match caps { Nil -> acc  Cons(EBind(_, Val(_, t)), rest) -> cap_mask(rest, bit * 2, if t == LPtr { acc + bit } else { acc }) }
}
fn cap_vals(caps: List(EBind)) -> List(Val) { match caps { Nil -> Nil  Cons(EBind(_, v), rest) -> Cons(v, cap_vals(rest)) } }
fn alloc_closure(cx: ECx, env: List(EBind), pend: List(Val), tag: Int, code: String, caps: List(Val), em: Emit) -> Gotv {
  match rooted(em, roots(env, pend, caps), "call ptr @elya_alloc(i64 " <> int.to_string(2 + len_vals(caps, 0)) <> ")", LPtr) {
    Gotv(Val(obj, _), em2) -> match fresh(line(em2, "store i64 " <> int.to_string(tag) <> ", ptr " <> obj)) {
      Fresh1(cp, em3) -> Gotv(Val(obj, LPtr), store_fields(line(line(em3, cp <> " = getelementptr i64, ptr " <> obj <> ", i64 1"), "store i64 ptrtoint (ptr " <> code <> " to i64), ptr " <> cp), obj, caps, 2))
    }
  }
}
fn lambda(cx: ECx, env: List(EBind), pend: List(Val), ps: List(CParam), body: CExpr, t: Ty, em: Emit) -> Gotv {
  let caps = captures(env, free_vars(body, param_names(ps, Nil), Nil), Nil)
  let r = match t { TFn(_, _, rt) -> lt_of(rt)  _ -> LI64 }
  match em {
    Emit(b, n, l, Mx(cs, js, rws, lk, ws, fr), k) -> match new_closure(Emit(b, n, l, Mx(cs, js, rws, lk, ws, fr), k), 1 + len_binds(caps, 0), cap_mask(caps, 2, 0), LamJob(lk, ps, body, caps, r)) {
      Numbered(i, em2) -> alloc_closure(cx, env, pend, n_ctors(cx) + i, "@elya$lam." <> int.to_string(i), cap_vals(caps), em2)
    }
  }
}
fn ctor_params(ps: List(Ty), i: Int) -> List(CParam) {
  match ps { Nil -> Nil  Cons(p, rest) -> Cons(CParam("$a" <> int.to_string(i), p), ctor_params(rest, i + 1)) }
}
fn ctor_args(ps: List(Ty), i: Int) -> List(CExpr) {
  match ps { Nil -> Nil  Cons(p, rest) -> Cons(CExpr(0, 0, p, KVar("$a" <> int.to_string(i))), ctor_args(rest, i + 1)) }
}
fn len_binds(bs: List(EBind), n: Int) -> Int { match bs { Nil -> n  Cons(_, rest) -> len_binds(rest, n + 1) } }
// A top-level function as a value: a closure with no captures whose code
// calls it (`anf.rs`'s wrapper), the wrapper written once.
fn fn_value(cx: ECx, env: List(EBind), pend: List(Val), f: String, em: Emit) -> Gotv {
  match em {
    Emit(b, n, l, Mx(cs, js, rws, lk, ws, fr), k) -> {
      let mx = if has(ws, f) { Mx(cs, js, rws, lk, ws, fr) } else { Mx(cs, Cons(WrapJob(f), js), rws, lk, Cons(f, ws), fr) }
      match mx {
        Mx(cs2, js2, rws2, lk2, ws2, fr2) -> alloc_closure(cx, env, pend, n_ctors(cx) + lk2, "@elya$wrap." <> f, Nil, Emit(b, n, l, Mx(cs2, js2, Cons(Row2(1, 0), rws2), lk2 + 1, ws2, fr2), k))
      }
    }
  }
}

// The names a lambda's body reads that it does not bind, in order of
// first reading, each once; its captures are those the scope binds.
fn free_list(xs: List(CExpr), bnd: List(String), acc: List(String)) -> List(String) {
  match xs { Nil -> acc  Cons(x, rest) -> free_list(rest, bnd, free_vars(x, bnd, acc)) }
}
fn free_vars(e: CExpr, bnd: List(String), acc: List(String)) -> List(String) {
  match e {
    CExpr(_, _, _, k) -> match k {
      KVar(n) -> if has(bnd, n) || has(acc, n) { acc } else { Cons(n, acc) }
      KApp(f, args) -> free_list(Cons(f, args), bnd, acc)
      KBuiltin(_, args) -> free_list(args, bnd, acc)
      KCtor(_, args) -> free_list(args, bnd, acc)
      KPrim(_, args) -> free_list(args, bnd, acc)
      KLambda(ps, b) -> free_vars(b, param_names(ps, bnd), acc)
      KLet(n, v, b) -> free_vars(b, Cons(n, bnd), free_vars(v, bnd, acc))
      KIf(c, x, y) -> free_list(Cons(c, Cons(x, Cons(y, Nil))), bnd, acc)
      KMatch(sc, arms) -> free_arms(arms, bnd, free_vars(sc, bnd, acc))
      KPerform(_, _, _, args) -> free_list(args, bnd, acc)
      // A resume reads its clause's continuation.
      KResume(v) -> free_vars(v, bnd, if has(bnd, "$cont") || has(acc, "$cont") { acc } else { Cons("$cont", acc) })
      KHandle(body, _, cs, ret) -> handle_free(body, cs, ret, bnd, acc)
      _ -> acc
    }
  }
}
fn handle_free(body: CExpr, cs: List(CClause), ret: Maybe(CRet), bnd: List(String), acc: List(String)) -> List(String) {
  let a2 = free_clauses(cs, bnd, free_vars(body, bnd, acc))
  match ret { No -> a2  Yes(CRet(n, rb)) -> free_vars(rb, Cons(n, bnd), a2) }
}
fn free_clauses(cs: List(CClause), bnd: List(String), acc: List(String)) -> List(String) {
  match cs { Nil -> acc  Cons(CClause(_, _, ps, b), rest) -> free_clauses(rest, bnd, free_vars(b, Cons("$cont", param_names(ps, bnd)), acc)) }
}
fn free_arms(arms: List(CArm), bnd: List(String), acc: List(String)) -> List(String) {
  match arms { Nil -> acc  Cons(CArm(p, b), rest) -> free_arms(rest, bnd, free_vars(b, pat_names(p, bnd), acc)) }
}
fn captures(env: List(EBind), names: List(String), acc: List(EBind)) -> List(EBind) {
  match names { Nil -> acc  Cons(n, rest) -> captures(env, rest, if bound(env, n) { Cons(EBind(n, lookup(env, n)), acc) } else { acc }) }
}

// ---- Data -------------------------------------------------------------------

fn ty_of(e: CExpr) -> Ty { match e { CExpr(_, _, t, _) -> t } }
fn is_string(e: CExpr) -> Bool { match ty_of(e) { TB(3) -> True  _ -> False } }
fn is_float(e: CExpr) -> Bool { match ty_of(e) { TB(1) -> True  _ -> False } }
// A constructor of a ground type is keyed by its name; one of a parametric
// type's instance by its name and the instance (`Cons` of `List(Int)`).
fn ctor_info(cs: List(CInfo), n: String, key: String) -> CInfo {
  match cs { Nil -> CInfo(n, key, 0, Nil)  Cons(CInfo(m, k, tag, fs), rest) -> if m == n && k == key { CInfo(m, k, tag, fs) } else { ctor_info(rest, n, key) } }
}
fn type_key(t: Ty) -> String {
  match t { TCon(_, Nil) -> ""  _ -> mono.key_of(t) }
}
fn cx_ctor(cx: ECx, n: String, t: Ty) -> CInfo { match cx { ECx(_, cs, _, _) -> ctor_info(cs, n, type_key(t)) } }
fn len_vals(vs: List(Val), n: Int) -> Int { match vs { Nil -> n  Cons(_, rest) -> len_vals(rest, n + 1) } }

// A field's word: an `Int` or `Unit` itself, a `Bool` widened, a pointer as
// its address.
fn to_word(em: Emit, v: Val) -> Gotv {
  match v {
    Val(x, LI1) -> assign(em, "zext i1 " <> x <> " to i64", LI64)
    Val(x, LPtr) -> assign(em, "ptrtoint ptr " <> x <> " to i64", LI64)
    Val(x, t) -> Gotv(Val(x, t), em)
  }
}
fn from_word(em: Emit, w: String, t: LTy) -> Gotv {
  match t {
    LI1 -> assign(em, "trunc i64 " <> w <> " to i1", LI1)
    LPtr -> assign(em, "inttoptr i64 " <> w <> " to ptr", LPtr)
    _ -> Gotv(Val(w, LI64), em)
  }
}
fn store_fields(em: Emit, obj: String, vs: List(Val), i: Int) -> Emit {
  match vs {
    Nil -> em
    Cons(v, rest) -> match to_word(em, v) {
      Gotv(Val(w, _), em2) -> match fresh(em2) {
        Fresh1(fp, em3) -> store_fields(line(line(em3, fp <> " = getelementptr i64, ptr " <> obj <> ", i64 " <> int.to_string(i)), "store i64 " <> w <> ", ptr " <> fp), obj, rest, i + 1)
      }
    }
  }
}
// `[tag][fields...]`, the fields rooted across the allocation.
fn construct(cx: ECx, env: List(EBind), pend: List(Val), n: String, t: Ty, vs: List(Val), em: Emit) -> Gotv {
  match cx_ctor(cx, n, t) {
    CInfo(_, _, tag, _) -> match rooted(em, roots(env, pend, vs), "call ptr @elya_alloc(i64 " <> int.to_string(1 + len_vals(vs, 0)) <> ")", LPtr) {
      Gotv(Val(obj, _), em2) -> Gotv(Val(obj, LPtr), store_fields(line(em2, "store i64 " <> int.to_string(tag) <> ", ptr " <> obj), obj, vs, 1))
    }
  }
}

// One arm's pattern tested against `v` (of type `t`); a failed test goes to
// `fail`, and the binders are bound as the test passes. `keep` is what a
// literal's allocation roots besides `v` and the binders: the scrutinee, the
// objects enclosing `v`, and the pending operands, all read again after it.
linear type Tested { Tested(List(EBind), Emit) }
fn load_field(em: Emit, obj: String, i: Int, t: Ty) -> Gotv {
  match fresh(em) {
    Fresh1(fp, em2) -> match fresh(line(em2, fp <> " = getelementptr i64, ptr " <> obj <> ", i64 " <> int.to_string(i))) {
      Fresh1(w, em3) -> from_word(line(em3, w <> " = load i64, ptr " <> fp), w, lt_of(t))
    }
  }
}
fn branch_on(em: Emit, cond: String, fail: String) -> Emit {
  match new_label(em) { Fresh1(ok, em2) -> start_block(line(em2, "br i1 " <> cond <> ", label %" <> ok <> ", label %" <> fail), ok) }
}
fn test_pat(cx: ECx, v: Val, t: Ty, p: CPat, fail: String, keep: List(String), env: List(EBind), em: Emit) -> Tested {
  match p {
    QWild -> Tested(env, em)
    QVar(n) -> Tested(Cons(EBind(n, v), env), em)
    QLit(LUnit) -> Tested(env, em)
    QLit(LStr(s)) -> match str_lit(cx, em, val_roots(Cons(v, Nil), env_roots(env, keep)), s) {
      Gotv(Val(lit, _), em2) -> match assign(em2, "call i64 @elya_str_eq(ptr " <> vtext(v) <> ", ptr " <> lit <> ")", LI64) {
        Gotv(Val(r, _), em3) -> match assign(em3, "icmp ne i64 " <> r <> ", 0", LI1) { Gotv(Val(c, _), em4) -> Tested(env, branch_on(em4, c, fail)) }
      }
    }
    QLit(l) -> match v {
      Val(x, lt) -> match assign(em, "icmp eq " <> lt_text(lt) <> " " <> x <> ", " <> lit_value(l), LI1) { Gotv(Val(c, _), em2) -> Tested(env, branch_on(em2, c, fail)) }
    }
    QCtor(n, args) -> match cx_ctor(cx, n, t) {
      CInfo(_, _, tag, fts) -> match fresh(em) {
        Fresh1(tg, em2) -> match assign(line(em2, tg <> " = load i64, ptr " <> vtext(v)), "icmp eq i64 " <> tg <> ", " <> int.to_string(tag), LI1) {
          Gotv(Val(c, _), em3) -> test_fields(cx, vtext(v), fts, args, 1, fail, Cons(vtext(v), keep), env, branch_on(em3, c, fail))
        }
      }
    }
  }
}
fn test_fields(cx: ECx, obj: String, fts: List(Ty), ps: List(CPat), i: Int, fail: String, keep: List(String), env: List(EBind), em: Emit) -> Tested {
  match ps {
    Nil -> Tested(env, em)
    Cons(QWild, rest) -> test_fields(cx, obj, tail_tys(fts), rest, i + 1, fail, keep, env, em)
    Cons(p, rest) -> match load_field(em, obj, i, head_ty(fts)) {
      Gotv(fv, em2) -> match test_pat(cx, fv, head_ty(fts), p, fail, keep, env, em2) {
        Tested(env2, em3) -> test_fields(cx, obj, tail_tys(fts), rest, i + 1, fail, keep, env2, em3)
      }
    }
  }
}
fn head_ty(ts: List(Ty)) -> Ty { match ts { Nil -> TB(4)  Cons(t, _) -> t } }
fn tail_tys(ts: List(Ty)) -> List(Ty) { match ts { Nil -> Nil  Cons(_, rest) -> rest } }

// The arms in order, each tested then run; the value of each that runs and
// the block it ends in, for the join's phi (none in tail position, where
// each arm returns). Past the last arm the match fails by name.
type In { In(String, String) }
linear type Arms { Arms(List(In), Emit) }
fn phi_ins(ins: List(In)) -> String {
  match ins { Nil -> ""  Cons(In(v, l), Nil) -> "[ " <> v <> ", %" <> l <> " ]"  Cons(In(v, l), rest) -> "[ " <> v <> ", %" <> l <> " ], " <> phi_ins(rest) }
}
// How an arm ends: joined (`TNo`), or in tail position of a direct function
// (its result type), of a CPS region, or of a handler's clause.
type TMode { TNo, TDir(LTy), TCps, TCl }
fn tail_by(cx: ECx, env: List(EBind), e: CExpr, em: Emit, mode: TMode) -> Emit {
  match mode { TDir(r) -> emit_tail(cx, env, e, em, r)  TCps -> cps_tail(cx, env, e, em)  TCl -> clause_tail(cx, env, e, em)  TNo -> emit_tail(cx, env, e, em, LI64) }
}
fn emit_arms(cx: ECx, env: List(EBind), pend: List(Val), sv: Val, st: Ty, arms: List(CArm), em: Emit, join: String, ins: List(In), tail: TMode) -> Arms {
  match arms {
    Nil -> Arms(rev(ins), line(line(em, "call void @elya_match_fail()"), "unreachable"))
    Cons(CArm(p, body), rest) -> match new_label(em) {
      Fresh1(next, em2) -> match test_pat(cx, sv, st, p, next, val_roots(Cons(sv, Nil), val_roots(pend, Nil)), env, em2) {
        Tested(env2, em3) -> match tail {
          TNo -> match emit(cx, env2, pend, body, em3) {
            Gotv(Val(bv, _), em4) -> match label_of(em4) {
              AtLabel(lb, em5) -> emit_arms(cx, env, pend, sv, st, rest, start_block(line(em5, "br label %" <> join), next), join, Cons(In(bv, lb), ins), tail)
            }
          }
          _ -> emit_arms(cx, env, pend, sv, st, rest, start_block(tail_by(cx, env2, body, em3, tail), next), join, ins, tail)
        }
      }
    }
  }
}

// ---- Functions and the module ----------------------------------------------

fn param_lts(ps: List(CParam)) -> List(LTy) {
  match ps { Nil -> Nil  Cons(CParam(_, t), rest) -> Cons(lt_of(t), param_lts(rest)) }
}
fn sigs_of(fs: List(CFn)) -> List(ESig) {
  match fs { Nil -> Nil  Cons(CFn(n, ps, CExpr(_, _, t, _)), rest) -> Cons(ESig(n, param_lts(ps), lt_of(t)), sigs_of(rest)) }
}
type Hdr { Hdr(String, List(EBind)) }
fn header(ps: List(CParam), i: Int, text: String, env: List(EBind)) -> Hdr {
  match ps {
    Nil -> Hdr(text, env)
    Cons(CParam(n, t), rest) -> {
      let v = "%p" <> int.to_string(i)
      header(rest, i + 1, if i == 0 { lt_text(lt_of(t)) <> " " <> v } else { text <> ", " <> lt_text(lt_of(t)) <> " " <> v }, Cons(EBind(n, Val(v, lt_of(t))), env))
    }
  }
}
fn define(cx: ECx, name: String, text: String, r: LTy, env: List(EBind), body: CExpr, pre: List(String), em: Emit) -> Emit {
  match em {
    Emit(b, k, _, mx, sk) -> {
      let em2 = lines(Emit(buffer.push(b, "define tailcc " <> lt_text(r) <> " @" <> name <> "(" <> text <> ") {\nentry:\n"), k, "entry", mx, sk), pre)
      match emit_tail(cx, env, body, em2, r) {
        Emit(b2, k2, l2, mx2, sk2) -> Emit(buffer.push(b2, "}\n\n"), k2, l2, mx2, sk2)
      }
    }
  }
}
fn define_mode(cx: ECx, name: String, text: String, r: LTy, env: List(EBind), body: CExpr, pre: List(String), em: Emit, mode: TMode) -> Emit {
  match em {
    Emit(b, k, _, mx, sk) -> {
      let em2 = lines(Emit(buffer.push(b, "define tailcc " <> lt_text(r) <> " @" <> name <> "(" <> text <> ") {\nentry:\n"), k, "entry", mx, sk), pre)
      match tail_by(cx, env, body, em2, mode) {
        Emit(b2, k2, l2, mx2, sk2) -> Emit(buffer.push(b2, "}\n\n"), k2, l2, mx2, sk2)
      }
    }
  }
}
fn lines(em: Emit, ls: List(String)) -> Emit { match ls { Nil -> em  Cons(x, rest) -> lines(line(em, x), rest) } }
// A lambda's code: the closure, then its parameters; each capture loaded
// from the closure's words at entry.
linear type Loaded { Loaded(List(String), List(EBind), Emit) }
fn load_caps(caps: List(EBind), i: Int, pre: List(String), env: List(EBind), em: Emit) -> Loaded { load_from(caps, "%clo", i, pre, env, em) }
fn load_from(caps: List(EBind), base: String, i: Int, pre: List(String), env: List(EBind), em: Emit) -> Loaded {
  match caps {
    Nil -> Loaded(rev(pre), env, em)
    Cons(EBind(n, Val(_, t)), rest) -> match fresh(em) {
      Fresh1(fp, em2) -> match fresh(em2) {
        Fresh1(w, em3) -> {
          let ld = Cons(w <> " = load i64, ptr " <> fp, Cons(fp <> " = getelementptr i64, ptr " <> base <> ", i64 " <> int.to_string(i), pre))
          match t {
            LI64 -> load_from(rest, base, i + 1, ld, Cons(EBind(n, Val(w, LI64)), env), em3)
            _ -> match fresh(em3) {
              Fresh1(v, em4) -> load_from(rest, base, i + 1, Cons(v <> (if t == LI1 { " = trunc i64 " <> w <> " to i1" } else { " = inttoptr i64 " <> w <> " to ptr" }), ld), Cons(EBind(n, Val(v, t)), env), em4)
            }
          }
        }
      }
    }
  }
}
fn wrapper_params(ps: List(LTy), i: Int, text: String, args: List(Val)) -> Hdr2 {
  match ps {
    Nil -> Hdr2(text, rev(args))
    Cons(t, rest) -> {
      let v = "%p" <> int.to_string(i)
      wrapper_params(rest, i + 1, text <> ", " <> lt_text(t) <> " " <> v, Cons(Val(v, t), args))
    }
  }
}
type Hdr2 { Hdr2(String, List(Val)) }
fn take_job(em: Emit) -> Job1 {
  match em {
    Emit(b, n, l, Mx(cs, js, rws, lk, ws, fr), k) -> match js {
      Nil -> Job1(No, Emit(b, n, l, Mx(cs, Nil, rws, lk, ws, fr), k))
      Cons(j, rest) -> Job1(Yes(j), Emit(b, n, l, Mx(cs, rest, rws, lk, ws, fr), k))
    }
  }
}
linear type Job1 { Job1(Maybe(LJob), Emit) }
fn drain_jobs(cx: ECx, em: Emit) -> Emit {
  match take_job(em) {
    Job1(No, em2) -> em2
    Job1(Yes(LamJob(i, ps, body, caps, r)), em2) -> match header(ps, 0, "", Nil) {
      Hdr(text, penv) -> match load_caps(caps, 2, Nil, penv, em2) {
        Loaded(pre, env, em3) -> drain_jobs(cx, define(cx, "elya$lam." <> int.to_string(i), if text == "" { "ptr %clo" } else { "ptr %clo, " <> text }, r, env, body, pre, em3))
      }
    }
    // A site's resumption: the hole's value and the frame; the frame's next
    // is the region's continuation, its saved values the rest's scope.
    Job1(Yes(SiteJob(i, x, xt, saved, rest)), em2) -> match load_from(saved, "%f", 3, Nil, Nil, em2) {
      Loaded(pre, env, em3) -> match bind_word(x, xt, "%v") {
        Bound(bl, xb) -> drain_jobs(cx, define_mode(cx, "elya$k." <> int.to_string(i), "i64 %v, ptr %f", LI64, Cons(xb, Cons(EBind("$k", Val("%next", LPtr)), env)), rest,
          rev_onto(rev(Cons("%next.p = getelementptr i64, ptr %f, i64 2", Cons("%next.w = load i64, ptr %next.p", Cons("%next = inttoptr i64 %next.w to ptr", Nil)))), rev_onto(rev(pre), bl)), em3, TCps))
      }
    }
    Job1(Yes(HandJob(i, body, cs, ret, saved, bt)), em2) -> drain_jobs(cx, handler_fns(cx, i, body, cs, ret, saved, bt, em2))
    Job1(Yes(WrapJob(f)), em2) -> match sig_of(cx_sigs(cx), f) {
      ESig(_, ps, r) -> match wrapper_params(ps, 0, "ptr %clo", Nil) {
        Hdr2(text, args) -> match em2 {
          Emit(b, k, l, mx, sk) -> drain_jobs(cx, Emit(buffer.push(b, "define tailcc " <> lt_text(r) <> " @elya$wrap." <> f <> "(" <> text <> ") {\nentry:\n  %r = musttail call tailcc " <> lt_text(r) <> " @elya." <> f <> "(" <> arg_list(args) <> ")\n  ret " <> lt_text(r) <> " %r\n}\n\n"), k, l, mx, sk))
        }
      }
    }
  }
}
fn emit_fns(cx: ECx, fs: List(CFn), em: Emit) -> Emit {
  match fs {
    Nil -> em
    Cons(CFn(n, ps, body), rest) -> match header(ps, 0, "", Nil) {
      Hdr(text, env) -> emit_fns(cx, rest, drain_jobs(cx, if is_cps(cx, n) {
        // A CPS function: its continuation one more parameter (D14).
        define_mode(cx, "elya." <> n, if text == "" { "ptr %k" } else { text <> ", ptr %k" }, LI64, Cons(EBind("$k", Val("%k", LPtr)), env), body, Nil, em, TCps)
      } else { define(cx, "elya." <> n, text, ty_lt(body), env, body, Nil, em) }))
    }
  }
}
fn emit_strs(ss: List(SConst), b: Buffer) -> Buffer {
  match ss {
    Nil -> b
    Cons(SConst(name, v), rest) -> emit_strs(rest, buffer.push(ir_bytes(v, 0, 0, buffer.push(b, name <> " = private unnamed_addr constant [" <> int.to_string(string.length(v)) <> " x i8] c\"")), "\"\n"))
  }
}
fn prelude() -> String {
  "; The back end in Elya, stage B6.\n" <>
  "declare ptr @elya_alloc(i64)\n" <>
  "declare i64 @elya_eq(ptr, ptr, i64, i64)\n" <>
  "declare void @elya_match_fail()\n" <>
  "declare ptr @elya_array_new(i64)\n" <>
  "declare ptr @elya_array_push(ptr, i64)\n" <>
  "declare ptr @elya_array_set(ptr, i64, i64)\n" <>
  "declare i64 @elya_array_get(ptr, i64)\n" <>
  "declare i64 @elya_array_length(ptr)\n" <>
  "declare ptr @elya_buffer_new(i64)\n" <>
  "declare ptr @elya_buffer_push(i64, ptr, ptr)\n" <>
  "declare ptr @elya_buffer_finish(i64, ptr)\n" <>
  "declare ptr @elya_io_read_file(i64, ptr)\n" <>
  "declare i64 @elya_io_file_exists(ptr)\n" <>
  "declare void @elya_io_write_file(ptr, ptr)\n" <>
  "declare ptr @elya_io_read_stdin(i64)\n" <>
  "declare i64 @elya_io_arg_count()\n" <>
  "declare ptr @elya_io_arg(i64, i64)\n" <>
  "declare i64 @elya_io_run(ptr)\n" <>
  "declare void @elya_io_exit(i64)\n" <>
  "declare ptr @elya_io_os(i64)\n" <>
  "declare ptr @elya_str_lit(i64, ptr, i64)\n" <>
  "declare ptr @elya_int_to_string(i64, i64)\n" <>
  "declare ptr @elya_str_concat(i64, ptr, ptr)\n" <>
  "declare i64 @elya_str_eq(ptr, ptr)\n" <>
  "declare i64 @elya_str_length(ptr)\n" <>
  "declare i64 @elya_str_byte_at(ptr, i64)\n" <>
  "declare ptr @elya_str_slice(i64, ptr, i64, i64)\n" <>
  "declare void @elya_shift_range(ptr, i64)\n" <>
  "declare void @elya_gc_push(ptr)\n" <>
  "@elya_current_handler = external global ptr\n" <>
  "@elya_handle_end = external global ptr\n" <>
  "declare void @elya_resume_twice()\n" <>
  "declare void @elya_unhandled_effect()\n" <>
  "declare void @elya_handle_end_init(ptr)\n" <>
  // The end frame's code: the current handler's (spec
  // 2026-10-22-elya-multi-shot-sharing D1); C cannot `musttail` a `tailcc`.
  "define internal tailcc i64 @elya_rt_handle_end(i64 %v, ptr %f) {\nentry:\n  %h = load ptr, ptr @elya_current_handler\n  %cw = getelementptr i64, ptr %h, i64 1\n  %c = load i64, ptr %cw\n  %code = inttoptr i64 %c to ptr\n  %r = musttail call tailcc i64 %code(i64 %v, ptr %h)\n  ret i64 %r\n}\n" <>
  "declare void @elya_gc_pop()\n" <>
  "@.name.shl = private unnamed_addr constant [4 x i8] c\"shl\\00\"\n" <>
  "@.name.shr = private unnamed_addr constant [4 x i8] c\"shr\\00\"\n" <>
  "@.name.ushr = private unnamed_addr constant [5 x i8] c\"ushr\\00\"\n" <>
  "@.name.truncate = private unnamed_addr constant [9 x i8] c\"truncate\\00\"\n" <>
  "@.name.round = private unnamed_addr constant [6 x i8] c\"round\\00\"\n" <>
  "declare ptr @elya_float_to_string(i64, i64)\n" <>
  "declare i64 @elya_float_to_int(ptr, i64, i64)\n" <>
  "declare i64 @elya_float_parse(ptr)\n" <>
  "declare void @elya_println(ptr)\n" <>
  "declare void @elya_int_overflow()\n" <>
  "declare void @elya_div_zero()\n" <>
  "declare void @elya_rem_zero()\n" <>
  "declare void @elya_gc_init(ptr, i64)\n" <>
  "declare void @elya_eq_init(ptr, i64)\n" <>
  "declare void @elya_args_init(i32, ptr)\n" <>
  "declare i64 @elya_start(ptr)\n" <>
  "declare void @elya_main_int(i64)\n" <>
  "declare void @elya_gc_report()\n" <>
  "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\n" <>
  "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\n" <>
  "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n\n"
}
// The entry: `main`'s value printed as the Rust back end prints it, an
// `Int` (or `Unit`, 0) by `elya_main_int` after the program, a `Bool` by
// name.
// Whether `main` answers a `Float`: printed by its text, as the Rust back
// end prints it (spec 2026-11-28-elya-float-in-elya D4).
fn main_float(fs: List(CFn)) -> Bool {
  match fs { Nil -> False  Cons(CFn(n, _, b), rest) -> if n == "main" { match ty_of(b) { TB(1) -> True  _ -> False } } else { main_float(rest) } }
}
fn entry(cx: ECx, main_lt: LTy, fl: Bool) -> String {
  "@.true = private unnamed_addr constant [4 x i8] c\"True\"\n@.false = private unnamed_addr constant [5 x i8] c\"False\"\n\n" <>
  "define i64 @elya_entry() {\nentry:\n  %v = call tailcc " <> lt_text(main_lt) <> " @elya.main()\n" <>
  (if main_lt == LI1 {
    "  %t = call ptr @elya_str_lit(i64 " <> stag(cx) <> ", ptr @.true, i64 4)\n  call void @elya_gc_push(ptr %t)\n  %f = call ptr @elya_str_lit(i64 " <> stag(cx) <> ", ptr @.false, i64 5)\n  call void @elya_gc_pop()\n  %s = select i1 %v, ptr %t, ptr %f\n  call void @elya_println(ptr %s)\n  ret i64 0\n}\n\n"
  } else { if fl {
    "  %s = call ptr @elya_float_to_string(i64 " <> stag(cx) <> ", i64 %v)\n  call void @elya_println(ptr %s)\n  ret i64 0\n}\n\n"
  } else { "  ret i64 %v\n}\n\n" } }) <>
  "define i32 @main(i32 %0, ptr %1) {\nentry:\n  call void @elya_gc_init(ptr @.gc_desc, i64 " <> int.to_string(rows(cx)) <> ")\n  call void @elya_eq_init(ptr @.eq_float, i64 " <> int.to_string(n_ctors(cx)) <> ")\n  call void @elya_handle_end_init(ptr @elya_rt_handle_end)\n" <>
  "  call void @elya_args_init(i32 %0, ptr %1)\n  %v = call i64 @elya_start(ptr @elya_entry)\n" <>
  (if main_lt == LI1 || fl { "" } else { "  call void @elya_main_int(i64 %v)\n" }) <>
  "  call void @elya_gc_report()\n  ret i32 0\n}\n"
}

// The constructors in declaration order: the index is the tag.
fn infos(ts: List(CType), tag: Int, acc: List(CInfo)) -> List(CInfo) {
  match ts {
    Nil -> rev(acc)
    Cons(CType(_, Nil), rest) -> infos(rest, tag, acc)
    Cons(CType(n, Cons(CCtor(c, fs), more)), rest) -> infos(Cons(CType(n, more), rest), tag + 1, Cons(CInfo(c, "", tag, fs), acc))
  }
}
// The instances of the parametric types the ground module uses, each
// constructor a tag of its own after the ground types' (`instantiate_types`):
// found from every type the functions mention, and the fields of each
// instance found, until none is new.
fn generic_of(gs: List(CGeneric), n: String) -> Maybe(CGeneric) {
  match gs { Nil -> No  Cons(CGeneric(m, k, cs), rest) -> if m == n { Yes(CGeneric(m, k, cs)) } else { generic_of(rest, n) } }
}
fn nth_ty(ts: List(Ty), i: Int) -> Ty { match ts { Nil -> TB(4)  Cons(t, rest) -> if i == 0 { t } else { nth_ty(rest, i - 1) } } }
fn inst_ty(args: List(Ty), t: Ty) -> Ty {
  match t {
    TVar(i) -> nth_ty(args, i)
    TFn(ps, rw, r) -> TFn(inst_tys(args, ps), rw, inst_ty(args, r))
    TCon(n, xs) -> TCon(n, inst_tys(args, xs))
    _ -> t
  }
}
fn inst_tys(args: List(Ty), ts: List(Ty)) -> List(Ty) { match ts { Nil -> Nil  Cons(t, rest) -> Cons(inst_ty(args, t), inst_tys(args, rest)) } }
fn has_key(cs: List(CInfo), key: String) -> Bool { match cs { Nil -> False  Cons(CInfo(_, k, _, _), rest) -> k == key || has_key(rest, key) } }
type Insts { Insts(List(CInfo), Int) }
fn add_ctors(cs: List(CCtor), args: List(Ty), key: String, ins: Insts) -> Insts {
  match cs {
    Nil -> ins
    Cons(CCtor(c, fs), rest) -> match ins { Insts(acc, tag) -> add_ctors(rest, args, key, Insts(Cons(CInfo(c, key, tag, inst_tys(args, fs)), acc), tag + 1)) }
  }
}
fn ctor_fields(cs: List(CCtor), args: List(Ty)) -> List(Ty) {
  match cs { Nil -> Nil  Cons(CCtor(_, fs), rest) -> rev_onto(inst_tys(args, fs), ctor_fields(rest, args)) }
}
fn use_ty(gs: List(CGeneric), t: Ty, ins: Insts) -> Insts {
  match t {
    TFn(ps, _, r) -> use_ty(gs, r, use_tys(gs, ps, ins))
    TCon(n, args) -> {
      let ins2 = use_tys(gs, args, ins)
      match args {
        Nil -> ins2
        _ -> match generic_of(gs, n) {
          No -> ins2
          Yes(CGeneric(_, _, cs)) -> {
            let key = type_key(t)
            match ins2 { Insts(acc, tag) -> if has_key(acc, key) { Insts(acc, tag) } else { use_tys(gs, ctor_fields(cs, args), add_ctors(cs, args, key, Insts(acc, tag))) } }
          }
        }
      }
    }
    _ -> ins
  }
}
fn use_tys(gs: List(CGeneric), ts: List(Ty), ins: Insts) -> Insts { match ts { Nil -> ins  Cons(t, rest) -> use_tys(gs, rest, use_ty(gs, t, ins)) } }
fn use_exprs(gs: List(CGeneric), xs: List(CExpr), ins: Insts) -> Insts { match xs { Nil -> ins  Cons(x, rest) -> use_exprs(gs, rest, use_expr(gs, x, ins)) } }
fn use_expr(gs: List(CGeneric), e: CExpr, ins: Insts) -> Insts {
  match e {
    CExpr(_, _, t, k) -> {
      let ins2 = use_ty(gs, t, ins)
      match k {
        KApp(f, args) -> use_exprs(gs, Cons(f, args), ins2)
        KBuiltin(_, args) -> use_exprs(gs, args, ins2)
        KCtor(_, args) -> use_exprs(gs, args, ins2)
        KPrim(_, args) -> use_exprs(gs, args, ins2)
        KLambda(ps, b) -> use_expr(gs, b, use_tys(gs, param_tys(ps), ins2))
        KLet(_, v, b) -> use_expr(gs, b, use_expr(gs, v, ins2))
        KIf(c, x, y) -> use_exprs(gs, Cons(c, Cons(x, Cons(y, Nil))), ins2)
        KMatch(s, arms) -> use_arms(gs, arms, use_expr(gs, s, ins2))
        KPerform(_, _, ot, args) -> use_exprs(gs, args, use_ty(gs, ot, ins2))
        KResume(v) -> use_expr(gs, v, ins2)
        KHandle(body, _, cs, ret) -> use_clauses(gs, cs, match ret { No -> use_expr(gs, body, ins2)  Yes(CRet(_, rb)) -> use_expr(gs, rb, use_expr(gs, body, ins2)) })
        _ -> ins2
      }
    }
  }
}
fn use_clauses(gs: List(CGeneric), cs: List(CClause), ins: Insts) -> Insts {
  match cs { Nil -> ins  Cons(CClause(_, _, ps, b), rest) -> use_clauses(gs, rest, use_expr(gs, b, use_tys(gs, param_tys(ps), ins))) }
}
fn use_arms(gs: List(CGeneric), arms: List(CArm), ins: Insts) -> Insts {
  match arms { Nil -> ins  Cons(CArm(_, b), rest) -> use_arms(gs, rest, use_expr(gs, b, ins)) }
}
fn param_tys(ps: List(CParam)) -> List(Ty) { match ps { Nil -> Nil  Cons(CParam(_, t), rest) -> Cons(t, param_tys(rest)) } }
fn use_fns(gs: List(CGeneric), fs: List(CFn), ins: Insts) -> Insts {
  match fs { Nil -> ins  Cons(CFn(_, ps, b), rest) -> use_fns(gs, rest, use_expr(gs, b, use_tys(gs, param_tys(ps), ins))) }
}
fn ground_fields(cs: List(CInfo), acc: List(Ty)) -> List(Ty) {
  match cs { Nil -> acc  Cons(CInfo(_, _, _, fs), rest) -> ground_fields(rest, rev_onto(fs, acc)) }
}

fn n_ctors(cx: ECx) -> Int { match cx { ECx(_, cs, _, _) -> len_infos(cs, 0) } }
fn len_infos(cs: List(CInfo), n: Int) -> Int { match cs { Nil -> n  Cons(_, rest) -> len_infos(rest, n + 1) } }
// The rows: each constructor's, then the string's, then the traced array's.
// The rows: each constructor's and closure's, the string's, the traced
// array's, then the effects' (spec 2026-11-28-elya-backend-effects): the
// empty frame's, the site frames', the handler frames', the continuation's.
fn frame_tag(cx: ECx) -> Int { match cx { ECx(_, _, t, _) -> t + 2 } }
fn site_base(cx: ECx) -> Int { frame_tag(cx) + 1 }
fn handler_base(cx: ECx) -> Int { match cx { ECx(_, _, _, EffCx(_, _, ns, _)) -> site_base(cx) + ns } }
fn cont_tag(cx: ECx) -> Int { match cx { ECx(_, _, _, EffCx(_, _, _, nh)) -> handler_base(cx) + nh } }
fn rows(cx: ECx) -> Int { cont_tag(cx) + 1 }
fn is_heap(t: Ty) -> Bool { lt_of(t) == LPtr }
fn mask(fs: List(Ty), bit: Int, acc: Int) -> Int {
  match fs { Nil -> acc  Cons(f, rest) -> mask(rest, bit * 2, if is_heap(f) { acc + bit } else { acc }) }
}
// A constructor's float mask for `elya_eq`: bit i set iff field i is a
// `Float`, compared as a float (spec 2026-10-23-elya-float-natively D2).
fn fmask(fs: List(Ty), bit: Int, acc: Int) -> Int {
  match fs { Nil -> acc  Cons(f, rest) -> fmask(rest, bit * 2, match f { TB(1) -> acc + bit  _ -> acc }) }
}
fn float_rows(cs: List(CInfo), b: String) -> String {
  match cs { Nil -> b  Cons(CInfo(_, _, _, fs), rest) -> float_rows(rest, b <> "i64 " <> int.to_string(fmask(fs, 1, 0)) <> ", ") }
}
fn len_tys(ts: List(Ty), n: Int) -> Int { match ts { Nil -> n  Cons(_, rest) -> len_tys(rest, n + 1) } }
fn desc_rows(cs: List(CInfo), b: String) -> String {
  match cs { Nil -> b  Cons(CInfo(_, _, _, fs), rest) -> desc_rows(rest, b <> "i64 " <> int.to_string(len_tys(fs, 0)) <> ", i64 " <> int.to_string(mask(fs, 1, 0)) <> ", ") }
}
// The closures' rows in tag order, then a row for each tag numbered but
// not used (the count is a bound, D4's tags contiguous).
fn closure_rows(rws: List(Row2), b: String) -> String {
  match rws { Nil -> b  Cons(Row2(a, m), rest) -> closure_rows(rest, b <> "i64 " <> int.to_string(a) <> ", i64 " <> int.to_string(m) <> ", ") }
}
fn spare_rows(n: Int, b: String) -> String { if n <= 0 { b } else { spare_rows(n - 1, b <> "i64 0, i64 0, ") } }
fn len_rows(rws: List(Row2), n: Int) -> Int { match rws { Nil -> n  Cons(_, rest) -> len_rows(rest, n + 1) } }
fn tables(cx: ECx, rws: List(Row2), fr: FRows) -> String {
  match cx {
    ECx(_, cs, t, EffCx(_, _, ns, nh)) -> "@.gc_desc = private unnamed_addr constant [" <> int.to_string(2 * rows(cx)) <> " x i64] [" <> desc_rows(cs, "") <> closure_rows(rws, "") <> spare_rows(t - n_ctors(cx) - len_rows(rws, 0), "") <> "i64 0, i64 0, i64 -1, i64 0, " <> effect_rows(fr, ns, nh) <> "]\n" <>
      "@.eq_float = private unnamed_addr constant [" <> int.to_string(n_ctors(cx) + 1) <> " x i64] [" <> float_rows(cs, "") <> "i64 0]\n"
  }
}

// A bound on the closures the module makes: a lambda each, and each
// mention of a function's name (a value, or a call).
fn sites_list(xs: List(CExpr), n: Int) -> Int { match xs { Nil -> n  Cons(x, rest) -> sites_list(rest, sites(x, n)) } }
fn sites(e: CExpr, n: Int) -> Int {
  match e {
    CExpr(_, _, _, k) -> match k {
      KVar(_) -> n + 1
      KApp(f, args) -> sites_list(Cons(f, args), n)
      KBuiltin(_, args) -> sites_list(args, n)
      KCtor(_, args) -> sites_list(args, n + 1)
      KPrim(_, args) -> sites_list(args, n)
      KLambda(_, b) -> sites(b, n + 1)
      KLet(_, v, b) -> sites(b, sites(v, n))
      KIf(c, x, y) -> sites_list(Cons(c, Cons(x, Cons(y, Nil))), n)
      KMatch(sc, arms) -> sites_arms(arms, sites(sc, n))
      KPerform(_, _, _, args) -> sites_list(args, n)
      KResume(v) -> sites(v, n)
      KHandle(body, _, cs, ret) -> sites_clauses(cs, match ret { No -> sites(body, n)  Yes(CRet(_, rb)) -> sites(rb, sites(body, n)) })
      _ -> n
    }
  }
}
fn sites_clauses(cs: List(CClause), n: Int) -> Int { match cs { Nil -> n  Cons(CClause(_, _, _, b), rest) -> sites_clauses(rest, sites(b, n)) } }
fn sites_arms(arms: List(CArm), n: Int) -> Int { match arms { Nil -> n  Cons(CArm(_, b), rest) -> sites_arms(rest, sites(b, n)) } }
fn sites_fns(fs: List(CFn), n: Int) -> Int { match fs { Nil -> n  Cons(CFn(_, _, b), rest) -> sites_fns(rest, sites(b, n)) } }

// ---- Effects (spec 2026-11-28-elya-backend-effects E1, E2) -----------------
// The Rust back end's selective CPS, its runtime protocol word for word
// (crates/codegen/src/cps.rs, cps_emit.rs): a function whose region performs
// or makes an effectful call takes its continuation as one more parameter and
// answers an `i64` word through it; a non-tail site saves the rest of its
// region in a frame `[tag][code][next][saved..]`; a `handle` is a handler
// frame `[tag][ret][next][table][parent][saved..]` made current around its
// body; a perform walks the handlers from `elya_current_handler` to the first
// whose clause table has the operation and jumps to the clause with a
// continuation object `[tag][k][handler][innermost]`; `resume` runs it once.

fn eff_of(cx: ECx) -> EffCx { match cx { ECx(_, _, _, e) -> e } }
fn is_cps(cx: ECx, n: String) -> Bool { match eff_of(cx) { EffCx(ns, _, _, _) -> has(ns, n) } }

// D16: a row with a label but `IO`, or the poisoned tail, needs the
// continuation; an open tail alone does not.
fn labs_cps(ls: List(Lab)) -> Bool { match ls { Nil -> False  Cons(Lab(n, _, _, _), rest) -> n != "IO" || labs_cps(rest) } }
fn tail_err(t: Tail) -> Bool { match t { RError -> True  _ -> False } }
fn needs_cps(t: Ty) -> Bool { match t { TFn(_, Row(ls, tl), _) -> labs_cps(ls) || tail_err(tl)  _ -> False } }
fn is_site(e: CExpr) -> Bool {
  match e { CExpr(_, _, _, k) -> match k { KPerform(_, _, _, _) -> True  KApp(f, _) -> needs_cps(ty_of(f))  _ -> False } }
}
// Every child expression, a lambda's body and a handle's parts included.
// Monomorphic, not `rev`: each instance of a generic function is a clone the
// Rust back end counts (mono.rs's MAX_TYPE_CLONES), and the driver is near it.
fn rev_es(xs: List(CExpr), acc: List(CExpr)) -> List(CExpr) { match xs { Nil -> acc  Cons(x, rest) -> rev_es(rest, Cons(x, acc)) } }
fn rev_hbs(xs: List(HB), acc: List(HB)) -> List(HB) { match xs { Nil -> acc  Cons(x, rest) -> rev_hbs(rest, Cons(x, acc)) } }
fn rev_ops(xs: List(EffOp), acc: List(EffOp)) -> List(EffOp) { match xs { Nil -> acc  Cons(x, rest) -> rev_ops(rest, Cons(x, acc)) } }
fn rev_binds(xs: List(EBind), acc: List(EBind)) -> List(EBind) { match xs { Nil -> acc  Cons(x, rest) -> rev_binds(rest, Cons(x, acc)) } }
fn arm_bodies(arms: List(CArm), acc: List(CExpr)) -> List(CExpr) { match arms { Nil -> rev_es(acc, Nil)  Cons(CArm(_, b), rest) -> arm_bodies(rest, Cons(b, acc)) } }
fn clause_bodies(cs: List(CClause), acc: List(CExpr)) -> List(CExpr) { match cs { Nil -> rev_es(acc, Nil)  Cons(CClause(_, _, _, b), rest) -> clause_bodies(rest, Cons(b, acc)) } }
fn children(e: CExpr) -> List(CExpr) {
  match e {
    CExpr(_, _, _, k) -> match k {
      KApp(f, xs) -> Cons(f, xs)
      KBuiltin(_, xs) -> xs
      KCtor(_, xs) -> xs
      KPrim(_, xs) -> xs
      KPerform(_, _, _, xs) -> xs
      KLambda(_, b) -> Cons(b, Nil)
      KLet(_, v, b) -> Cons(v, Cons(b, Nil))
      KIf(c, x, y) -> Cons(c, Cons(x, Cons(y, Nil)))
      KMatch(sc, arms) -> Cons(sc, arm_bodies(arms, Nil))
      KResume(v) -> Cons(v, Nil)
      KHandle(b, _, cs, ret) -> Cons(b, rev_es(rev_es(clause_bodies(cs, Nil), Nil), match ret { No -> Nil  Yes(CRet(_, rb)) -> Cons(rb, Nil) }))
      _ -> Nil
    }
  }
}
// `contains_effect`: a site anywhere in the region, which a lambda's body
// and a (direct) handle's parts are not.
fn has_site(e: CExpr) -> Bool {
  if is_site(e) { True } else {
    match e { CExpr(_, _, _, k) -> match k { KLambda(_, _) -> False  KHandle(_, _, _, _) -> False  _ -> any_site(children(e)) } }
  }
}
fn any_site(xs: List(CExpr)) -> Bool { match xs { Nil -> False  Cons(x, rest) -> has_site(x) || any_site(rest) } }
fn has_handle(e: CExpr) -> Bool { match e { CExpr(_, _, _, KHandle(_, _, _, _)) -> True  _ -> any_handle(children(e)) } }
fn any_handle(xs: List(CExpr)) -> Bool { match xs { Nil -> False  Cons(x, rest) -> has_handle(x) || any_handle(rest) } }
fn has_resume(e: CExpr) -> Bool {
  match e {
    CExpr(_, _, _, KResume(_)) -> True
    // An inner handle's clauses resume their own continuations.
    CExpr(_, _, _, KHandle(b, _, _, ret)) -> has_resume(b) || match ret { No -> False  Yes(CRet(_, rb)) -> has_resume(rb) }
    _ -> any_resume(children(e))
  }
}
fn any_resume(xs: List(CExpr)) -> Bool { match xs { Nil -> False  Cons(x, rest) -> has_resume(x) || any_resume(rest) } }
fn cps_names(fs: List(CFn), acc: List(String)) -> List(String) {
  match fs { Nil -> acc  Cons(CFn(n, _, b), rest) -> cps_names(rest, if has_site(b) { Cons(n, acc) } else { acc }) }
}

// Every (effect, operation) the module performs, and those it handles too:
// the index into every handle's clause table.
fn has_op(xs: List(EffOp), eff: String, op: String) -> Bool { match xs { Nil -> False  Cons(EffOp(e, o), rest) -> e == eff && o == op || has_op(rest, eff, op) } }
fn add_op(acc: List(EffOp), eff: String, op: String) -> List(EffOp) { if has_op(acc, eff, op) { acc } else { Cons(EffOp(eff, op), acc) } }
fn clause_ops(cs: List(CClause), acc: List(EffOp)) -> List(EffOp) { match cs { Nil -> acc  Cons(CClause(e, o, _, _), rest) -> clause_ops(rest, add_op(acc, e, o)) } }
fn ops_expr(e: CExpr, clauses: Bool, acc: List(EffOp)) -> List(EffOp) {
  let acc2 = match e {
    CExpr(_, _, _, KPerform(eff, op, _, _)) -> add_op(acc, eff, op)
    CExpr(_, _, _, KHandle(_, _, cs, _)) -> if clauses { clause_ops(cs, acc) } else { acc }
    _ -> acc
  }
  ops_list(children(e), clauses, acc2)
}
fn ops_list(xs: List(CExpr), clauses: Bool, acc: List(EffOp)) -> List(EffOp) { match xs { Nil -> acc  Cons(x, rest) -> ops_list(rest, clauses, ops_expr(x, clauses, acc)) } }
fn ops_fns(fs: List(CFn), clauses: Bool, acc: List(EffOp)) -> List(EffOp) { match fs { Nil -> acc  Cons(CFn(_, _, b), rest) -> ops_fns(rest, clauses, ops_expr(b, clauses, acc)) } }
fn op_index(xs: List(EffOp), eff: String, op: String, i: Int) -> Int { match xs { Nil -> 0 - 1  Cons(EffOp(e, o), rest) -> if e == eff && o == op { i } else { op_index(rest, eff, op, i + 1) } } }
fn op_id(cx: ECx, eff: String, op: String) -> Int { match eff_of(cx) { EffCx(_, ops, _, _) -> op_index(ops, eff, op, 0) } }
fn len_ops(xs: List(EffOp), n: Int) -> Int { match xs { Nil -> n  Cons(_, rest) -> len_ops(rest, n + 1) } }
// Bounds on the frames' and handler frames' tags: a `let` each (only one
// whose value holds a site makes a frame), a handle each.
fn count_lets(e: CExpr, n: Int) -> Int { count_list(children(e), match e { CExpr(_, _, _, KLet(_, _, _)) -> n + 1  _ -> n }, False) }
fn count_handles(e: CExpr, n: Int) -> Int { count_list(children(e), match e { CExpr(_, _, _, KHandle(_, _, _, _)) -> n + 1  _ -> n }, True) }
fn count_list(xs: List(CExpr), n: Int, hs: Bool) -> Int { match xs { Nil -> n  Cons(x, rest) -> count_list(rest, if hs { count_handles(x, n) } else { count_lets(x, n) }, hs) } }
fn count_fns(fs: List(CFn), n: Int, hs: Bool) -> Int { match fs { Nil -> n  Cons(CFn(_, _, b), rest) -> count_fns(rest, if hs { count_handles(b, n) } else { count_lets(b, n) }, hs) } }
fn eff_cx(fs: List(CFn)) -> EffCx {
  let cps = cps_names(fs, Nil)
  let nh = count_fns(fs, 0, True)
  EffCx(cps, rev_ops(ops_fns(fs, True, Nil), Nil), match cps { Nil -> if nh == 0 { 0 } else { count_fns(fs, 0, False) }  _ -> count_fns(fs, 0, False) }, nh)
}
fn effect_rows(fr: FRows, ns: Int, nh: Int) -> String {
  match fr { FRows(sr, hr, _) -> "i64 2, i64 2, " <> closure_rows(rev(sr), "") <> spare_rows(ns - len_rows(sr, 0), "") <> closure_rows(rev(hr), "") <> spare_rows(nh - len_rows(hr, 0), "") <> "i64 3, i64 5" }
}

// ---- The stage's effects (E2): one-shot, direct handles ------------------------

fn add_eff(acc: List(String), eff: String) -> List(String) { if eff == "IO" || has(acc, eff) { acc } else { Cons(eff, acc) } }
fn labs_effs(ls: List(Lab), acc: List(String)) -> List(String) { match ls { Nil -> acc  Cons(Lab(n, _, _, _), rest) -> labs_effs(rest, add_eff(acc, n)) } }
fn row_effs(t: Ty, acc: List(String)) -> List(String) { match t { TFn(_, Row(ls, _), _) -> labs_effs(ls, acc)  _ -> acc } }
// `region_effects`: what a region performs that nothing in it handles.
fn reff(perf: List(EffOp), e: CExpr, acc: List(String)) -> List(String) {
  match e {
    CExpr(_, _, _, k) -> match k {
      KPerform(eff, _, _, xs) -> reffs(perf, xs, add_eff(acc, eff))
      KApp(f, xs) -> reffs(perf, Cons(f, xs), row_effs(ty_of(f), acc))
      KLambda(_, _) -> acc
      KHandle(b, _, cs, ret) -> union(handle_effs(perf, b, cs, ret), acc)
      _ -> reffs(perf, children(e), acc)
    }
  }
}
fn reffs(perf: List(EffOp), xs: List(CExpr), acc: List(String)) -> List(String) { match xs { Nil -> acc  Cons(x, rest) -> reffs(perf, rest, reff(perf, x, acc)) } }
fn union(xs: List(String), acc: List(String)) -> List(String) { match xs { Nil -> acc  Cons(x, rest) -> union(rest, add_eff(acc, x)) } }
fn remove(xs: List(String), x: String) -> List(String) { match xs { Nil -> Nil  Cons(y, rest) -> if y == x { remove(rest, x) } else { Cons(y, remove(rest, x)) } } }
fn clause_eff(cs: List(CClause)) -> String { match cs { Nil -> ""  Cons(CClause(e, _, _, _), _) -> e } }
fn has_clause(cs: List(CClause), eff: String, op: String) -> Bool { match cs { Nil -> False  Cons(CClause(e, o, _, _), rest) -> e == eff && o == op || has_clause(rest, eff, op) } }
// A handle handles its effect only with a clause for every operation of it
// the module performs.
fn covers(perf: List(EffOp), eff: String, cs: List(CClause)) -> Bool {
  match perf { Nil -> True  Cons(EffOp(e, o), rest) -> (e != eff || has_clause(cs, e, o)) && covers(rest, eff, cs) }
}
fn handle_effs(perf: List(EffOp), b: CExpr, cs: List(CClause), ret: Maybe(CRet)) -> List(String) {
  let he = clause_eff(cs)
  let body = reff(perf, b, Nil)
  let inner = if he != "" && covers(perf, he, cs) { remove(body, he) } else { body }
  let c2 = reffs(perf, clause_bodies(cs, Nil), inner)
  match ret { No -> c2  Yes(CRet(_, rb)) -> reff(perf, rb, c2) }
}
fn len_exprs(xs: List(CExpr), n: Int) -> Int { match xs { Nil -> n  Cons(_, rest) -> len_exprs(rest, n + 1) } }
fn len_params(ps: List(CParam), n: Int) -> Int { match ps { Nil -> n  Cons(_, rest) -> len_params(rest, n + 1) } }
fn any_op_clause(cs: List(CClause)) -> Bool { match cs { Nil -> False  Cons(CClause(_, o, _, _), rest) -> o == "" || any_op_clause(rest) } }
fn wide_clause(cs: List(CClause)) -> Bool { match cs { Nil -> False  Cons(CClause(_, _, ps, _), rest) -> len_params(ps, 0) > 2 || wide_clause(rest) } }
fn convention(cps: List(String), n: String, t: Ty) -> Stage {
  if needs_cps(t) == has(cps, n) { InStage } else { Outside("a calling convention that disagrees with the callee") }
}
type EffEnv { EffEnv(List(CFn), List(String), List(EffOp)) }
fn check_effects(fs: List(CFn)) -> Stage {
  let cps = cps_names(fs, Nil)
  first(if has(cps, "main") { Outside("`main` performing an effect") } else { InStage }, first(eff_fns(EffEnv(fs, cps, ops_fns(fs, False, Nil)), fs), wide_fns_frames(anf_fns(fs))))
}
// A frame's pointer mask is one word: a site frame saves 60 values at most
// (bits 2 to 61), a handler frame 58 (bits 4 to 61), counted after the
// pre-pass names its operands.
fn wide_fns_frames(fs: List(CFn)) -> Stage {
  match fs { Nil -> InStage  Cons(CFn(_, ps, b), rest) -> first(wide_frames(param_names(ps, Nil), b), wide_fns_frames(rest)) }
}
fn wide_all(locals: List(String), xs: List(CExpr)) -> Stage { match xs { Nil -> InStage  Cons(x, rest) -> first(wide_frames(locals, x), wide_all(locals, rest)) } }
fn wide_arms(locals: List(String), arms: List(CArm)) -> Stage { match arms { Nil -> InStage  Cons(CArm(p, b), rest) -> first(wide_frames(pat_names(p, locals), b), wide_arms(locals, rest)) } }
fn wide_clauses(locals: List(String), cs: List(CClause)) -> Stage { match cs { Nil -> InStage  Cons(CClause(_, _, ps, b), rest) -> first(wide_frames(Cons("$cont", param_names(ps, locals)), b), wide_clauses(locals, rest)) } }
fn wide_frames(locals: List(String), e: CExpr) -> Stage {
  match e {
    CExpr(_, _, _, k) -> match k {
      KLet(n, v, b) -> first(if has_site(v) && count_in(free_vars(b, Cons(n, Nil), Nil), locals, 0) > 60 { Outside("a frame of more than 60 saved values") } else { InStage }, first(wide_frames(locals, v), wide_frames(Cons(n, locals), b)))
      KLambda(ps, b) -> wide_frames(param_names(ps, locals), b)
      KMatch(sc, arms) -> first(wide_frames(locals, sc), wide_arms(locals, arms))
      KHandle(b, _, cs, ret) -> first(if count_in(handle_free(b, cs, ret, Nil, Nil), locals, 0) > 58 { Outside("a handler frame of more than 58 saved values") } else { InStage }, first(wide_frames(locals, b), first(wide_clauses(locals, cs), match ret { No -> InStage  Yes(CRet(n, rb)) -> wide_frames(Cons(n, locals), rb) })))
      _ -> wide_all(locals, children(e))
    }
  }
}
fn eff_fns(x: EffEnv, fs: List(CFn)) -> Stage {
  match fs { Nil -> InStage  Cons(CFn(_, ps, b), rest) -> first(check_eff(x, param_names(ps, Nil), b), eff_fns(x, rest)) }
}
fn eff_all(x: EffEnv, locals: List(String), xs: List(CExpr)) -> Stage { match xs { Nil -> InStage  Cons(e, rest) -> first(check_eff(x, locals, e), eff_all(x, locals, rest)) } }
fn eff_arms(x: EffEnv, locals: List(String), arms: List(CArm)) -> Stage { match arms { Nil -> InStage  Cons(CArm(p, b), rest) -> first(check_eff(x, pat_names(p, locals), b), eff_arms(x, locals, rest)) } }
fn eff_clauses(x: EffEnv, locals: List(String), cs: List(CClause)) -> Stage { match cs { Nil -> InStage  Cons(CClause(_, _, ps, b), rest) -> first(check_eff(x, param_names(ps, locals), b), eff_clauses(x, locals, rest)) } }
fn is_top(x: EffEnv, locals: List(String), n: String) -> Bool { match x { EffEnv(all, _, _) -> !has(locals, n) && has_fn(all, n) } }
fn x_cps(x: EffEnv) -> List(String) { match x { EffEnv(_, c, _) -> c } }
fn check_eff(x: EffEnv, locals: List(String), e: CExpr) -> Stage {
  match e {
    CExpr(_, _, t, k) -> match k {
      KVar(n) -> if is_top(x, locals, n) { if has(x_cps(x), n) { Outside("an effectful function as a value") } else { convention(x_cps(x), n, t) } } else { InStage }
      KApp(CExpr(_, _, ft, KVar(f)), args) -> first(if is_top(x, locals, f) { convention(x_cps(x), f, ft) } else { if needs_cps(ft) { Outside("an effectful call of a closure") } else { InStage } }, eff_all(x, locals, args))
      KApp(f, args) -> first(if needs_cps(ty_of(f)) { Outside("an effectful call of a closure") } else { InStage }, eff_all(x, locals, Cons(f, args)))
      KLambda(ps, b) -> if has_site(b) { Outside("an effectful lambda") } else { if has_resume(b) { Outside("a resume inside a lambda") } else { check_eff(x, param_names(ps, locals), b) } }
      KLet(n, v, b) -> first(check_eff(x, locals, v), check_eff(x, Cons(n, locals), b))
      KMatch(sc, arms) -> first(check_eff(x, locals, sc), eff_arms(x, locals, arms))
      KPerform(_, _, _, args) -> if len_exprs(args, 0) > 2 { Outside("an operation of more than two parameters") } else { eff_all(x, locals, args) }
      KHandle(b, m, cs, ret) -> first(handle_ok(x, b, m, cs, ret), first(check_eff(x, locals, b), first(eff_clauses(x, locals, cs), match ret { No -> InStage  Yes(CRet(n, rb)) -> check_eff(x, Cons(n, locals), rb) })))
      _ -> eff_all(x, locals, children(e))
    }
  }
}
fn handle_ok(x: EffEnv, b: CExpr, m: Bool, cs: List(CClause), ret: Maybe(CRet)) -> Stage {
  if m { Outside("a multi-shot handler") } else {
    if any_op_clause(cs) { Outside("a `with any` handler") } else {
      if wide_clause(cs) { Outside("an operation of more than two parameters") } else {
        match x { EffEnv(_, _, perf) -> match handle_effs(perf, b, cs, ret) { Nil -> InStage  _ -> Outside("a handler that leaks an effect") } }
      }
    }
  }
}

// ---- Naming what a continuation saves -----------------------------------------
// In a CPS region an operand that holds a site, and every operand computed
// before it, is bound by a `let` first (`$o<i>`; a condition or scrutinee
// `$c`/`$s`), so a site's continuation is always the rest of a `let`, and
// what its frame saves is the free names of that rest.
type HB { HB(String, CExpr) }
linear type Hoisted { Hoisted(List(HB), List(CExpr)) }
fn atomic(e: CExpr) -> Bool { match e { CExpr(_, _, _, KLit(_)) -> True  CExpr(_, _, _, KVar(_)) -> True  _ -> False } }
fn last_site(xs: List(CExpr), i: Int, last: Int) -> Int { match xs { Nil -> last  Cons(x, rest) -> last_site(rest, i + 1, if has_site(x) { i } else { last }) } }
fn hoist(xs: List(CExpr), i: Int, last: Int, bs: List(HB), out: List(CExpr)) -> Hoisted {
  match xs {
    Nil -> Hoisted(rev_hbs(bs, Nil), rev_es(out, Nil))
    Cons(x, rest) -> {
      let x2 = anf(x)
      if i <= last && !atomic(x2) {
        let n = "$o" <> int.to_string(i)
        match x2 { CExpr(a, b, t, _) -> hoist(rest, i + 1, last, Cons(HB(n, x2), bs), Cons(CExpr(a, b, t, KVar(n)), out)) }
      } else { hoist(rest, i + 1, last, bs, Cons(x2, out)) }
    }
  }
}
fn hoist_all(xs: List(CExpr)) -> Hoisted { hoist(xs, 0, last_site(xs, 0, 0 - 1), Nil, Nil) }
fn wrap_lets(bs: List(HB), body: CExpr) -> CExpr {
  match bs { Nil -> body  Cons(HB(n, v), rest) -> match body { CExpr(a, b, t, _) -> CExpr(a, b, t, KLet(n, v, wrap_lets(rest, body))) } }
}
fn anf_bind(n: String, v: CExpr, mk: CExpr) -> CExpr { match mk { CExpr(a, b, t, _) -> CExpr(a, b, t, KLet(n, v, mk)) } }
fn anf(e: CExpr) -> CExpr {
  match e {
    CExpr(a, b, t, k) -> match k {
      // The callee is operand 0: evaluated first, hoisted like the others.
      KApp(f, xs) -> match hoist_all(Cons(f, xs)) { Hoisted(bs, ys) -> match ys { Cons(g, zs) -> wrap_lets(bs, CExpr(a, b, t, KApp(g, zs)))  Nil -> e } }
      KBuiltin(n, xs) -> match hoist_all(xs) { Hoisted(bs, ys) -> wrap_lets(bs, CExpr(a, b, t, KBuiltin(n, ys))) }
      KCtor(n, xs) -> match hoist_all(xs) { Hoisted(bs, ys) -> wrap_lets(bs, CExpr(a, b, t, KCtor(n, ys))) }
      KPrim(op, xs) -> match hoist_all(xs) { Hoisted(bs, ys) -> wrap_lets(bs, CExpr(a, b, t, KPrim(op, ys))) }
      KPerform(eff, op, ot, xs) -> match hoist_all(xs) { Hoisted(bs, ys) -> wrap_lets(bs, CExpr(a, b, t, KPerform(eff, op, ot, ys))) }
      KLambda(ps, body) -> CExpr(a, b, t, KLambda(ps, anf(body)))
      KLet(n, v, body) -> CExpr(a, b, t, KLet(n, anf(v), anf(body)))
      KIf(c, x, y) -> {
        let c2 = anf(c)
        if has_site(c2) { anf_bind("$c", c2, CExpr(a, b, t, KIf(CExpr(a, b, ty_of(c2), KVar("$c")), anf(x), anf(y)))) } else { CExpr(a, b, t, KIf(c2, anf(x), anf(y))) }
      }
      KMatch(sc, arms) -> {
        let s2 = anf(sc)
        if has_site(s2) { anf_bind("$s", s2, CExpr(a, b, t, KMatch(CExpr(a, b, ty_of(s2), KVar("$s")), anf_arms(arms)))) } else { CExpr(a, b, t, KMatch(s2, anf_arms(arms))) }
      }
      KResume(v) -> {
        let v2 = anf(v)
        if has_site(v2) { anf_bind("$r", v2, CExpr(a, b, t, KResume(CExpr(a, b, ty_of(v2), KVar("$r"))))) } else { CExpr(a, b, t, KResume(v2)) }
      }
      KHandle(body, m, cs, ret) -> CExpr(a, b, t, KHandle(anf(body), m, anf_clauses(cs), match ret { No -> No  Yes(CRet(n, rb)) -> Yes(CRet(n, anf(rb))) }))
      _ -> e
    }
  }
}
fn anf_arms(arms: List(CArm)) -> List(CArm) { match arms { Nil -> Nil  Cons(CArm(p, b), rest) -> Cons(CArm(p, anf(b)), anf_arms(rest)) } }
fn anf_clauses(cs: List(CClause)) -> List(CClause) { match cs { Nil -> Nil  Cons(CClause(e, o, ps, b), rest) -> Cons(CClause(e, o, ps, anf(b)), anf_clauses(rest)) } }
// Only a function with a region of its own: the others are unchanged.
fn anf_fns(fs: List(CFn)) -> List(CFn) {
  match fs { Nil -> Nil  Cons(CFn(n, ps, b), rest) -> Cons(CFn(n, ps, if has_site(b) || has_handle(b) { anf(b) } else { b }), anf_fns(rest)) }
}

// ---- CPS emission ---------------------------------------------------------------

fn raw(em: Emit, s: String) -> Emit { match em { Emit(b, n, l, ss, k) -> Emit(buffer.push(b, s), n, l, ss, k) } }
// A value given to a continuation: `code = k[1]; musttail code(word, k)`.
fn return_to(em: Emit, k: Val, v: Val) -> Emit {
  match to_word(em, v) {
    Gotv(Val(w, _), em2) -> match load_field(em2, vtext(k), 1, TB(3)) {
      Gotv(Val(code, _), em3) -> match fresh(em3) {
        Fresh1(r, em4) -> line(line(em4, r <> " = musttail call tailcc i64 " <> code <> "(i64 " <> w <> ", ptr " <> vtext(k) <> ")"), "ret i64 " <> r)
      }
    }
  }
}
fn ret_value(cx: ECx, env: List(EBind), e: CExpr, em: Emit) -> Emit {
  match emit(cx, env, Nil, e, em) { Gotv(v, em2) -> return_to(em2, lookup(env, "$k"), v) }
}
fn if_tail(cx: ECx, env: List(EBind), c: CExpr, a: CExpr, b: CExpr, em: Emit, mode: TMode) -> Emit {
  match emit(cx, env, Nil, c, em) {
    Gotv(Val(cv, _), em2) -> match new_label(em2) {
      Fresh1(lt, em3) -> match new_label(em3) {
        Fresh1(lf, em4) -> tail_by(cx, env, b, start_block(tail_by(cx, env, a, start_block(line(em4, "br i1 " <> cv <> ", label %" <> lt <> ", label %" <> lf), lt), mode), lf), mode)
      }
    }
  }
}
// The region's continuation is `$k` in the scope, so every allocation roots it.
fn cps_tail(cx: ECx, env: List(EBind), e: CExpr, em: Emit) -> Emit {
  match e {
    CExpr(_, _, _, k) -> match k {
      KLet(n, v, b) -> if has_site(v) {
        match site_frame(cx, env, n, ty_of(v), b, em) { Gotv(f, em2) -> cps_tail(cx, Cons(EBind("$k", f), env), v, em2) }
      } else {
        match emit(cx, env, Nil, v, em) { Gotv(val, em2) -> cps_tail(cx, Cons(EBind(n, val), env), b, em2) }
      }
      KIf(c, a, b) -> if_tail(cx, env, c, a, b, em, TCps)
      KMatch(sc, arms) -> match emit(cx, env, Nil, sc, em) {
        Gotv(sv, em2) -> match emit_arms(cx, env, Nil, sv, ty_of(sc), arms, em2, "", Nil, TCps) { Arms(_, em3) -> em3 }
      }
      KApp(CExpr(_, _, ft, KVar(f)), args) -> if needs_cps(ft) && !bound(env, f) && is_fn(cx, f) {
        match emit_args(cx, env, Nil, args, em, Nil) {
          Gotvs(vs, em2) -> match fresh(em2) {
            Fresh1(r, em3) -> line(line(em3, r <> " = musttail call tailcc i64 @elya." <> f <> "(" <> arg_list(rev_onto(rev(vs), Cons(lookup(env, "$k"), Nil))) <> ")"), "ret i64 " <> r)
          }
        }
      } else { ret_value(cx, env, e, em) }
      KPerform(eff, op, _, args) -> match emit_args(cx, env, Nil, args, em, Nil) { Gotvs(vs, em2) -> perform(cx, env, eff, op, vs, em2) }
      _ -> ret_value(cx, env, e, em)
    }
  }
}
// A non-tail site's frame: the rest of the `let` is its resumption.
fn site_frame(cx: ECx, env: List(EBind), x: String, xt: Ty, rest: CExpr, em: Emit) -> Gotv {
  let saved = captures(env, free_vars(rest, Cons(x, Nil), Nil), Nil)
  let n = len_binds(saved, 0)
  match em {
    Emit(b, c, l, Mx(scs, js, rws, lk, ws, FRows(sr, hr, nk)), sk) -> {
      let tag = if n == 0 { frame_tag(cx) } else { site_base(cx) + len_rows(sr, 0) }
      let sr2 = if n == 0 { sr } else { Cons(Row2(2 + n, cap_mask(saved, 4, 2)), sr) }
      let em2 = Emit(b, c, l, Mx(scs, Cons(SiteJob(nk, x, xt, saved, rest), js), rws, lk, ws, FRows(sr2, hr, nk + 1)), sk)
      match rooted(em2, roots(env, Nil, Nil), "call ptr @elya_alloc(i64 " <> int.to_string(3 + n) <> ")", LPtr) {
        Gotv(Val(fr, _), em3) -> Gotv(Val(fr, LPtr), store_fields(line(em3, "store i64 " <> int.to_string(tag) <> ", ptr " <> fr), fr, Cons(Val("ptrtoint (ptr @elya$k." <> int.to_string(nk) <> " to i64)", LI64), Cons(lookup(env, "$k"), cap_vals(saved))), 1))
      }
    }
  }
}
fn load_as(em: Emit, obj: String, i: Int, name: String) -> Emit {
  match fresh(em) {
    Fresh1(fp, em2) -> match fresh(line(em2, fp <> " = getelementptr i64, ptr " <> obj <> ", i64 " <> int.to_string(i))) {
      Fresh1(w, em3) -> line(line(em3, w <> " = load i64, ptr " <> fp), name <> " = inttoptr i64 " <> w <> " to ptr")
    }
  }
}
// A perform: the continuation object, then the handlers walked from the
// current one by their parents to the first whose table has the operation.
fn perform(cx: ECx, env: List(EBind), eff: String, op: String, vs: List(Val), em: Emit) -> Emit {
  match rooted(em, roots(env, Nil, vs), "call ptr @elya_alloc(i64 4)", LPtr) {
    Gotv(Val(c, _), em2) -> match fresh(store_fields(line(em2, "store i64 " <> int.to_string(cont_tag(cx)) <> ", ptr " <> c), c, Cons(lookup(env, "$k"), Nil), 1)) {
      Fresh1(h, em3) -> match label_of(line(em3, h <> " = load ptr, ptr @elya_current_handler")) {
        AtLabel(l0, em4) -> match new_label(em4) {
          Fresh1(find, em5) -> match new_label(em5) {
            Fresh1(none, em6) -> match new_label(em6) {
              Fresh1(hl, em7) -> match new_label(em7) {
                Fresh1(outer, em8) -> match new_label(em8) {
                  Fresh1(disp, em9) -> match fresh(em9) {
                    Fresh1(hw, em10) -> match fresh(em10) {
                      Fresh1(ph, em11) -> match fresh(em11) {
                        Fresh1(noh, em12) -> {
                          let em13 = line(start_block(line(em12, "br label %" <> find), find), hw <> " = phi ptr [ " <> h <> ", %" <> l0 <> " ], [ " <> ph <> ", %" <> outer <> " ]")
                          let em14 = start_block(line(line(start_block(line(line(em13, noh <> " = icmp eq ptr " <> hw <> ", null"), "br i1 " <> noh <> ", label %" <> none <> ", label %" <> hl), none), "call void @elya_unhandled_effect()"), "unreachable"), hl)
                          match load_field(em14, hw, 3, TB(3)) {
                            Gotv(Val(tab, _), em15) -> match fresh(em15) {
                              Fresh1(cs, em16) -> match fresh(line(em16, cs <> " = getelementptr ptr, ptr " <> tab <> ", i64 " <> int.to_string(op_id(cx, eff, op)))) {
                                Fresh1(ce, em17) -> match fresh(line(em17, ce <> " = load ptr, ptr " <> cs)) {
                                  Fresh1(nc, em18) -> {
                                    let em19 = start_block(line(line(em18, nc <> " = icmp eq ptr " <> ce <> ", null"), "br i1 " <> nc <> ", label %" <> outer <> ", label %" <> disp), outer)
                                    let em20 = start_block(line(load_as(em19, hw, 4, ph), "br label %" <> find), disp)
                                    match fresh(store_fields(em20, c, Cons(Val(hw, LPtr), Cons(Val(h, LPtr), Nil)), 2)) {
                                      Fresh1(r, em21) -> line(line(em21, r <> " = musttail call tailcc i64 " <> ce <> "(" <> arg_list(rev_onto(rev(vs), Cons(Val(c, LPtr), Cons(Val(hw, LPtr), Nil)))) <> ")"), "ret i64 " <> r)
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
// A direct handle: its frame made current around a nested call of its body.
fn emit_handle(cx: ECx, env: List(EBind), pend: List(Val), body: CExpr, cs: List(CClause), ret: Maybe(CRet), t: Ty, em: Emit) -> Gotv {
  let saved = captures(env, handle_free(body, cs, ret, Nil, Nil), Nil)
  let n = len_binds(saved, 0)
  match em {
    Emit(b, c, l, Mx(scs, js, rws, lk, ws, FRows(sr, hr, nk)), sk) -> {
      let i = len_rows(hr, 0)
      let hn = "@elya$h." <> int.to_string(i)
      let em2 = Emit(b, c, l, Mx(scs, Cons(HandJob(i, body, cs, ret, saved, ty_of(body)), js), rws, lk, ws, FRows(sr, Cons(Row2(4 + n, cap_mask(saved, 16, 10)), hr), nk)), sk)
      match rooted(em2, roots(env, pend, Nil), "call ptr @elya_alloc(i64 " <> int.to_string(5 + n) <> ")", LPtr) {
        Gotv(Val(fr, _), em3) -> match fresh(line(em3, "store i64 " <> int.to_string(handler_base(cx) + i) <> ", ptr " <> fr)) {
          Fresh1(oh, em4) -> {
            let em5 = store_fields(line(em4, oh <> " = load ptr, ptr @elya_current_handler"), fr, Cons(Val("ptrtoint (ptr " <> hn <> ".ret to i64)", LI64), Cons(Val("0", LI64), Cons(Val("ptrtoint (ptr " <> hn <> ".tab to i64)", LI64), Cons(Val(oh, LPtr), cap_vals(saved))))), 1)
            match rooted(line(em5, "store ptr " <> fr <> ", ptr @elya_current_handler"), roots(env, pend, Nil), "call tailcc i64 " <> hn <> ".body(ptr " <> fr <> ")", LI64) {
              Gotv(Val(hb, _), em6) -> from_word(line(em6, "store ptr " <> oh <> ", ptr @elya_current_handler"), hb, lt_of(t))
            }
          }
        }
      }
    }
  }
}
// A word as a binding of `t`'s layout, the lines that convert it.
linear type Bound { Bound(List(String), EBind) }
fn bind_word(x: String, t: Ty, w: String) -> Bound {
  match lt_of(t) {
    LI1 -> Bound(Cons(w <> ".b = trunc i64 " <> w <> " to i1", Nil), EBind(x, Val(w <> ".b", LI1)))
    LPtr -> Bound(Cons(w <> ".p = inttoptr i64 " <> w <> " to ptr", Nil), EBind(x, Val(w <> ".p", LPtr)))
    _ -> Bound(Nil, EBind(x, Val(w, LI64)))
  }
}
fn table_entries(ops: List(EffOp), cs: List(CClause), hn: String) -> String {
  match ops {
    Nil -> ""
    Cons(EffOp(e, o), rest) -> {
      let j = clause_index(cs, e, o, 0)
      (if j < 0 { "ptr null" } else { "ptr @" <> hn <> ".c." <> int.to_string(j) }) <> (match rest { Nil -> ""  _ -> ", " }) <> table_entries(rest, cs, hn)
    }
  }
}
fn clause_index(cs: List(CClause), eff: String, op: String, j: Int) -> Int {
  match cs { Nil -> 0 - 1  Cons(CClause(e, o, _, _), rest) -> if e == eff && o == op { j } else { clause_index(rest, eff, op, j + 1) } }
}
fn par_lines() -> List(String) {
  Cons("%par.p = getelementptr i64, ptr %hf, i64 4", Cons("%par.w = load i64, ptr %par.p", Cons("%par = inttoptr i64 %par.w to ptr", Cons("store ptr %par, ptr @elya_current_handler", Nil))))
}
fn concat_lines(ls: List(String), acc: String) -> String { match ls { Nil -> acc  Cons(x, rest) -> concat_lines(rest, acc <> "  " <> x <> "\n") } }
// A handle's functions: its clause table, its body (a region ending at the
// end frame), its return clause and its clauses, each run with the frame's
// parent current.
fn handler_fns(cx: ECx, i: Int, body: CExpr, cs: List(CClause), ret: Maybe(CRet), saved: List(EBind), bt: Ty, em: Emit) -> Emit {
  let hn = "elya$h." <> int.to_string(i)
  let ops = match eff_of(cx) { EffCx(_, o, _, _) -> o }
  let em1 = raw(em, "@" <> hn <> ".tab = private constant [" <> int.to_string(len_ops(ops, 0)) <> " x ptr] " <> (match ops { Nil -> "zeroinitializer"  _ -> "[" <> table_entries(ops, cs, hn) <> "]" }) <> "\n\n")
  match load_from(saved, "%hf", 5, Nil, Nil, em1) {
    Loaded(pre, env, em2) -> {
      let em3 = define_mode(cx, hn <> ".body", "ptr %hf", LI64, Cons(EBind("$k", Val("%end", LPtr)), env), body, rev_onto(rev(pre), Cons("%end = load ptr, ptr @elya_handle_end", Nil)), em2, TCps)
      let em4 = match ret {
        No -> raw(em3, "define tailcc i64 @" <> hn <> ".ret(i64 %v, ptr %hf) {\nentry:\n" <> concat_lines(par_lines(), "") <> "  ret i64 %v\n}\n\n")
        Yes(CRet(x, rb)) -> match load_from(saved, "%hf", 5, Nil, Nil, em3) {
          Loaded(pre2, env2, em3b) -> match bind_word(x, bt, "%v") {
            Bound(bl, xb) -> define_mode(cx, hn <> ".ret", "i64 %v, ptr %hf", LI64, Cons(xb, env2), rb, rev_onto(rev(par_lines()), rev_onto(rev(pre2), bl)), em3b, TCl)
          }
        }
      }
      clause_fns(cx, hn, cs, 0, saved, em4)
    }
  }
}
fn clause_fns(cx: ECx, hn: String, cs: List(CClause), j: Int, saved: List(EBind), em: Emit) -> Emit {
  match cs {
    Nil -> em
    Cons(CClause(_, _, ps, b), rest) -> match header(ps, 0, "", Nil) {
      Hdr(text, penv) -> match load_from(saved, "%hf", 5, Nil, Nil, em) {
        // The parameters shadow what the frame saves.
        Loaded(pre, env, em2) -> clause_fns(cx, hn, rest, j + 1, saved, define_mode(cx, hn <> ".c." <> int.to_string(j), (if text == "" { "" } else { text <> ", " }) <> "ptr %cont, ptr %hf", LI64, Cons(EBind("$cont", Val("%cont", LPtr)), rev_binds(rev_binds(penv, Nil), env)), b, rev_onto(rev(par_lines()), pre), em2, TCl))
      }
    }
  }
}
// One-shot resume (D13): the continuation's handler word is cleared, the
// handler frame reparented to the current one, the innermost handler made
// current, then its code is called (or jumped to, in tail position).
linear type Resumed { Resumed(String, String, String, String, Emit) }
fn resume_start(env: List(EBind), val: Val, em: Emit) -> Resumed {
  let cont = vtext(lookup(env, "$cont"))
  match to_word(em, val) {
    Gotv(Val(w, _), em1) -> match load_field(em1, cont, 2, TB(0)) {
      Gotv(Val(used, _), em2) -> match fresh(em2) {
        Fresh1(z, em3) -> match fresh(trap(line(em3, z <> " = icmp eq i64 " <> used <> ", 0"), z, "elya_resume_twice")) {
          Fresh1(zp, em4) -> match assign(line(line(em4, zp <> " = getelementptr i64, ptr " <> cont <> ", i64 2"), "store i64 0, ptr " <> zp), "inttoptr i64 " <> used <> " to ptr", LPtr) {
            Gotv(Val(rhf, _), em5) -> match load_field(em5, cont, 1, TB(3)) {
              Gotv(Val(rk, _), em6) -> match load_field(em6, rk, 1, TB(3)) {
                Gotv(Val(rc, _), em7) -> match load_field(em7, cont, 3, TB(3)) {
                  Gotv(Val(rh, _), em8) -> match fresh(em8) {
                    Fresh1(rp, em9) -> Resumed(w, rk, rc, rp, line(store_fields(line(em9, rp <> " = load ptr, ptr @elya_current_handler"), rhf, Cons(Val(rp, LPtr), Nil), 4), "store ptr " <> rh <> ", ptr @elya_current_handler"))
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
// A clause's (or return clause's) tail: a resume there jumps.
fn clause_tail(cx: ECx, env: List(EBind), e: CExpr, em: Emit) -> Emit {
  match e {
    CExpr(_, _, _, k) -> match k {
      KLet(n, v, b) -> match emit(cx, env, Nil, v, em) { Gotv(val, em2) -> clause_tail(cx, Cons(EBind(n, val), env), b, em2) }
      KIf(c, a, b) -> if_tail(cx, env, c, a, b, em, TCl)
      KMatch(sc, arms) -> match emit(cx, env, Nil, sc, em) {
        Gotv(sv, em2) -> match emit_arms(cx, env, Nil, sv, ty_of(sc), arms, em2, "", Nil, TCl) { Arms(_, em3) -> em3 }
      }
      KResume(v) -> match emit(cx, env, Nil, v, em) {
        Gotv(val, em2) -> match resume_start(env, val, em2) {
          Resumed(w, rk, rc, _, em3) -> match fresh(em3) {
            Fresh1(r, em4) -> line(line(em4, r <> " = musttail call tailcc i64 " <> rc <> "(i64 " <> w <> ", ptr " <> rk <> ")"), "ret i64 " <> r)
          }
        }
      }
      _ -> match emit(cx, env, Nil, e, em) { Gotv(v, em2) -> match to_word(em2, v) { Gotv(Val(w, _), em3) -> line(em3, "ret i64 " <> w) } }
    }
  }
}

// ---- Argument records -------------------------------------------------------
// As the Rust back end's `spill.rs` (spec 2026-10-16-elya-argument-records):
// a function, lambda or function type of more than three parameters keeps
// its first two and carries the rest in ONE record, a constructor of a
// synthesized ground type named by what its fields look like (a function
// type by its convention, never its row). Built at the call, taken apart by
// a one-arm `match` at the callee's entry; win64 cannot guarantee a tail
// call to a function of more than five parameters, and a closure's code
// takes the closure too.
fn spill_ty(t: Ty) -> Ty {
  match t {
    TFn(ps, rw, r) -> TFn(spill_group(spill_tys(ps)), rw, spill_ty(r))
    TCon(n, xs) -> TCon(n, spill_tys(xs))
    _ -> t
  }
}
fn spill_tys(ts: List(Ty)) -> List(Ty) { match ts { Nil -> Nil  Cons(t, rest) -> Cons(spill_ty(t), spill_tys(rest)) } }
// Parameter types already rewritten, grouped.
fn spill_group(ps: List(Ty)) -> List(Ty) {
  match ps { Cons(a, Cons(b, Cons(c, Cons(d, rest)))) -> Cons(a, Cons(b, Cons(rec_ty(Cons(c, Cons(d, rest))), Nil)))  _ -> ps }
}
fn rec_key(fs: List(Ty)) -> String {
  match fs { Nil -> ""  Cons(t, Nil) -> mono.key_of(t)  Cons(t, rest) -> mono.key_of(t) <> ", " <> rec_key(rest) }
}
fn rec_ty(fs: List(Ty)) -> Ty { TCon("$Args(" <> rec_key(fs) <> ")", Nil) }
fn rec_ctor(fs: List(Ty)) -> String { "$args(" <> rec_key(fs) <> ")" }
fn drop2(ts: List(Ty)) -> List(Ty) { match ts { Cons(_, Cons(_, rest)) -> rest  _ -> Nil } }
fn drop2e(xs: List(CExpr)) -> List(CExpr) { match xs { Cons(_, Cons(_, rest)) -> rest  _ -> Nil } }

// The records the module needs, in order of first appearance: every
// function type of more than three parameters any node, parameter or field
// mentions, its spilled fields rewritten first.
type SRec { SRec(String, List(Ty)) }
fn has_rec(rs: List(SRec), k: String) -> Bool { match rs { Nil -> False  Cons(SRec(j, _), rest) -> j == k || has_rec(rest, k) } }
fn recs_ty(t: Ty, acc: List(SRec)) -> List(SRec) {
  match t {
    TFn(ps, _, r) -> rec_of(ps, recs_ty(r, recs_tys(ps, acc)))
    TCon(_, xs) -> recs_tys(xs, acc)
    _ -> acc
  }
}
// The record of a parameter list, if it is spilled.
fn rec_of(ps: List(Ty), acc: List(SRec)) -> List(SRec) {
  if len_tys(ps, 0) > 3 {
    let fs = drop2(spill_tys(ps))
    let k = rec_key(fs)
    if has_rec(acc, k) { acc } else { Cons(SRec(k, fs), acc) }
  } else { acc }
}
fn recs_tys(ts: List(Ty), acc: List(SRec)) -> List(SRec) { match ts { Nil -> acc  Cons(t, rest) -> recs_tys(rest, recs_ty(t, acc)) } }
fn recs_params(ps: List(CParam), acc: List(SRec)) -> List(SRec) { match ps { Nil -> acc  Cons(CParam(_, t), rest) -> recs_params(rest, recs_ty(t, acc)) } }
fn recs_expr(e: CExpr, acc: List(SRec)) -> List(SRec) {
  match e {
    CExpr(_, _, t, k) -> {
      let acc2 = recs_ty(t, acc)
      match k {
        KApp(f, args) -> recs_exprs(Cons(f, args), acc2)
        KBuiltin(_, xs) -> recs_exprs(xs, acc2)
        KCtor(_, xs) -> recs_exprs(xs, acc2)
        KPrim(_, xs) -> recs_exprs(xs, acc2)
        KLambda(ps, b) -> recs_expr(b, recs_params(ps, acc2))
        KLet(_, v, b) -> recs_expr(b, recs_expr(v, acc2))
        KIf(c, x, y) -> recs_exprs(Cons(c, Cons(x, Cons(y, Nil))), acc2)
        KMatch(sc, arms) -> recs_arms(arms, recs_expr(sc, acc2))
        KPerform(_, _, ot, xs) -> recs_exprs(xs, recs_ty(ot, acc2))
        KResume(v) -> recs_expr(v, acc2)
        KHandle(body, _, cs, ret) -> recs_clauses(cs, match ret { No -> recs_expr(body, acc2)  Yes(CRet(_, rb)) -> recs_expr(rb, recs_expr(body, acc2)) })
        _ -> acc2
      }
    }
  }
}
fn recs_exprs(xs: List(CExpr), acc: List(SRec)) -> List(SRec) { match xs { Nil -> acc  Cons(x, rest) -> recs_exprs(rest, recs_expr(x, acc)) } }
fn recs_clauses(cs: List(CClause), acc: List(SRec)) -> List(SRec) { match cs { Nil -> acc  Cons(CClause(_, _, ps, b), rest) -> recs_clauses(rest, recs_expr(b, recs_params(ps, acc))) } }
fn recs_arms(arms: List(CArm), acc: List(SRec)) -> List(SRec) { match arms { Nil -> acc  Cons(CArm(_, b), rest) -> recs_arms(rest, recs_expr(b, acc)) } }
fn recs_ctors(cs: List(CCtor), acc: List(SRec)) -> List(SRec) { match cs { Nil -> acc  Cons(CCtor(_, fs), rest) -> recs_ctors(rest, recs_tys(fs, acc)) } }
fn recs_types(ts: List(CType), acc: List(SRec)) -> List(SRec) { match ts { Nil -> acc  Cons(CType(_, cs), rest) -> recs_types(rest, recs_ctors(cs, acc)) } }
// A function's own list too: one never mentioned (never called) is still
// written.
fn recs_fns(fs: List(CFn), acc: List(SRec)) -> List(SRec) { match fs { Nil -> acc  Cons(CFn(_, ps, b), rest) -> recs_fns(rest, recs_expr(b, rec_of(cparam_tys(ps), recs_params(ps, acc)))) } }
fn rec_types(rs: List(SRec), acc: List(CType)) -> List(CType) {
  match rs { Nil -> acc  Cons(SRec(k, fs), rest) -> rec_types(rest, Cons(CType("$Args(" <> k <> ")", Cons(CCtor("$args(" <> k <> ")", fs), Nil)), acc)) }
}

// The rewriting.
type SpPb { SpPb(List(CParam), CExpr) }
fn spill_cparams(ps: List(CParam)) -> List(CParam) { match ps { Nil -> Nil  Cons(CParam(n, t), rest) -> Cons(CParam(n, spill_ty(t)), spill_cparams(rest)) } }
fn cparam_tys(ps: List(CParam)) -> List(Ty) { match ps { Nil -> Nil  Cons(CParam(_, t), rest) -> Cons(t, cparam_tys(rest)) } }
fn cparam_pats(ps: List(CParam)) -> List(CPat) { match ps { Nil -> Nil  Cons(CParam(n, _), rest) -> Cons(QVar(n), cparam_pats(rest)) } }
// Parameters and body already rewritten.
fn spill_entry(ps: List(CParam), body: CExpr) -> SpPb {
  match ps {
    Cons(a, Cons(b, Cons(c, Cons(d, rest)))) -> {
      let more = Cons(c, Cons(d, rest))
      let fs = cparam_tys(more)
      match body {
        CExpr(s, e, t, _) -> SpPb(Cons(a, Cons(b, Cons(CParam("$rest", rec_ty(fs)), Nil))), CExpr(s, e, t, KMatch(CExpr(s, e, rec_ty(fs), KVar("$rest")), Cons(CArm(QCtor(rec_ctor(fs), cparam_pats(more)), body), Nil))))
      }
    }
    _ -> SpPb(ps, body)
  }
}
// A call's arguments (rewritten), packed as its callee's parameters say.
fn spill_args(f: CExpr, xs: List(CExpr)) -> List(CExpr) {
  match xs {
    Cons(a, Cons(b, Cons(_, Cons(_, _)))) -> match ty_of(f) {
      TFn(ps, _, _) -> {
        let fs = drop2(spill_tys(ps))
        Cons(a, Cons(b, Cons(CExpr(0, 0, rec_ty(fs), KCtor(rec_ctor(fs), drop2e(xs))), Nil)))
      }
      _ -> xs
    }
    _ -> xs
  }
}
fn spill_list(xs: List(CExpr)) -> List(CExpr) { match xs { Nil -> Nil  Cons(x, rest) -> Cons(spill_expr(x), spill_list(rest)) } }
fn spill_clauses(cs: List(CClause)) -> List(CClause) { match cs { Nil -> Nil  Cons(CClause(e, o, ps, b), rest) -> Cons(CClause(e, o, spill_cparams(ps), spill_expr(b)), spill_clauses(rest)) } }
fn spill_arms(arms: List(CArm)) -> List(CArm) { match arms { Nil -> Nil  Cons(CArm(p, b), rest) -> Cons(CArm(p, spill_expr(b)), spill_arms(rest)) } }
fn spill_expr(e: CExpr) -> CExpr {
  match e {
    CExpr(a, b, t, k) -> {
      let t2 = spill_ty(t)
      match k {
        KApp(f, args) -> CExpr(a, b, t2, KApp(spill_expr(f), spill_args(f, spill_list(args))))
        KBuiltin(n, xs) -> CExpr(a, b, t2, KBuiltin(n, spill_list(xs)))
        // A constructor of more than three fields as a value: its lambda,
        // written here so that its parameters are spilled.
        KCtor(n, Nil) -> match t {
          TFn(ps, _, r) -> if len_tys(ps, 0) > 3 { spill_expr(CExpr(a, b, t, KLambda(ctor_params(ps, 0), CExpr(a, b, r, KCtor(n, ctor_args(ps, 0)))))) } else { CExpr(a, b, t2, k) }
          _ -> CExpr(a, b, t2, k)
        }
        KCtor(n, xs) -> CExpr(a, b, t2, KCtor(n, spill_list(xs)))
        KPrim(op, xs) -> CExpr(a, b, t2, KPrim(op, spill_list(xs)))
        KLambda(ps, body) -> match spill_entry(spill_cparams(ps), spill_expr(body)) { SpPb(ps2, body2) -> CExpr(a, b, t2, KLambda(ps2, body2)) }
        KLet(n, v, body) -> CExpr(a, b, t2, KLet(n, spill_expr(v), spill_expr(body)))
        KIf(c, x, y) -> CExpr(a, b, t2, KIf(spill_expr(c), spill_expr(x), spill_expr(y)))
        KMatch(sc, arms) -> CExpr(a, b, t2, KMatch(spill_expr(sc), spill_arms(arms)))
        KPerform(eff, op, ot, xs) -> CExpr(a, b, t2, KPerform(eff, op, spill_ty(ot), spill_list(xs)))
        KResume(v) -> CExpr(a, b, t2, KResume(spill_expr(v)))
        KHandle(body, m, cs, ret) -> CExpr(a, b, t2, KHandle(spill_expr(body), m, spill_clauses(cs), match ret { No -> No  Yes(CRet(n, rb)) -> Yes(CRet(n, spill_expr(rb))) }))
        _ -> CExpr(a, b, t2, k)
      }
    }
  }
}
fn spill_ctors(cs: List(CCtor)) -> List(CCtor) { match cs { Nil -> Nil  Cons(CCtor(n, fs), rest) -> Cons(CCtor(n, spill_tys(fs)), spill_ctors(rest)) } }
fn spill_types(ts: List(CType)) -> List(CType) { match ts { Nil -> Nil  Cons(CType(n, cs), rest) -> Cons(CType(n, spill_ctors(cs)), spill_types(rest)) } }
fn spill_generics(gs: List(CGeneric)) -> List(CGeneric) { match gs { Nil -> Nil  Cons(CGeneric(n, k, cs), rest) -> Cons(CGeneric(n, k, spill_ctors(cs)), spill_generics(rest)) } }
fn spill_fns(fs: List(CFn)) -> List(CFn) {
  match fs {
    Nil -> Nil
    Cons(CFn(n, ps, body), rest) -> match spill_entry(spill_cparams(ps), spill_expr(body)) { SpPb(ps2, body2) -> Cons(CFn(n, ps2, body2), spill_fns(rest)) }
  }
}
pub fn spill(m: CModule) -> CModule {
  match m {
    CModule(ts, gs, fs) -> {
      let recs = recs_fns(fs, recs_types(ts, Nil))
      CModule(rev_onto(rev(spill_types(ts)), rec_types(recs, Nil)), spill_generics(gs), spill_fns(fs))
    }
  }
}

pub fn emit_module(m0: CModule) -> String {
  match spill(mono.mono(m0)) {
    CModule(ts, gs, fs0) -> {
      let fs = anf_fns(fs0)
      let sigs = sigs_of(fs)
      let ground_cs = infos(ts, 0, Nil)
      let n = len_infos(ground_cs, 0)
      let cs = match use_fns(gs, fs, use_tys(gs, ground_fields(ground_cs, Nil), Insts(Nil, n))) { Insts(insts, _) -> rev_onto(rev(ground_cs), rev(insts)) }
      let cx = ECx(sigs, cs, len_infos(cs, 0) + sites_fns(fs, 0), eff_cx(fs))
      match emit_fns(cx, fs, Emit(buffer.new(), 0, "entry", Mx(Nil, Nil, Nil, 0, Nil, FRows(Nil, Nil, 0)), 0)) {
        Emit(body, _, _, Mx(ss, _, rws, _, _, fr), _) -> buffer.finish(buffer.push(emit_strs(rev(ss), buffer.push(buffer.new(), prelude() <> tables(cx, rev(rws), fr))), buffer.finish(body) <> entry(cx, match sig_of(sigs, "main") { ESig(_, _, r) -> r }, main_float(fs))))
      }
    }
  }
}

// A resolved program as IR text, or why it is outside the back end's stage.
type EBuilt { BuiltIr(String), NotBuilt(String) }
pub fn compile(m: Module, size: Int) -> EBuilt {
  match core.lower(m, size) {
    Refused(w) -> NotBuilt(w)
    Ok(cm) -> match check_module(mono.mono(cm)) {
      Outside(w) -> NotBuilt(w)
      InStage -> BuiltIr(emit_module(cm))
    }
  }
}

// io.arg(0) is the program, io.arg(1) the standard modules' directory.
pub fn main() / {IO} {
  match resolve.resolved(io.arg(0), if io.arg_count() > 1 { io.arg(1) } else { "src/std" }) {
    Resolved(m, size, bad, _) -> if bad { io.println("unsupported a program that does not resolve") } else {
      match core.lower(m, size) {
        Refused(w) -> io.println("unsupported " <> w)
        Ok(cm) -> match check_module(mono.mono(cm)) {
          Outside(w) -> io.println("unsupported " <> w)
          InStage -> io.println(emit_module(cm))
        }
      }
    }
  }
}
