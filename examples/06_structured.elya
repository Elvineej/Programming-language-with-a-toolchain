// Structured concurrency, on the standard scheduler `elya/async`.
//
// `async_spawn(f)` starts a task and answers its id; `async_await(id)` waits for
// that task's answer; `async_yield()` lets the others run. Suspension is an
// effect and the scheduler is an ordinary handler (`examples/04_async.elya`
// shows one written out), with one rule more: a scope (`async.scope`) does not
// return until every task started in it has finished. No task outlives the scope
// that started it, so a scope is a plain function call from the outside: `pfib`
// below opens a scope per level, and nobody calling it can tell.
//
// A scope says how it ended: `AsyncFinished(v)`, or `AsyncDeadlocked(ids)` when
// the tasks left wait for each other. What the tasks say (`Log`) is not the
// scheduler's business: it passes out of the scope to the handler in `main`.

import elya/async

effect Log { fn say(line: String) -> Unit }

// A scope's value; a deadlock is said, not passed off as a result (none
// happens here: `examples/08_timers.elya` shows one).
fn value(ended) {
  match ended {
    AsyncFinished(v) -> v
    AsyncDeadlocked(ids) -> {
      let _ = say("  deadlock")
      0 - 1
    }
  }
}

fn worker(name: String, n: Int) -> Int {
  if n == 0 { 0 } else {
    let _ = say(name)
    let _ = async_yield()
    1 + worker(name, n - 1)
  }
}

// A task that spawns itself: the recursion runs through a lambda.
fn fib(n: Int) -> Int {
  if n < 2 { n } else {
    let a = async_spawn(fn() { fib(n - 1) })
    let b = async_spawn(fn() { fib(n - 2) })
    async_await(a) + async_await(b)
  }
}

// A scope per level: from the outside, `pfib` is an ordinary function.
fn pfib(n: Int) -> Int {
  if n < 2 { n } else {
    value(async.scope(fn() {
      let a = async_spawn(fn() { pfib(n - 1) })
      pfib(n - 2) + async_await(a)
    }))
  }
}

pub fn main() -> Int {
  handle {
    let _ = say("scope: start")
    let steps = value(async.scope(fn() {
      let _ = async_spawn(fn() { worker("  ping", 3) })
      let p = async_spawn(fn() { worker("    pong", 2) })
      let _ = say("  body: done, the children run on")
      async_await(p)
    }))
    let _ = say("scope: joined")
    let f = value(async.scope(fn() { fib(10) }))
    let _ = say("fib(10) by spawned tasks")
    let pf = pfib(10)
    let _ = say("pfib(10) by nested scopes")
    steps * 10000 + f * 100 + pf
  } with {
    Log.say(line) -> {
      io.println(line)
      resume(Unit)
    }
    return(v) -> v
  }
}
