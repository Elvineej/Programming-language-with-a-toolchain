// Waiting for time, on the standard scheduler `elya/async`.
//
// `examples/06_structured.elya`'s tasks, sleeping: `async_sleep(ms)` parks a
// task until a deadline. When nothing can run, the
// scheduler waits for the earliest deadline -- the poll loop every event loop
// has, over the one kind of source there is so far, a timer.
//
// The scheduler never reads time itself: `async.schedule` takes a clock as two
// functions, and here they perform `Clock`. Whoever handles `Clock` decides
// what time is. `virtual_clock` moves time only when the scheduler waits, so it
// is exact and instant -- a test of timing code that needs no mock and no
// sleep. `real_clock` asks the machine. The scheduler and the tasks are the
// same code under both.
//
// Two tasks that await each other can never run again. With no timer left to
// wait for, the scope says so by name instead of looping forever.

import elya/async

// What the tasks say, printed by the outermost handler.
effect Log { fn say(line: String) -> Unit }

// The time: what it is, and waiting until a deadline.
effect Clock {
  fn now() -> Int
  fn wait_until(t: Int) -> Unit
}

fn show_ids(l) {
  match l {
    AsyncNil -> ""
    AsyncCons(i, rest) -> " " <> int.to_string(i) <> show_ids(rest)
  }
}

// A scope on `Clock`: it answers the body's value once every task started in it
// has finished, or -1 after naming the tasks of a deadlock.
fn scope(body) {
  let ended = async.schedule(body, fn(t: Int) { now() }, fn(t: Int, d: Int) {
    wait_until(d)
    now()
  })
  match ended {
    AsyncFinished(v) -> v
    AsyncDeadlocked(stuck_ids) -> {
      let _ = say("  deadlock: tasks" <> show_ids(stuck_ids) <> " can never finish")
      0 - 1
    }
  }
}

// --- clocks ---------------------------------------------------------------

// Time that moves only when the scheduler waits. A handler's answer can be a
// function: here, of the current time.
fn virtual_clock(body: fn() / {Clock, Log} -> a) / {Log} -> a {
  let go = handle { body() } with {
    Clock.now() -> fn(t: Int) { resume(t)(t) }
    Clock.wait_until(d) -> fn(t: Int) { if d > t { resume(Unit)(d) } else { resume(Unit)(t) } }
    return(x) -> fn(t: Int) { x }
  }
  go(0)
}

// The machine's clock.
fn real_clock(body: fn() / {Clock, Log} -> a) / {Log, IO} -> a {
  handle { body() } with {
    Clock.now() -> resume(time.now_ms())
    Clock.wait_until(d) -> {
      time.sleep_ms(d - time.now_ms())
      resume(Unit)
    }
    return(x) -> x
  }
}

// --- the program ----------------------------------------------------------

// A request that takes `ms` to answer.
fn fetch(name: String, ms: Int) -> Int {
  let _ = async_sleep(ms)
  let _ = say("  " <> name <> " answered (" <> int.to_string(ms) <> " ms)")
  ms
}

// Three requests at once: they answer in deadline order, and together they
// take as long as the slowest, not the sum.
fn fetches() -> Int {
  let a = async_spawn(fn() { fetch("a", 30) })
  let b = async_spawn(fn() { fetch("b", 10) })
  let c = async_spawn(fn() { fetch("c", 20) })
  async_await(a) + async_await(b) + async_await(c)
}

// Two tasks, each waiting for the other.
fn deadlocked() -> Int {
  let x = async_spawn(fn() { async_await(2) })
  let y = async_spawn(fn() { async_await(1) })
  async_await(x) + async_await(y)
}

// What the fetches answered, and the time they took.
type Timed { Timed(Int, Int) }

fn timed() / {Clock, Log} -> Timed {
  let t0 = now()
  let total = scope(fn() { fetches() })
  Timed(total, now() - t0)
}

pub fn main() -> Int {
  handle {
    let _ = say("virtual clock:")
    let v = match virtual_clock(fn() { timed() }) {
      Timed(total, ms) -> {
        let _ = say("  " <> int.to_string(total) <> " ms of requests in " <> int.to_string(ms) <> " virtual ms")
        total * 100 + ms
      }
    }
    let _ = say("a deadlock:")
    let d = virtual_clock(fn() { scope(fn() { deadlocked() }) })
    let _ = say("real clock:")
    let r = match real_clock(fn() { timed() }) {
      Timed(total, ms) -> {
        let _ = say(if ms >= 30 { "  at least 30 real ms" } else { "  too soon" })
        total
      }
    }
    v * 10 + d * (0 - 1) + r
  } with {
    Log.say(line) -> {
      io.println(line)
      resume(Unit)
    }
    return(v) -> v
  }
}
