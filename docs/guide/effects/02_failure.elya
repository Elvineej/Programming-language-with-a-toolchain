type Never { }
effect Fail { fn fail(reason: String) -> Never }

fn checked_name(name: String) / {Fail} -> String {
  if name == "" { match fail("missing name") { } } else { name }
}

pub fn main() {
  let message = handle {
    "Welcome, " <> checked_name("")
  } with {
    Fail.fail(reason) -> "Rejected: " <> reason
    return(text) -> text <> "!"
  }
  io.println(message)
}
