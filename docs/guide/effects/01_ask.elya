effect Ask { fn ask(prompt: String) -> String }

fn greet() / {Ask} -> String {
  "Hello, " <> ask("name")
}

pub fn main() {
  let message = handle greet() with {
    Ask.ask(prompt) -> resume(if prompt == "name" { "Ada" } else { "friend" })
    return(text) -> text <> "!"
  }
  io.println(message)
}
