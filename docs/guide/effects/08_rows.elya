effect Ask { fn ask() -> String }

fn call(f: fn() / {e} -> String) / {e} -> String { f() }

fn print_result(f: fn() / {e} -> String) / {IO | e} -> Unit {
  io.println(call(f))
}

pub fn main() / {IO} -> Unit {
  print_result(fn() { "pure callback" })
  handle print_result(fn() { ask() }) with {
    Ask.ask() -> resume("effectful callback")
  }
}
