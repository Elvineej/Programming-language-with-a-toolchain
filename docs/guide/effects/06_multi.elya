effect multi Flip { fn flip() -> Bool }

fn choose() / {Flip} -> String {
  if flip() { "heads" } else { "tails" }
}

pub fn main() {
  let outcomes = handle choose() with multi {
    Flip.flip() -> resume(True) <> " / " <> resume(False)
    return(side) -> "[" <> side <> "]"
  }
  io.println(outcomes)
}
