effect Name { fn name() -> String }
effect Title { fn title() -> String }

pub fn main() {
  let message = handle {
    handle { title() <> " " <> name() } with {
      Name.name() -> resume("Ada")
    }
  } with {
    Title.title() -> resume("Dr.")
  }
  io.println(message)
}
