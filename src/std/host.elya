// elya/host: the standard effects given their meaning by the host (spec
// docs/superpowers/specs/2026-10-24-elya-capabilities-part-3-design.md). Its
// handlers perform `IO`, so an import of it needs `/ {IO}`: only a file that
// holds the host's `IO` can turn `Console` or `WallClock` into it.

import elya/console / {Console}
import elya/clock / {WallClock}

// `body`'s lines are printed.
pub fn console(body) {
  handle { body() } with { Console.console_line(text) -> { io.println(text)  resume(Unit) } }
}

// `body` reads the host's clock.
pub fn clock(body) {
  handle { body() } with { WallClock.wall_clock_ms() -> resume(time.now_ms()) }
}
